+#[derive(Default)]
+struct MidTurnToolLoopProvider {
+    regular_calls: AtomicUsize,
+    compaction_calls: AtomicUsize,
+    regular_input_tokens: Mutex<Vec<i32>>,
+}
+
+impl MidTurnToolLoopProvider {
+    fn is_compaction_request(messages: &[Message]) -> bool {
+        messages.iter().any(|message| {
+            message.content.iter().any(|content| match content {
+                MessageContent::Text(text) => text.text.to_lowercase().contains("summarize"),
+                _ => false,
+            })
+        })
+    }
+
+    fn has_compacted_history(messages: &[Message]) -> bool {
+        messages.iter().any(|message| {
+            message
+                .as_concat_text()
+                .contains("<mid-turn compact summary>")
+        })
+    }
+
+    fn visible_tool_response_count(messages: &[Message]) -> usize {
+        messages
+            .iter()
+            .flat_map(|message| message.content.iter())
+            .filter(|content| matches!(content, MessageContent::ToolResponse(_)))
+            .count()
+    }
+}
+
+#[async_trait]
+impl Provider for MidTurnToolLoopProvider {
+    async fn stream(
+        &self,
+        _model_config: &ModelConfig,
+        _system_prompt: &str,
+        messages: &[Message],
+        _tools: &[Tool],
+    ) -> Result<MessageStream, ProviderError> {
+        if Self::is_compaction_request(messages) {
+            self.compaction_calls.fetch_add(1, Ordering::SeqCst);
+            let usage = ProviderUsage::new(
+                "mid-turn-mock".to_string(),
+                Usage::new(Some(2_000), Some(100), Some(2_100)),
+            );
+            return Ok(stream_from_single_message(
+                Message::assistant().with_text("<mid-turn compact summary>"),
+                usage,
+            ));
+        }
+
+        let call_index = self.regular_calls.fetch_add(1, Ordering::SeqCst);
+        let compacted = Self::has_compacted_history(messages);
+        let tool_responses = Self::visible_tool_response_count(messages);
+        let input_tokens = if compacted {
+            4_000
+        } else {
+            6_000 + (tool_responses as i32 * 6_000)
+        };
+        self.regular_input_tokens
+            .lock()
+            .expect("input token capture mutex poisoned")
+            .push(input_tokens);
+
+        if input_tokens > 20_000 {
+            return Err(ProviderError::ExecutionError(
+                "proactive mid-turn compaction did not run before the hard limit".to_string(),
+            ));
+        }
+
+        let message = if compacted {
+            Message::assistant().with_text("done after mid-turn compaction")
+        } else {
+            Message::assistant().with_tool_request(
+                format!("midturn-tool-{call_index}"),
+                Ok(CallToolRequestParams::new("missing_midturn_tool")),
+            )
+        };
+        let usage = ProviderUsage::new(
+            "mid-turn-mock".to_string(),
+            Usage::new(Some(input_tokens), Some(100), Some(input_tokens + 100)),
+        );
+        Ok(stream_from_single_message(message, usage))
+    }
+
+    fn get_name(&self) -> &str {
+        "mid-turn-tool-loop"
+    }
+
+    async fn get_context_limit(&self, _model_config: &ModelConfig) -> Result<usize, ProviderError> {
+        Ok(20_000)
+    }
+}
+
+#[tokio::test]
+async fn test_mid_turn_tool_loop_compacts_after_tool_result_and_continues_same_turn() -> Result<()>
+{
+    let temp_dir = TempDir::new()?;
+    let agent = Agent::new();
+    let session = setup_test_session(&agent, &temp_dir, "mid-turn-tool-loop", Vec::new()).await?;
+    let provider = Arc::new(MidTurnToolLoopProvider::default());
+    let model_config = ModelConfig {
+        model_name: "mid-turn-mock".to_string(),
+        context_limit: Some(20_000),
+        temperature: None,
+        max_tokens: Some(4_096),
+        toolshim: false,
+        toolshim_model: None,
+        request_params: None,
+        reasoning: None,
+        request_headers: None,
+    };
+    agent
+        .update_provider(provider.clone(), model_config, &session.id)
+        .await?;
+
+    let session_config = SessionConfig {
+        id: session.id.clone(),
+        schedule_id: None,
+        max_turns: None,
+        retry_config: None,
+    };
+    let reply_stream = agent
+        .reply(
+            Message::user().with_text("keep using tools until the task is done"),
+            session_config,
+            None,
+        )
+        .await?;
+    tokio::pin!(reply_stream);
+
+    let mut saw_third_request_before_compaction = false;
+    let mut saw_third_response_before_compaction = false;
+    let mut compacted_history = None;
+    let mut saw_final_response = false;
+
+    while let Some(event) = reply_stream.next().await {
+        match event? {
+            AgentEvent::Message(message) => {
+                for content in &message.content {
+                    match content {
+                        MessageContent::ToolRequest(request) if request.id == "midturn-tool-2" => {
+                            assert_eq!(
+                                provider.compaction_calls.load(Ordering::SeqCst),
+                                0,
+                                "must not compact while an assistant tool request is pending"
+                            );
+                            saw_third_request_before_compaction = true;
+                        }
+                        MessageContent::ToolResponse(response)
+                            if response.id == "midturn-tool-2" =>
+                        {
+                            saw_third_response_before_compaction = true;
+                        }
+                        MessageContent::Text(text)
+                            if text.text.contains("done after mid-turn compaction") =>
+                        {
+                            saw_final_response = true;
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            AgentEvent::HistoryReplaced(history) => {
+                assert!(
+                    saw_third_response_before_compaction,
+                    "proactive compaction must occur only after the matching tool result lands"
+                );
+                compacted_history = Some(history);
+            }
+            _ => {}
+        }
+    }
+
+    assert!(saw_third_request_before_compaction);
+    assert!(saw_third_response_before_compaction);
+    assert_eq!(provider.compaction_calls.load(Ordering::SeqCst), 1);
+    assert!(
+        saw_final_response,
+        "the same reply stream must continue after proactive compaction"
+    );
+
+    let history = compacted_history.expect("mid-turn compaction should replace history");
+    for tool_id in ["midturn-tool-0", "midturn-tool-1", "midturn-tool-2"] {
+        let request_count = history
+            .messages()
+            .iter()
+            .flat_map(|message| message.content.iter())
+            .filter(|content| {
+                matches!(content, MessageContent::ToolRequest(request) if request.id == tool_id)
+            })
+            .count();
+        let response_count = history
+            .messages()
+            .iter()
+            .flat_map(|message| message.content.iter())
+            .filter(|content| {
+                matches!(content, MessageContent::ToolResponse(response) if response.id == tool_id)
+            })
+            .count();
+        assert_eq!(
+            request_count, 1,
+            "tool request {tool_id} must remain paired"
+        );
+        assert_eq!(
+            response_count, 1,
+            "tool response {tool_id} must remain paired"
+        );
+    }
+
+    let inputs = provider
+        .regular_input_tokens
+        .lock()
+        .expect("input token capture mutex poisoned")
+        .clone();
+    assert_eq!(inputs[..3], [6_000, 12_000, 18_000]);
+    assert!(
+        inputs.last().copied().unwrap_or(i32::MAX) < 18_000,
+        "provider input must shrink after compaction: {inputs:?}"
+    );
+
+    Ok(())
+}

+        engine::motion_binding::AnimationMotionRoute::Failed { .. } => {
+            ui.colored_label(egui::Color32::RED, format!("Route: {}", route.badge()))
+        }
+        _ => ui.label(format!("Route: {}", route.badge())),
+    };
+    response.on_hover_text(route.attempted_routing());
+}

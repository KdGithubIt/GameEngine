+    #[test]
+    fn tree_replacement_aborts_old_work_and_reports_new_generation_reset() {
+        let old_running = action("old_work");
+        let old_node = old_running.source.clone();
+        let old_tree = tree(old_running);
+        let old_graph = old_tree.source.clone();
+        let new_tree = tree(action("new_work"));
+        let new_graph = new_tree.source.clone();
+        let mut registry = BehaviorTreeBehaviorRegistry::default();
+        registry.set_action("old_work", BehaviorStatus::Running);
+        let mut runner = BehaviorTreeRunner::new(old_tree);
+
+        assert_eq!(runner.tick(&mut registry).unwrap(), BehaviorStatus::Running);
+        let before = runner.snapshot();
+        registry.clear_calls();
+        runner.replace_tree(new_tree, &mut registry).unwrap();
+        let replaced = runner.snapshot();
+
+        assert_eq!(before.tree_source, old_graph);
+        assert_eq!(replaced.tree_source, new_graph);
+        assert_eq!(replaced.tree_generation, before.tree_generation + 1);
+        assert_eq!(
+            replaced.execution_generation,
+            before.execution_generation + 1
+        );
+        assert_eq!(
+            replaced.last_reset_reason,
+            Some(BehaviorResetReason::TreeReplaced)
+        );
+        assert_eq!(registry.lifecycle_calls().len(), 1);
+        assert!(matches!(
+            registry.lifecycle_calls()[0],
+            BehaviorTreeLifecycleEvent::Abort {
+                reason: BehaviorResetReason::TreeReplaced,
+                ..
+            }
+        ));
+        assert!(replaced.recent_transitions.iter().any(|transition| {
+            transition.kind == BehaviorExecutionTransitionKind::Reset
+                && transition.reason == Some(BehaviorResetReason::TreeReplaced)
+        }));
+        assert!(
+            replaced
+                .recent_transitions
+                .iter()
+                .all(|transition| transition.node.as_ref() != Some(&old_node)),
+            "new generation snapshot must not retain source nodes from the replaced tree"
+        );
+    }

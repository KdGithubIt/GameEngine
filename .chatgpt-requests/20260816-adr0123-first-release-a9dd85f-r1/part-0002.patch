+        let inserted = &session.graph().nodes[&node];
+        assert_eq!(inserted.node_type, wait_type);
+        assert_eq!(
+            inserted.properties,
+            engine_authoring::Value::Object(std::collections::BTreeMap::from([(
+                "duration_seconds".into(),

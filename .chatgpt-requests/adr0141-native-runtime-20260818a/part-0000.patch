+            .unwrap_or_else(|| "mcp.unknown".to_owned());
+        match result {
+            Ok(value) => {
+                let _ = self.host.record_tool_action(
+                    &run_id,
+                    tool.clone(),
+                    "typed live Editor MCP call",
+                    Some(true),
+                );
+                self.record_native_result_and_continue(
+                    &run_id,
+                    tool,
+                    true,
+                    value.to_string(),
+                );
+            }
+            Err(error) => {
+                let _ = self.host.record_tool_action(
+                    &run_id,
+                    tool.clone(),
+                    "typed live Editor MCP call",
+                    Some(false),
+                );
+                self.record_native_result_and_continue(&run_id, tool, false, error);
+            }
+        }
+    }

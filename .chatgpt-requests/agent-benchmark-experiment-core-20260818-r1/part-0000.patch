+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::agent_benchmark::BENCHMARK_TASKS;
+
+    fn exact_head() -> String {
+        "0123456789abcdef0123456789abcdef01234567".to_owned()
+    }
+
+    fn four_model_spec(root: PathBuf) -> BenchmarkExperimentSpec {
+        BenchmarkExperimentSpec::local_single_model_comparison(
+            "suite",
+            exact_head(),
+            vec![
+                "model-a:q4".to_owned(),
+                "model-b:q4".to_owned(),
+                "model-c:q8".to_owned(),
+                "model-d:f16".to_owned(),
+            ],
+            BENCHMARK_TASKS.iter().map(|task| task.id.to_owned()).collect(),
+            3,
+            QualityPreference::Balanced,
+            root,
+        )
+    }
+
+    #[test]
+    fn four_models_seven_tasks_three_repetitions_plan_exactly_eighty_four_runs() {
+        let root = tempfile::tempdir().expect("root");
+        let spec = four_model_spec(root.path().to_path_buf());
+        let runs = spec.planned_runs().expect("plan");
+        assert_eq!(runs.len(), 84);
+        assert_eq!(runs.first().expect("first").ordinal, 0);
+        assert_eq!(runs.last().expect("last").ordinal, 83);
+    }
+
+    #[test]
+    fn seeded_order_is_deterministic_and_recorded() {
+        let root = tempfile::tempdir().expect("root");
+        let mut spec = four_model_spec(root.path().to_path_buf());
+        spec.execution_order = BenchmarkExecutionOrder::SeededInterleaved { seed: 42 };
+        let first = spec.planned_runs().expect("first");
+        let second = spec.planned_runs().expect("second");
+        assert_eq!(first, second);
+    }
+
+    #[test]
+    fn fixture_reset_removes_previous_run_contamination() {
+        let root = tempfile::tempdir().expect("root");
+        let template = root.path().join("template");
+        fs::create_dir_all(template.join("game/src")).expect("template");
+        fs::write(template.join("game/src/lib.rs"), "baseline").expect("baseline");
+        let sandbox = BenchmarkFixtureSandbox::new(template, root.path().join("runs"));
+        let destination = sandbox.reset_run("suite", 0).expect("reset");
+        fs::write(destination.join("game/src/lib.rs"), "mutated").expect("mutate");
+        fs::write(destination.join("generated.txt"), "contamination").expect("generated");
+        let reset = sandbox.reset_run("suite", 0).expect("reset again");
+        assert_eq!(fs::read_to_string(reset.join("game/src/lib.rs")).expect("text"), "baseline");
+        assert!(!reset.join("generated.txt").exists());
+    }
+
+    #[test]
+    fn single_model_result_rejects_router_contamination() {
+        let root = tempfile::tempdir().expect("root");
+        let spec = four_model_spec(root.path().to_path_buf());
+        let run = spec.planned_runs().expect("plan").remove(0);
+        let result = BenchmarkExperimentResult {
+            experiment_id: spec.experiment_id.clone(),
+            engine_commit_head: spec.engine_commit_head.clone(),
+            fixture_version: spec.fixture_version.clone(),
+            routing_mode: BenchmarkRoutingMode::SingleModel,
+            run,
+            started_unix_ms: 1,
+            finished_unix_ms: 2,
+            outcome: BenchmarkRunOutcome::Failed,
+            failure_kind: Some(BenchmarkRunFailureKind::Harness),
+            routed_to_another_model: true,
+            record: None,
+        };
+        assert!(result.validate_against(&spec).is_err());
+    }
+
+    #[test]
+    fn capability_mismatch_is_persistable_without_fabricated_success() {
+        let root = tempfile::tempdir().expect("root");
+        let spec = four_model_spec(root.path().to_path_buf());
+        let run = spec
+            .planned_runs()
+            .expect("plan")
+            .into_iter()
+            .find(|run| run.task_id == "visual_evaluation_v1")
+            .expect("visual run");
+        let result = BenchmarkExperimentResult {
+            experiment_id: spec.experiment_id.clone(),
+            engine_commit_head: spec.engine_commit_head.clone(),
+            fixture_version: spec.fixture_version.clone(),
+            routing_mode: BenchmarkRoutingMode::SingleModel,
+            run,
+            started_unix_ms: 10,
+            finished_unix_ms: 11,
+            outcome: BenchmarkRunOutcome::Unavailable,
+            failure_kind: Some(BenchmarkRunFailureKind::CapabilityUnavailable),
+            routed_to_another_model: false,
+            record: None,
+        };
+        result.validate_against(&spec).expect("valid unavailable result");
+    }
+}

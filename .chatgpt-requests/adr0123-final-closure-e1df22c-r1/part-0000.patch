+            .available_graph_node_kinds()
+            .into_iter()
+            .filter(|kind| kind.matches_search(&search_query))
+            .map(|kind| kind.label().to_owned())
+            .collect::<Vec<_>>()
+            .join("  •  ");
+        columns[1].label(matches);
+    });

+        let payload = TimelineClipPayload::Animation { animation_set: animation_set.clone(), motion_slot: motion_slot.clone() };
+        let json = serde_json::to_string(&payload).unwrap();
+        let loaded: TimelineClipPayload = serde_json::from_str(&json).unwrap();
+        assert_eq!(loaded, TimelineClipPayload::Animation { animation_set, motion_slot });
+        assert!(json.contains("animation_set"));
+        assert!(json.contains("motion_slot"));
+    }
+
+    #[test]
+    fn unbound_audio_track_is_valid_for_non_spatial_playback() {
+        let mut doc = TimelineDocument::new("audio", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "music".into(), kind: TimelineTrackKind::Audio, enabled: true, binding: None, clips: vec![clip(TimelineClipPayload::Audio { clip: AssetId::generate(), volume: 1.0, looping: false })] });
+        assert!(validate_timeline(&doc).is_empty());
+    }
+
+    #[test]
+    fn unsupported_property_is_rejected_instead_of_using_reflection() {
+        let mut doc = TimelineDocument::new("property", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "property".into(), kind: TimelineTrackKind::TransformProperty, enabled: true, binding: Some(TimelineBinding::Entity { entity: EntityId::generate() }), clips: vec![clip(TimelineClipPayload::TransformProperty { property: "engine.private.arbitrary_field".into(), keys: vec![TimelinePropertyKey { tick: TimelineTick::ZERO, value: TimelinePropertyValue::Number(0.0) }] })] });
+        let diagnostics = validate_timeline(&doc);
+        assert!(diagnostics.iter().any(|diagnostic| diagnostic.code == "timeline.property.unsupported"));
+    }
+
+    #[test]
+    fn property_curve_samples_multiple_clip_local_keys() {
+        let keys = vec![TimelinePropertyKey { tick: TimelineTick::ZERO, value: TimelinePropertyValue::Vec3([0.0, 2.0, 4.0]) }, TimelinePropertyKey { tick: TimelineTick::new(10), value: TimelinePropertyValue::Vec3([10.0, 4.0, 8.0]) }];
+        assert_eq!(sample_timeline_property(&keys, TimelineTick::new(5)), Some(TimelinePropertyValue::Vec3([5.0, 3.0, 6.0])));
+        assert_eq!(sample_timeline_property(&keys, TimelineTick::new(20)), Some(TimelinePropertyValue::Vec3([10.0, 4.0, 8.0])));
+    }
+
+    #[test]
+    fn property_curve_rejects_non_increasing_keys() {
+        let mut doc = TimelineDocument::new("property", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "property".into(), kind: TimelineTrackKind::TransformProperty, enabled: true, binding: Some(TimelineBinding::Entity { entity: EntityId::generate() }), clips: vec![clip(TimelineClipPayload::TransformProperty { property: "engine.transform.translation".into(), keys: vec![TimelinePropertyKey { tick: TimelineTick::new(5), value: TimelinePropertyValue::Vec3([0.0, 0.0, 0.0]) }, TimelinePropertyKey { tick: TimelineTick::new(5), value: TimelinePropertyValue::Vec3([1.0, 1.0, 1.0]) }] })] });
+        assert!(validate_timeline(&doc).iter().any(|diagnostic| diagnostic.code == "timeline.property.key_order"));
+    }
+
+    #[test]
+    fn event_payloads_are_bounded() {
+        let mut doc = TimelineDocument::new("event", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "events".into(), kind: TimelineTrackKind::Event, enabled: true, binding: None, clips: vec![clip(TimelineClipPayload::Event { name: "sequence.started".into(), payload: "x".repeat(MAX_TIMELINE_EVENT_PAYLOAD_BYTES + 1) })] });
+        let diagnostics = validate_timeline(&doc);
+        assert!(diagnostics.iter().any(|diagnostic| diagnostic.code == "timeline.event.payload_too_large"));
+    }
+
+    #[test]
+    fn event_clips_use_exact_crossing_and_scrub_preview_semantics() {
+        let mut doc = TimelineDocument::new("events", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "events".into(), kind: TimelineTrackKind::Event, enabled: true, binding: None, clips: vec![TimelineClip { id: TimelineClipId::generate(), name: "trigger".into(), start: TimelineTick::new(10), duration: TimelineTick::new(20), source_offset: TimelineTick::ZERO, payload: TimelineClipPayload::Event { name: "sequence.trigger".into(), payload: String::new() } }] });
+        let schedule = compile_timeline(&doc).schedule.expect("valid event Timeline");
+        let crossed = schedule.evaluate(&engine_timeline::EvaluationRequest { previous_tick: TimelineTick::new(9), current_tick: TimelineTick::new(10), mode: engine_timeline::EvaluationMode::Playback, generation: 1 });
+        assert_eq!(crossed.len(), 1);
+        let held_inside_old_interval = schedule.evaluate(&engine_timeline::EvaluationRequest { previous_tick: TimelineTick::new(10), current_tick: TimelineTick::new(11), mode: engine_timeline::EvaluationMode::Playback, generation: 1 });
+        assert!(held_inside_old_interval.is_empty());
+        let scrubbed = schedule.evaluate(&engine_timeline::EvaluationRequest { previous_tick: TimelineTick::ZERO, current_tick: TimelineTick::new(10), mode: engine_timeline::EvaluationMode::Seek { preview_events: false }, generation: 2 });
+        assert!(scrubbed.is_empty());
+        let previewed = schedule.evaluate(&engine_timeline::EvaluationRequest { previous_tick: TimelineTick::ZERO, current_tick: TimelineTick::new(10), mode: engine_timeline::EvaluationMode::Seek { preview_events: true }, generation: 3 });
+        assert_eq!(previewed.len(), 1);
+    }
+
+    #[test]
+    fn mismatched_typed_clip_is_diagnostic() {
+        let mut doc = TimelineDocument::new("x", TimelineTick::new(100));
+        doc.tracks.push(TimelineTrack { id: TimelineTrackId::generate(), name: "x".into(), kind: TimelineTrackKind::Audio, enabled: true, binding: Some(TimelineBinding::Entity { entity: EntityId::generate() }), clips: vec![clip(TimelineClipPayload::CameraCut)] });
+        assert!(doc.compile().schedule.is_none());
+    }
+}

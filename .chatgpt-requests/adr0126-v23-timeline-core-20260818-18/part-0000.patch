+/// Versioned Timeline source of truth.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct TimelineDocument {
+    /// Schema marker.
+    pub schema_version: u32,
+    /// Stable Timeline ID.
+    pub id: TimelineId,
+    /// Display name.
+    pub name: String,

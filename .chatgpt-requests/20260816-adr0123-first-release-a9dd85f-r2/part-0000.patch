+    /// Creates one schema-backed node with authoring defaults shared by every adapter.
+    ///
+    /// Action, condition, and generic decorator nodes use the caller-supplied stable
+    /// behavior ID. Stateful temporal decorators start at one second, which is valid
+    /// for Wait, Timeout, and Cooldown and remains editable through normal graph
+    /// property commands.
+    #[must_use]
+    pub fn create_node_with_defaults(
+        &self,
+        node_type: &NodeTypeId,
+        id: NodeId,
+        behavior: impl Into<String>,
+    ) -> Node {
+        let behavior = behavior.into();
+        if node_type == self.domain.root_type() {
+            self.domain.root_node(id)
+        } else if node_type == self.domain.sequence_type() {
+            self.domain.sequence_node(id)
+        } else if node_type == self.domain.selector_type() {
+            self.domain.selector_node(id)
+        } else if node_type == self.domain.condition_type() {
+            self.domain.condition_node(id, behavior.as_str())
+        } else if node_type == self.domain.action_type() {
+            self.domain.action_node(id, behavior.as_str())
+        } else if node_type == self.domain.decorator_type() {
+            self.domain.decorator_node(id, behavior.as_str())
+        } else if node_type == self.domain.inverter_type() {
+            self.domain.inverter_node(id)
+        } else if node_type == self.domain.wait_type() {
+            self.domain.wait_node(id, DEFAULT_STATEFUL_DURATION_SECONDS)
+        } else if node_type == self.domain.timeout_type() {
+            self.domain.timeout_node(id, DEFAULT_STATEFUL_DURATION_SECONDS)
+        } else if node_type == self.domain.cooldown_type() {
+            self.domain.cooldown_node(id, DEFAULT_STATEFUL_DURATION_SECONDS)
+        } else {
+            Node::new(id, node_type.clone(), Value::Object(BTreeMap::new()))
+        }
+    }

+    #[test]
+    fn shared_service_creates_every_catalog_node_with_valid_stateful_defaults() {
+        let service = BehaviorTreeAuthoringService::new();
+        for schema in service.schemas().nodes {
+            let node = service.create_node_with_defaults(
+                &schema.node_type,
+                NodeId::generate(),
+                "new_behavior",
+            );
+            assert_eq!(node.node_type, schema.node_type);
+            if &node.node_type == service.domain().wait_type()
+                || &node.node_type == service.domain().timeout_type()
+                || &node.node_type == service.domain().cooldown_type()
+            {
+                assert_eq!(
+                    duration_value(&node),
+                    Some(DEFAULT_STATEFUL_DURATION_SECONDS)
+                );
+            }
+        }
+    }

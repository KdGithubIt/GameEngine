+    /// Opens a validated `*.vfx.json` effect.
+    pub fn open_vfx(&mut self, path: PathBuf) -> Result<(), OpenDocumentError> {
+        if self.is_dirty() {
+            return Err(OpenDocumentError::UnsavedChanges);
+        }
+        self.open_vfx_discarding_changes(path)
+    }
+
+    /// Opens a validated VFX effect after the caller resolved unsaved changes.
+    pub fn open_vfx_discarding_changes(&mut self, path: PathBuf) -> Result<(), OpenDocumentError> {
+        let document = open_vfx_from_path(&path)?;
+        let diagnostics = match &document {
+            CurrentDocument::Vfx { effect, .. } => {
+                engine_authoring::VfxAuthoringService::new()
+                    .validate(effect)
+                    .diagnostics
+            }
+            CurrentDocument::None
+            | CurrentDocument::Scene { .. }
+            | CurrentDocument::Graph { .. }
+            | CurrentDocument::Ui { .. } => Vec::new(),
+        };
+        self.current_document = document;
+        self.scene_session = None;
+        self.undo_stack.clear();

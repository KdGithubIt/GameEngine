+/// Opens and validates a `*.vfx.json` effect through the shared authoring service.
+pub fn open_vfx_from_path(path: &Path) -> Result<CurrentDocument, OpenDocumentError> {
+    let json = fs::read_to_string(path).map_err(OpenDocumentError::Io)?;
+    let effect = VfxAuthoringService::new()
+        .effect_from_json(&json)
+        .map_err(OpenDocumentError::VfxDocument)?;
+    Ok(CurrentDocument::Vfx {
+        effect,
+        path: path.to_path_buf(),
+        is_dirty: false,
+    })
+}

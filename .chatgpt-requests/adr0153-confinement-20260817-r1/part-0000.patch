+
+fn mcp_endpoint_is_loopback(endpoint: &str) -> bool {
+    let authority = endpoint
+        .split_once("://")
+        .map_or(endpoint, |(_, remainder)| remainder)
+        .split('/')
+        .next()
+        .unwrap_or_default();
+    authority == "127.0.0.1"
+        || authority.starts_with("127.0.0.1:")
+        || authority == "localhost"
+        || authority.starts_with("localhost:")
+        || authority == "[::1]"
+        || authority.starts_with("[::1]:")
+}

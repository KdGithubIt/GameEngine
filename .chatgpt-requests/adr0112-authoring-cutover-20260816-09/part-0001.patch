@@ -107,8 +107,8 @@ pub fn asset_path_matches_kind(kind: AssetKind, path: &Path) -> bool {
-        // Skins, skeletons, morphs, and rigid-body rigs are only ever
+        // Skins, skeletons, morphs, and secondary-motion rigs are only ever

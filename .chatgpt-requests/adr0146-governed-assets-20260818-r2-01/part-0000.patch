+//! Governed external and generated asset acquisition for AI Studio.
+//!
+//! Providers return bounded in-memory artifacts into an Editor-owned staging
+//! area. Only the existing asset-management import path may copy those bytes
+//! into a project or update `asset_manifest.json`.
+
+use crate::agent_host::{
+    AgentCapability, AgentHost, AgentHostError, AssetAcquisitionRecord, PermissionCheck,
+};
+use crate::asset_management::{import_external_asset_files, AssetManagementError};
+use engine::AssetManifest;
+use engine_authoring::ProjectRoot;
+use std::collections::BTreeSet;
+use std::fmt;
+use std::fs;
+use std::io;
+use std::path::{Component, Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const MAX_PROVIDER_ARTIFACTS: usize = 32;
+const MAX_PROVIDER_ARTIFACT_BYTES: usize = 32 * 1024 * 1024;
+const MAX_ACQUISITION_BYTES: usize = 64 * 1024 * 1024;
+const MAX_PROVIDER_SEARCH_RESULTS: usize = 64;
+const MAX_METADATA_CHARS: usize = 2_048;
+

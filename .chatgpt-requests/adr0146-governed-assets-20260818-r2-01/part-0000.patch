+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct AssetAcquisitionRequest {
+    pub(crate) request_id: String,
+    pub(crate) operation: AssetProviderOperation,
+    pub(crate) destination_folder: PathBuf,
+    pub(crate) explicit_user_decision: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct AcquiredAsset {
+    pub(crate) asset_id: String,
+    pub(crate) path: PathBuf,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct AssetAcquisitionResult {
+    pub(crate) assets: Vec<AcquiredAsset>,
+    pub(crate) reused: bool,
+}
+
+#[derive(Debug)]
+pub(crate) enum AssetAcquisitionError {
+    Host(AgentHostError),
+    PermissionRequired(AgentCapability),
+    PermissionDenied(AgentCapability),
+    ExplicitUserDecisionRequired,
+    InvalidRequest(&'static str),
+    IdempotencyConflict,
+    Cancelled,
+    Provider(ProviderFailureKind),
+    ArtifactRejected(&'static str),
+    ImportRejected,
+    Import(AssetManagementError),
+    StagingIo(io::Error),
+}
+
+impl AssetAcquisitionError {
+    pub(crate) fn category(&self) -> &'static str {
+        match self {
+            Self::Host(_) => "host_failed",
+            Self::PermissionRequired(_) => "permission_required",
+            Self::PermissionDenied(_) => "permission_denied",
+            Self::ExplicitUserDecisionRequired => "explicit_user_decision_required",
+            Self::InvalidRequest(_) => "invalid_request",
+            Self::IdempotencyConflict => "idempotency_conflict",
+            Self::Cancelled => "cancelled",
+            Self::Provider(kind) => kind.label(),
+            Self::ArtifactRejected(_) => "artifact_rejected",
+            Self::ImportRejected => "import_rejected",
+            Self::Import(_) => "import_failed",
+            Self::StagingIo(_) => "staging_failed",
+        }
+    }
+}
+
+impl fmt::Display for AssetAcquisitionError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Host(error) => write!(formatter, "agent host failed: {error}"),
+            Self::PermissionRequired(capability) => {
+                write!(formatter, "permission required: {}", capability.label())
+            }
+            Self::PermissionDenied(capability) => {
+                write!(formatter, "permission denied: {}", capability.label())
+            }
+            Self::ExplicitUserDecisionRequired => formatter.write_str(
+                "the provider operation requires an additional explicit user decision",
+            ),
+            Self::InvalidRequest(reason) => {
+                write!(formatter, "invalid acquisition request: {reason}")
+            }
+            Self::IdempotencyConflict => formatter.write_str(
+                "the acquisition request identity was already used for different work",
+            ),
+            Self::Cancelled => formatter.write_str("asset acquisition was cancelled"),
+            Self::Provider(kind) => write!(formatter, "asset provider failed as {}", kind.label()),
+            Self::ArtifactRejected(reason) => {
+                write!(formatter, "provider artifact was rejected: {reason}")
+            }
+            Self::ImportRejected => formatter.write_str(
+                "provider artifacts did not produce a registered project asset",
+            ),
+            Self::Import(error) => write!(formatter, "asset import failed: {error}"),
+            Self::StagingIo(error) => write!(formatter, "asset staging failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for AssetAcquisitionError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Host(error) => Some(error),
+            Self::Import(error) => Some(error),
+            Self::StagingIo(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+impl From<AgentHostError> for AssetAcquisitionError {
+    fn from(value: AgentHostError) -> Self {
+        Self::Host(value)
+    }
+}
+
+impl From<AssetManagementError> for AssetAcquisitionError {
+    fn from(value: AssetManagementError) -> Self {
+        Self::Import(value)
+    }
+}

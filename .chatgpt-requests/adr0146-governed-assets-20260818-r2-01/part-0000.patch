+#[derive(Clone, Default)]
+pub(crate) struct AssetAcquisitionCancellation {
+    cancelled: Arc<AtomicBool>,
+}
+
+impl fmt::Debug for AssetAcquisitionCancellation {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("AssetAcquisitionCancellation")
+            .field("cancelled", &self.is_cancelled())
+            .finish()
+    }
+}
+
+impl AssetAcquisitionCancellation {
+    pub(crate) fn cancel(&self) {
+        self.cancelled.store(true, Ordering::Release);
+    }
+
+    pub(crate) fn is_cancelled(&self) -> bool {
+        self.cancelled.load(Ordering::Acquire)
+    }
+}
+
+pub(crate) struct AssetProviderContext<'a> {
+    credential: Option<&'a str>,
+    cancellation: &'a AssetAcquisitionCancellation,
+}
+
+impl fmt::Debug for AssetProviderContext<'_> {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("AssetProviderContext")
+            .field("credential", &self.credential.map(|_| "[redacted]"))
+            .field("cancellation", &self.cancellation)
+            .finish()
+    }
+}
+
+impl<'a> AssetProviderContext<'a> {
+    pub(crate) fn new(
+        credential: Option<&'a str>,
+        cancellation: &'a AssetAcquisitionCancellation,
+    ) -> Self {
+        Self {
+            credential,
+            cancellation,
+        }
+    }
+
+    pub(crate) fn credential(&self) -> Option<&str> {
+        self.credential
+    }
+
+    pub(crate) fn cancellation(&self) -> &AssetAcquisitionCancellation {
+        self.cancellation
+    }
+}
+
+pub(crate) trait AgentAssetProvider {
+    fn provider_id(&self) -> &str;
+
+    fn search_requirements(&self) -> AssetProviderRequirements {
+        AssetProviderRequirements::default()
+    }
+
+    fn operation_requirements(
+        &self,
+        _operation: &AssetProviderOperation,
+    ) -> AssetProviderRequirements {
+        AssetProviderRequirements::default()
+    }
+
+    fn search(
+        &mut self,
+        _request: &AssetSearchRequest,
+        _context: &AssetProviderContext<'_>,
+    ) -> Result<Vec<AssetSearchResult>, ProviderFailure> {
+        Err(ProviderFailure::unsupported("search"))
+    }
+
+    fn acquire(
+        &mut self,
+        _provider_asset_id: &str,
+        _context: &AssetProviderContext<'_>,
+    ) -> Result<AssetProviderOutput, ProviderFailure> {
+        Err(ProviderFailure::unsupported("acquisition"))
+    }
+
+    fn generate(
+        &mut self,
+        _kind: GeneratedAssetKind,
+        _prompt: &str,
+        _context: &AssetProviderContext<'_>,
+    ) -> Result<AssetProviderOutput, ProviderFailure> {
+        Err(ProviderFailure::unsupported("generation"))
+    }
+}

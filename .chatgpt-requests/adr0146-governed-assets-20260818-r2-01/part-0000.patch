+pub(crate) struct AgentAssetAcquisitionService;
+
+impl AgentAssetAcquisitionService {
+    pub(crate) fn search(
+        host: &mut AgentHost,
+        run_id: &str,
+        provider: &mut dyn AgentAssetProvider,
+        request: &AssetSearchRequest,
+        context: &AssetProviderContext<'_>,
+    ) -> Result<Vec<AssetSearchResult>, AssetAcquisitionError> {
+        if context.cancellation().is_cancelled() {
+            return Err(AssetAcquisitionError::Cancelled);
+        }
+        let requirements = provider.search_requirements();
+        require_permissions(host, run_id, requirements.requires_network)?;
+        let results = provider.search(request, context).map_err(|failure| {
+            AssetAcquisitionError::Provider(failure.kind)
+        })?;
+        if context.cancellation().is_cancelled() {
+            return Err(AssetAcquisitionError::Cancelled);
+        }
+        let limit = request.limit.min(MAX_PROVIDER_SEARCH_RESULTS);
+        let sanitized = results
+            .into_iter()
+            .take(limit)
+            .map(|result| AssetSearchResult {
+                provider_asset_id: sanitize_metadata(&result.provider_asset_id),
+                title: sanitize_metadata(&result.title),
+                source_reference: result
+                    .source_reference
+                    .as_deref()
+                    .map(sanitize_source_reference),
+                license: result.license.as_deref().map(sanitize_metadata),
+            })
+            .collect::<Vec<_>>();
+        host.record_tool_action(
+            run_id,
+            "asset.search",
+            format!("Managed provider search returned {} result(s).", sanitized.len()),
+            Some(true),
+        )?;
+        Ok(sanitized)
+    }
+
+    pub(crate) fn execute(
+        host: &mut AgentHost,
+        run_id: &str,
+        project: &ProjectRoot,
+        manifest: &mut AssetManifest,
+        provider: &mut dyn AgentAssetProvider,
+        request: &AssetAcquisitionRequest,
+        context: &AssetProviderContext<'_>,
+    ) -> Result<AssetAcquisitionResult, AssetAcquisitionError> {
+        validate_request_id(&request.request_id)?;
+        let fingerprint = request_fingerprint(provider.provider_id(), request);
+        if let Some(existing) = host
+            .run(run_id)?
+            .audit
+            .asset_acquisitions
+            .iter()
+            .find(|record| record.request_id == request.request_id)
+        {
+            if existing.request_fingerprint != fingerprint {
+                return Err(AssetAcquisitionError::IdempotencyConflict);
+            }
+            return Ok(result_from_record(existing, true));
+        }
+        if context.cancellation().is_cancelled() {
+            record_failure(host, run_id, &request.request_id, "cancelled")?;
+            return Err(AssetAcquisitionError::Cancelled);
+        }
+        let requirements = provider.operation_requirements(&request.operation);
+        if requirements.requires_explicit_user_decision && !request.explicit_user_decision {
+            return Err(AssetAcquisitionError::ExplicitUserDecisionRequired);
+        }
+        require_permissions(host, run_id, requirements.requires_network)?;
+
+        let output = match &request.operation {
+            AssetProviderOperation::Acquire { provider_asset_id } => {
+                provider.acquire(provider_asset_id, context)
+            }
+            AssetProviderOperation::Generate { kind, prompt } => {
+                provider.generate(*kind, prompt, context)
+            }
+        };
+        let output = match output {
+            Ok(output) => output,
+            Err(failure) => {
+                record_failure(host, run_id, &request.request_id, failure.kind.label())?;
+                return Err(AssetAcquisitionError::Provider(failure.kind));
+            }
+        };
+        if context.cancellation().is_cancelled() {
+            record_failure(host, run_id, &request.request_id, "cancelled")?;
+            return Err(AssetAcquisitionError::Cancelled);
+        }
+        validate_output(&output)?;
+
+        let staging_root = host.asset_acquisition_staging_root(run_id)?;
+        let staging = staging_root.join(format!("request-{fingerprint}"));
+        if staging.exists() {
+            fs::remove_dir_all(&staging).map_err(AssetAcquisitionError::StagingIo)?;
+        }
+        fs::create_dir_all(&staging).map_err(AssetAcquisitionError::StagingIo)?;
+        let staged_paths = match stage_artifacts(&staging, &output.artifacts) {
+            Ok(paths) => paths,
+            Err(error) => {
+                let _ = fs::remove_dir_all(&staging);
+                return Err(error);
+            }
+        };
+        if context.cancellation().is_cancelled() {
+            let _ = fs::remove_dir_all(&staging);
+            record_failure(host, run_id, &request.request_id, "cancelled")?;
+            return Err(AssetAcquisitionError::Cancelled);
+        }
+
+        let import = import_external_asset_files(
+            project,
+            manifest,
+            &staged_paths,
+            &request.destination_folder,
+        );
+        let cleanup = fs::remove_dir_all(&staging);
+        let report = match import {
+            Ok(report) => report,
+            Err(error) => {
+                record_failure(host, run_id, &request.request_id, "import_failed")?;
+                return Err(AssetAcquisitionError::Import(error));
+            }
+        };
+        if report.registered.is_empty() || !report.failures.is_empty() {
+            record_failure(host, run_id, &request.request_id, "import_rejected")?;
+            return Err(AssetAcquisitionError::ImportRejected);
+        }
+
+        let provider_id = sanitize_metadata(provider.provider_id());
+        let provenance = sanitize_provenance(output.provenance);
+        let assets = report
+            .registered
+            .iter()
+            .map(|imported| AcquiredAsset {
+                asset_id: imported.asset_id.as_str().to_owned(),
+                path: imported.destination.clone(),
+            })
+            .collect::<Vec<_>>();
+        let record = AssetAcquisitionRecord {
+            request_id: request.request_id.clone(),
+            request_fingerprint: fingerprint,
+            operation: request.operation.label().to_owned(),
+            provider: provider_id,
+            provider_asset_id: provenance.provider_asset_id,
+            generation_request_id: provenance.generation_request_id,
+            source: provenance.source_reference.unwrap_or_default(),
+            source_version: provenance.source_version,
+            license: provenance.license,
+            imported_asset_ids: assets.iter().map(|asset| asset.asset_id.clone()).collect(),
+            imported_paths: assets.iter().map(|asset| asset.path.clone()).collect(),
+            created_unix_ms: unix_ms(),
+        };
+        host.record_asset_acquisition(run_id, record)?;
+        if cleanup.is_err() {
+            host.record_tool_action(
+                run_id,
+                "asset.acquire",
+                "Managed acquisition completed, but local staging cleanup failed.",
+                Some(false),
+            )?;
+        }
+        Ok(AssetAcquisitionResult {
+            assets,
+            reused: false,
+        })
+    }
+}
+
+fn require_permissions(
+    host: &mut AgentHost,
+    run_id: &str,
+    requires_network: bool,
+) -> Result<(), AssetAcquisitionError> {
+    require_permission(host, run_id, AgentCapability::ExternalAssetAcquisition)?;
+    if requires_network {
+        require_permission(host, run_id, AgentCapability::NetworkAccess)?;
+    }
+    Ok(())
+}
+
+fn require_permission(
+    host: &mut AgentHost,
+    run_id: &str,
+    capability: AgentCapability,
+) -> Result<(), AssetAcquisitionError> {
+    match host.check_permission(run_id, capability)? {
+        PermissionCheck::Granted => Ok(()),
+        PermissionCheck::RequiresApproval => {
+            Err(AssetAcquisitionError::PermissionRequired(capability))
+        }
+        PermissionCheck::Denied => Err(AssetAcquisitionError::PermissionDenied(capability)),
+    }
+}
+
+fn validate_request_id(request_id: &str) -> Result<(), AssetAcquisitionError> {
+    if request_id.is_empty()
+        || request_id.len() > 128
+        || !request_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return Err(AssetAcquisitionError::InvalidRequest(
+            "request_id must use 1-128 ASCII letters, digits, '.', '-', or '_'",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_output(output: &AssetProviderOutput) -> Result<(), AssetAcquisitionError> {
+    if output.artifacts.is_empty() {
+        return Err(AssetAcquisitionError::ArtifactRejected(
+            "provider returned no artifacts",
+        ));
+    }
+    if output.artifacts.len() > MAX_PROVIDER_ARTIFACTS {
+        return Err(AssetAcquisitionError::ArtifactRejected(
+            "provider returned too many artifacts",
+        ));
+    }
+    let mut total = 0usize;
+    let mut names = BTreeSet::new();
+    for artifact in &output.artifacts {
+        validate_artifact_file_name(&artifact.file_name)?;
+        if artifact.bytes.is_empty() || artifact.bytes.len() > MAX_PROVIDER_ARTIFACT_BYTES {
+            return Err(AssetAcquisitionError::ArtifactRejected(
+                "provider artifact size is outside the supported bounds",
+            ));
+        }
+        total = total
+            .checked_add(artifact.bytes.len())
+            .ok_or(AssetAcquisitionError::ArtifactRejected(
+                "provider artifact size overflowed the acquisition bound",
+            ))?;
+        if total > MAX_ACQUISITION_BYTES {
+            return Err(AssetAcquisitionError::ArtifactRejected(
+                "provider artifacts exceeded the total acquisition size limit",
+            ));
+        }
+        if !names.insert(artifact.file_name.to_ascii_lowercase()) {
+            return Err(AssetAcquisitionError::ArtifactRejected(
+                "provider returned duplicate artifact filenames",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn validate_artifact_file_name(file_name: &str) -> Result<(), AssetAcquisitionError> {
+    if file_name.is_empty()
+        || file_name.contains('/')
+        || file_name.contains('\\')
+        || file_name.contains(':')
+        || file_name == "."
+        || file_name == ".."
+        || Path::new(file_name).components().any(|component| {
+            !matches!(component, Component::Normal(_))
+        })
+    {
+        return Err(AssetAcquisitionError::ArtifactRejected(
+            "artifact filename must be one normal path component",
+        ));
+    }
+    Ok(())
+}
+
+fn stage_artifacts(
+    staging: &Path,
+    artifacts: &[AssetProviderArtifact],
+) -> Result<Vec<PathBuf>, AssetAcquisitionError> {
+    artifacts
+        .iter()
+        .map(|artifact| {
+            let path = staging.join(&artifact.file_name);
+            fs::write(&path, &artifact.bytes).map_err(AssetAcquisitionError::StagingIo)?;
+            Ok(path)
+        })
+        .collect()
+}
+
+fn sanitize_provenance(provenance: AssetProviderProvenance) -> AssetProviderProvenance {
+    AssetProviderProvenance {
+        provider_asset_id: provenance.provider_asset_id.as_deref().map(sanitize_metadata),
+        source_reference: provenance
+            .source_reference
+            .as_deref()
+            .map(sanitize_source_reference),
+        generation_request_id: provenance
+            .generation_request_id
+            .as_deref()
+            .map(sanitize_metadata),
+        license: provenance.license.as_deref().map(sanitize_metadata),
+        source_version: provenance.source_version.as_deref().map(sanitize_metadata),
+    }
+}
+
+fn sanitize_source_reference(value: &str) -> String {
+    if looks_like_absolute_path(value) {
+        return "[local source]".to_owned();
+    }
+    let without_query = value.split_once('?').map_or(value, |(prefix, _)| prefix);
+    let without_fragment = without_query
+        .split_once('#')
+        .map_or(without_query, |(prefix, _)| prefix);
+    sanitize_metadata(without_fragment)
+}
+
+fn looks_like_absolute_path(value: &str) -> bool {
+    value.starts_with('/')
+        || value.starts_with("\\\\")
+        || value.as_bytes().get(1) == Some(&b':')
+            && value
+                .as_bytes()
+                .get(2)
+                .is_some_and(|byte| matches!(byte, b'\\' | b'/'))
+}
+
+fn sanitize_metadata(value: &str) -> String {
+    let lowered = value.to_ascii_lowercase();
+    if lowered.contains("authorization: bearer")
+        || lowered.contains("api_key=")
+        || lowered.contains("apikey=")
+        || lowered.contains("access_token=")
+        || lowered.contains("secret=")
+        || lowered.contains("gameengine_mcp_auth_token")
+    {
+        return "[redacted]".to_owned();
+    }
+    let trimmed = value.trim();
+    if trimmed.chars().count() <= MAX_METADATA_CHARS {
+        return trimmed.to_owned();
+    }
+    let mut truncated = trimmed.chars().take(MAX_METADATA_CHARS).collect::<String>();
+    truncated.push('…');
+    truncated
+}
+
+fn request_fingerprint(provider_id: &str, request: &AssetAcquisitionRequest) -> String {
+    let mut hash = 0xcbf29ce484222325u64;
+    fn append(hash: &mut u64, bytes: &[u8]) {
+        for byte in bytes {
+            *hash ^= u64::from(*byte);
+            *hash = hash.wrapping_mul(0x100000001b3);
+        }
+        *hash ^= 0xff;
+        *hash = hash.wrapping_mul(0x100000001b3);
+    }
+    append(&mut hash, provider_id.as_bytes());
+    append(
+        &mut hash,
+        request.destination_folder.to_string_lossy().as_bytes(),
+    );
+    match &request.operation {
+        AssetProviderOperation::Acquire { provider_asset_id } => {
+            append(&mut hash, b"acquire");
+            append(&mut hash, provider_asset_id.as_bytes());
+        }
+        AssetProviderOperation::Generate { kind, prompt } => {
+            append(&mut hash, b"generate");
+            append(&mut hash, kind.label().as_bytes());
+            append(&mut hash, prompt.as_bytes());
+        }
+    }
+    format!("fnv1a64-{hash:016x}")
+}
+
+fn result_from_record(record: &AssetAcquisitionRecord, reused: bool) -> AssetAcquisitionResult {
+    let assets = record
+        .imported_paths
+        .iter()
+        .enumerate()
+        .map(|(index, path)| AcquiredAsset {
+            asset_id: record
+                .imported_asset_ids
+                .get(index)
+                .cloned()
+                .unwrap_or_default(),
+            path: path.clone(),
+        })
+        .collect();
+    AssetAcquisitionResult { assets, reused }
+}
+
+fn record_failure(
+    host: &mut AgentHost,
+    run_id: &str,
+    request_id: &str,
+    category: &str,
+) -> Result<(), AgentHostError> {
+    host.record_tool_action(
+        run_id,
+        "asset.acquire",
+        format!(
+            "Managed acquisition request `{}` finished without an imported asset: {}.",
+            sanitize_metadata(request_id),
+            sanitize_metadata(category)
+        ),
+        Some(false),
+    )
+}
+
+fn unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |duration| {
+            u64::try_from(duration.as_millis()).unwrap_or(u64::MAX)
+        })
+}

+/// Spawn volume used by the shape module.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "shape", rename_all = "snake_case")]
+pub enum VfxShape {
+    /// Spawns at the emitter origin.
+    Point,
+    /// Spawns inside an axis-aligned box centered on the emitter.
+    Box {
+        /// Positive XYZ half-extents.
+        half_extents: [f32; 3],
+    },
+    /// Spawns inside a sphere centered on the emitter.
+    Sphere {
+        /// Non-negative sphere radius.
+        radius: f32,
+    },
+    /// Spawns inside a cone oriented by a local direction.
+    Cone {
+        /// Local cone axis; zero vectors are invalid.
+        direction: [f32; 3],
+        /// Half-angle in radians in `[0, pi/2)`.
+        angle_radians: f32,
+        /// Non-negative radius at the cone base.
+        radius: f32,
+    },
+}
+
+impl VfxShape {
+    fn validate(&self) -> bool {
+        match self {
+            Self::Point => true,
+            Self::Box { half_extents } => {
+                finite3(*half_extents) && half_extents.iter().all(|value| *value >= 0.0)
+            }
+            Self::Sphere { radius } => radius.is_finite() && *radius >= 0.0,
+            Self::Cone {
+                direction,
+                angle_radians,
+                radius,
+            } => {
+                finite3(*direction)
+                    && direction.iter().any(|value| value.abs() > f32::EPSILON)
+                    && angle_radians.is_finite()
+                    && (0.0..std::f32::consts::FRAC_PI_2).contains(angle_radians)
+                    && radius.is_finite()
+                    && *radius >= 0.0
+            }
+        }
+    }
+}
+
+/// Texture-sheet playback data shared by billboard and mesh render modules.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxTextureSheet {
+    /// Number of horizontal cells.
+    pub columns: u32,
+    /// Number of vertical cells.
+    pub rows: u32,
+    /// Normalized frame selection over particle lifetime, where `0` is the
+    /// first cell and `1` is the last cell.
+    pub frame_over_life: VfxCurve,
+}
+
+impl VfxTextureSheet {
+    fn is_valid(&self) -> bool {
+        self.columns > 0 && self.rows > 0 && self.frame_over_life.is_valid()
+    }
+}

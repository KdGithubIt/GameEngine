+        "GameEngine Launcher",
+        options,
+        Box::new(move |_creation_context| Ok(Box::new(LauncherApp::new(session)))),
+    )
+    .map_err(|error| error.to_string())
+}
+
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("[launcher.startup_failed] {error}");
+        std::process::exit(1);
+    }
+}

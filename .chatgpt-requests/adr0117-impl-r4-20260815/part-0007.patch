+fn prefs_path(project: &ProjectRoot) -> Option<PathBuf> {
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64;
+    #[cfg(windows)]
+    let normalized = project.path().to_string_lossy().to_lowercase();

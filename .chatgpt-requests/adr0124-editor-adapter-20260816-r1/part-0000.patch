+/// Thin Editor-facing adapter over the shared production navigation bake service.
+pub mod navmesh_bake {
+    pub use engine::navigation_bake::{
+        bake_scene_navmesh, is_scene_navmesh_stale, prepare_scene_navmesh, NavMeshBakeDocument,
+        NavMeshBakeError, NavMeshBakeResult, NavMeshBakeSettings, NavigationBakeService,
+        NavigationBakeServiceError, NavigationBakeStats, NavigationSource,
+        NAVMESH_BAKE_SCHEMA_VERSION,
+    };
+
+    /// Persists one shared bake document through the authoring safe-replacement path.
+    ///
+    /// # Errors
+    ///
+    /// Returns a display-ready message when validation, serialization, or replacement fails.
+    pub fn persist_document(
+        path: &std::path::Path,
+        document: &NavMeshBakeDocument,
+    ) -> Result<(), String> {
+        let json = document
+            .to_canonical_json()
+            .map_err(|error| error.to_string())?;
+        engine_authoring::replace_file_contents(path, &json).map_err(|error| error.to_string())
+    }
+}

++//! Shared Scene query and transaction service used by Editor, CLI, and MCP.
++//!
++//! The service deliberately operates on [`AuthoringSession`] rather than on
++//! files. Applications own document selection and persistence; this layer owns
++//! stale-revision checks, permission checks, validation, semantic diffs, and
++//! one-transaction mutation semantics.
++
++use crate::{
++    AuthoringCommand, AuthoringEntity, AuthoringPermission, AuthoringPermissionError,
++    AuthoringPermissions, AuthoringSession, Change, Diagnostic, EntityId, Severity,
++    TransactionError,
++};
++use serde::Serialize;
++use std::fmt;
++
++/// Immutable Scene state returned by structured authoring inspection.
++#[derive(Debug, Clone, PartialEq, Serialize)]
++pub struct SceneAuthoringSnapshot {
++    /// Logical content revision of the committed Scene.
++    pub revision: u64,
++    /// Monotonic generation used to reject stale mutations across undo/redo.
++    pub generation: u64,
++    /// Entities in deterministic stable-ID order.
++    pub entities: Vec<AuthoringEntity>,
++}
++
++/// Structured validation result for one committed Scene.
++#[derive(Debug, Clone, PartialEq, Serialize)]
++pub struct SceneAuthoringValidation {
++    /// Logical content revision validated by this result.
++    pub revision: u64,
++    /// Monotonic mutation generation validated by this result.
++    pub generation: u64,
++    /// Whether no blocking diagnostic was produced.
++    pub success: bool,
++    /// Structured Scene diagnostics.
++    pub diagnostics: Vec<Diagnostic>,
++}
++
++/// Result of previewing or committing one bulk Scene mutation.
++#[derive(Debug, Clone, PartialEq, Serialize)]
++pub struct SceneAuthoringMutation {
++    /// Whether the requested command batch passed validation.
++    pub success: bool,
++    /// Revision the caller supplied as its base.
++    pub base_revision: u64,
++    /// Generation the caller supplied as its base.
++    pub base_generation: u64,
++    /// Current committed revision after this operation.
++    ///
++    /// Preview leaves this equal to `base_revision`; apply advances it when the
++    /// mutation commits.
++    pub revision: u64,
++    /// Current committed generation after this operation.
++    ///
++    /// Preview leaves this equal to `base_generation`; apply advances it when
++    /// the mutation commits.
++    pub generation: u64,
++    /// Structured diagnostics produced by command and Scene validation.
++    pub diagnostics: Vec<Diagnostic>,
++    /// Deterministic semantic diff produced by the command batch.
++    pub diff: Vec<Change>,
++}
++
++/// Shared Scene authoring service failure.
++#[derive(Debug)]
++pub enum SceneAuthoringError {
++    /// The application did not grant the permission required by this operation.
++    Permission(AuthoringPermissionError),
++    /// The mutation/preview base no longer matches the live Scene.
++    Stale {
++        /// Revision supplied by the caller.
++        expected_revision: u64,
++        /// Generation supplied by the caller.
++        expected_generation: u64,
++        /// Current committed Scene revision.
++        actual_revision: u64,
++        /// Current committed Scene generation.
++        actual_generation: u64,
++    },
++    /// A transaction failed after the shared preflight checks.
++    Transaction(TransactionError),
++}
++
++impl SceneAuthoringError {
++    /// Returns a stable diagnostic-style error code.
++    pub fn code(&self) -> &'static str {
++        match self {
++            Self::Permission(error) => error.code(),
++            Self::Stale { .. } => "authoring.stale_revision",
++            Self::Transaction(TransactionError::ValidationFailed { .. }) => {
++                "authoring.validation_failed"
++            }
++            Self::Transaction(TransactionError::Conflict { .. }) => "authoring.transaction_conflict",
++        }
++    }
++}
++
++impl fmt::Display for SceneAuthoringError {
++    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
++        match self {
++            Self::Permission(error) => error.fmt(formatter),
++            Self::Stale {
++                expected_revision,
++                expected_generation,
++                actual_revision,
++                actual_generation,
++            } => write!(
++                formatter,
++                "stale Scene base: expected revision {expected_revision} generation {expected_generation}, current revision {actual_revision} generation {actual_generation}"
++            ),
++            Self::Transaction(error) => error.fmt(formatter),
++        }
++    }
++}
++
++impl std::error::Error for SceneAuthoringError {
++    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
++        match self {
++            Self::Permission(error) => Some(error),
++            Self::Transaction(error) => Some(error),
++            Self::Stale { .. } => None,
++        }
++    }
++}
++
++impl From<AuthoringPermissionError> for SceneAuthoringError {
++    fn from(value: AuthoringPermissionError) -> Self {
++        Self::Permission(value)
++    }
++}
++
++impl From<TransactionError> for SceneAuthoringError {
++    fn from(value: TransactionError) -> Self {
++        Self::Transaction(value)
++    }
++}
++
++/// GUI-free Scene authoring behavior shared by every structured adapter.
++#[derive(Debug, Default, Clone, Copy)]

+            &effect,
+            &[VfxCommand::SetEffectMaxParticles { max_particles: 0 }],
+        );
+        assert!(!applied.success);
+        assert!(applied.effect.is_none());
+        assert!(applied.undo_commands.is_empty());
+    }

+            module(VfxModuleOperation::Burst { time: 0.0, count: 4 }),
+            module(VfxModuleOperation::Lifetime {
+                value: VfxScalarValue::Constant { value: 2.0 },
+            }),
+            module(VfxModuleOperation::Billboard {
+                material: None,
+                texture_sheet: None,
+            }),
+        ];
+        effect.emitters.push(emitter);
+
+        let compilation = service.compile(&effect);
+        assert!(compilation.success);
+        assert_eq!(
+            compilation.compiled_effect.as_ref().unwrap().emitters[0].estimated_capacity,
+            24
+        );
+        assert!(compilation
+            .diagnostics
+            .iter()
+            .any(|diagnostic| diagnostic.code == "vfx.emitter_budget_exceeded"));
+    }
+
+    #[test]
+    fn every_template_is_an_ordinary_compilable_document() {
+        let service = VfxAuthoringService::new();
+        for template in [
+            VfxTemplate::Spark,
+            VfxTemplate::Smoke,
+            VfxTemplate::Burst,
+            VfxTemplate::Trail,
+        ] {
+            let effect = service.template(template);
+            assert_eq!(effect.schema_version, VFX_SCHEMA_VERSION);
+            assert!(service.compile(&effect).success);
+        }
+    }
+
+    #[test]
+    fn curve_and_gradient_commands_use_stable_key_ids_and_undo() {
+        let service = VfxAuthoringService::new();
+        let effect = service.template(VfxTemplate::Smoke);
+        let emitter = effect.emitters[0].id.clone();
+        let curve_module = effect.emitters[0]
+            .modules
+            .iter()
+            .find(|module| matches!(module.operation, VfxModuleOperation::SizeOverLife { .. }))
+            .expect("size module")
+            .id
+            .clone();
+        let gradient_module = effect.emitters[0]
+            .modules
+            .iter()
+            .find(|module| matches!(module.operation, VfxModuleOperation::ColorOverLife { .. }))
+            .expect("color module")
+            .id
+            .clone();
+        let curve_key = VfxCurveKey {
+            id: VfxCurveKeyId::generate(),
+            time: 0.5,
+            value: 1.5,
+            interpolation: VfxCurveInterpolation::Linear,
+        };
+        let gradient_key = VfxGradientKey {
+            id: VfxGradientKeyId::generate(),
+            time: 0.5,
+            color: [0.5, 0.5, 0.5, 0.3],
+        };
+        let applied = service.apply(
+            &effect,
+            &[
+                VfxCommand::InsertCurveKey {
+                    emitter: emitter.clone(),
+                    module: curve_module,
+                    key: curve_key,
+                    index: 1,
+                },
+                VfxCommand::InsertGradientKey {
+                    emitter,
+                    module: gradient_module,
+                    key: gradient_key,
+                    index: 1,
+                },
+            ],
+        );
+        assert!(applied.success);
+        let edited = applied.effect.expect("edited effect");
+        let undone = service.apply(&edited, &applied.undo_commands);
+        assert!(undone.success);
+        assert_eq!(undone.effect.as_ref(), Some(&effect));
+    }
+
+    #[test]
+    fn module_catalog_is_stable_and_phase_typed() {
+        let catalog = VfxAuthoringService::new().schemas();
+        assert_eq!(catalog.schema_version, VFX_SCHEMA_VERSION);
+        assert_eq!(catalog.modules[0].type_id, "engine.vfx.spawn_rate");
+        assert_eq!(catalog.modules[0].phase, VfxPhase::Spawn);
+        assert_eq!(catalog.modules.last().unwrap().type_id, "engine.vfx.mesh");
+        assert_eq!(catalog.modules.last().unwrap().phase, VfxPhase::Render);
+    }
+}

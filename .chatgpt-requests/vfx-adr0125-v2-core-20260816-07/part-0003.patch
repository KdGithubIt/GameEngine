+/// Reports why a VFX JSON document could not be parsed or serialized.
+#[derive(Debug)]
+pub enum VfxDocumentError {
+    /// JSON parsing or serialization failed.
+    Json(serde_json::Error),
+    /// The document uses a schema version unsupported by this build.
+    UnsupportedVersion {
+        /// Version found in the input document.
+        found: u32,
+    },
+    /// Semantic validation rejected the document.
+    Invalid {
+        /// Structured blocking diagnostics.
+        diagnostics: Vec<VfxDiagnostic>,
+    },
+}
+
+impl fmt::Display for VfxDocumentError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Json(error) => write!(formatter, "invalid VFX JSON: {error}"),
+            Self::UnsupportedVersion { found } => write!(
+                formatter,
+                "unsupported VFX schema version {found}; expected {VFX_SCHEMA_VERSION}"
+            ),
+            Self::Invalid { diagnostics } => write!(
+                formatter,
+                "VFX document has {} blocking diagnostic(s)",
+                diagnostics.len()
+            ),
+        }
+    }
+}
+
+impl std::error::Error for VfxDocumentError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Json(error) => Some(error),
+            Self::UnsupportedVersion { .. } | Self::Invalid { .. } => None,
+        }
+    }
+}

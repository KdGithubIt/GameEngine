+        let version: VersionProbe = serde_json::from_str(json).map_err(VfxDocumentError::Json)?;
+        if version.schema_version != VFX_SCHEMA_VERSION {
+            return Err(VfxDocumentError::UnsupportedVersion {
+                found: version.schema_version,
+            });
+        }
+        let effect: VfxEffect = serde_json::from_str(json).map_err(VfxDocumentError::Json)?;
+        let validation = self.validate(&effect);
+        if validation.success {
+            Ok(effect)
+        } else {
+            Err(VfxDocumentError::Invalid {
+                diagnostics: validation
+                    .diagnostics
+                    .into_iter()
+                    .filter(VfxDiagnostic::is_blocking)
+                    .collect(),
+            })
+        }
+    }

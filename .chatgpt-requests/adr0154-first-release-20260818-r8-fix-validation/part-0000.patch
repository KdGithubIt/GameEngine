+    pub(crate) fn current_motion_binding_diagnostics(&self) -> Vec<Diagnostic> {
+        self.preview
+            .as_ref()
+            .and_then(|preview| preview.bridge.as_ref())
+            .map(|bridge| {
+                bridge
+                    .asset_diagnostics
+                    .iter()
+                    .filter(|diagnostic| {
+                        diagnostic.code
+                            == engine::scene_bridge::ANIMATION_MOTION_BINDING_FAILED_DIAGNOSTIC
+                    })
+                    .cloned()
+                    .collect()
+            })
+            .unwrap_or_default()

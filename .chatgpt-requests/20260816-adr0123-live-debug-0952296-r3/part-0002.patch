+fn draw_debug_overlay(
+    painter: &egui::Painter,
+    rect: Rect,
+    presentation: &GraphDebugNodePresentation,
+) {
+    if presentation.active {
+        painter.rect_stroke(
+            rect.shrink(2.0),
+            4.0,
+            Stroke::new(3.0, Color32::from_rgb(93, 190, 244)),
+            StrokeKind::Inside,
+        );
+    }
+
+    if let Some(badge) = presentation.badge {
+        let (label, color) = match badge {
+            GraphDebugBadge::Running => ("RUN", Color32::from_rgb(238, 197, 97)),
+            GraphDebugBadge::Success => ("OK", Color32::from_rgb(105, 194, 126)),
+            GraphDebugBadge::Failure => ("FAIL", Color32::from_rgb(235, 104, 104)),
+            GraphDebugBadge::Entered => ("ENTER", Color32::from_rgb(93, 190, 244)),
+            GraphDebugBadge::Aborted => ("ABORT", Color32::from_rgb(235, 145, 92)),
+            GraphDebugBadge::Reset => ("RESET", Color32::from_rgb(175, 151, 218)),
+        };
+        let galley = painter.layout_no_wrap(
+            label.to_owned(),
+            FontId::monospace(9.0),
+            Color32::from_rgb(22, 24, 28),
+        );
+        let badge_rect = Rect::from_min_size(
+            rect.right_top() - EguiVec2::new(galley.size().x + 18.0, -5.0),
+            galley.size() + EguiVec2::new(12.0, 6.0),
+        );
+        painter.rect_filled(badge_rect, 3.0, color);
+        painter.galley(
+            badge_rect.center() - galley.size() * 0.5,
+            galley,
+            Color32::from_rgb(22, 24, 28),
+        );
+        if badge == GraphDebugBadge::Running {
+            painter.rect_stroke(
+                rect,
+                4.0,
+                Stroke::new(4.0, color),
+                StrokeKind::Inside,
+            );
+        }
+    }
+
+    if let Some(elapsed) = presentation.elapsed_seconds {
+        painter.text(
+            rect.right_bottom() - EguiVec2::new(8.0, 7.0),
+            Align2::RIGHT_BOTTOM,
+            format!("{elapsed:.2}s"),
+            FontId::monospace(9.0),
+            Color32::from_rgb(206, 215, 225),
+        );
+    }

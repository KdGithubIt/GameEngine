+    fn benchmark_campaign_verified_models(&self) -> Result<Vec<BenchmarkModelIdentity>, String> {
+        if self.model_backend != ModelBackendPreference::Local {
+            return Err("Automated benchmark campaigns currently require the local ModelBackend so exact installed representation identity can be verified.".to_owned());
+        }
+        let inventory = self
+            .current_installed_inventory()
+            .cloned()
+            .ok_or_else(|| "Discover installed local models before starting a campaign.".to_owned())?;
+        let mut models = Vec::new();
+        for installed in &inventory.models {
+            if !self.benchmark_campaign_models.contains(&installed.name) {
+                continue;
+            }
+            let config = NativeModelConfig::Local(LocalModelConfig {
+                endpoint: self.local_model_endpoint.clone(),
+                model: installed.name.clone(),
+            });
+            models.push(model_identity(
+                config.backend_id(),
+                &installed.name,
+                Some(&inventory),
+            ));
+        }
+        if models.len() != self.benchmark_campaign_models.len() {
+            return Err("One or more selected campaign models are no longer present in the current installed-model inventory.".to_owned());
+        }
+        Ok(models)
+    }
+
+    fn build_benchmark_campaign_draft(&self) -> Result<BenchmarkCampaign, String> {
+        let models = self.benchmark_campaign_verified_models()?;
+        if models.is_empty() {
+            return Err("Select at least one exact installed model for the campaign.".to_owned());
+        }
+        let tasks = BENCHMARK_TASKS
+            .iter()
+            .enumerate()
+            .filter(|(_, task)| self.benchmark_campaign_tasks.contains(task.id))
+            .map(|(index, task)| {
+                CampaignTaskPlan::for_task(task.id, 0x0156_0000_u64 + index as u64)
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        if tasks.is_empty() {
+            return Err("Select at least one versioned benchmark task.".to_owned());
+        }
+        BenchmarkCampaign::new(BenchmarkCampaignPlan {
+            schema_version: CAMPAIGN_SCHEMA_VERSION,
+            corpus_version: BENCHMARK_CORPUS_VERSION.to_owned(),
+            benchmark_harness_version: BENCHMARK_HARNESS_VERSION.to_owned(),
+            campaign_harness_version: CAMPAIGN_HARNESS_VERSION.to_owned(),
+            schedule_version: CAMPAIGN_SCHEDULE_VERSION.to_owned(),
+            candidates: models
+                .into_iter()
+                .map(|model| CampaignCandidate {
+                    model,
+                    source: CampaignCandidateSource::installed(),
+                })
+                .collect(),
+            tasks,
+            repetitions: self.benchmark_campaign_repetitions,
+            comparison_class: CampaignComparisonClass::ModelComparison,
+            execution_profile: self.benchmark_campaign_profile,
+            execution_environments: vec![CampaignExecutionEnvironment::CompatibleBackend],
+            quality: self.quality_preference,
+            hardware: self.benchmark_hardware.clone(),
+            workload_policy_version: WORKLOAD_POLICY_VERSION.to_owned(),
+            sampling_profile: "provider-default-uncontrolled".to_owned(),
+            seed_policy: CampaignSeedPolicy::ProviderUnavailable,
+        })
+    }
+
+    fn start_benchmark_campaign(&mut self) -> Result<(), String> {
+        let verified = self.benchmark_campaign_verified_models()?;
+        let mut campaign = self.build_benchmark_campaign_draft()?;
+        let preflight = campaign.preflight(&verified)?;
+        self.benchmark_campaign_preflight = Some(preflight.clone());
+        if !preflight.missing.is_empty() {
+            return Err("The frozen campaign contains missing representations. Review the exact Download & Run set before acquisition.".to_owned());
+        }
+        campaign.start(&verified)?;
+        self.benchmark_campaign_store.save(&campaign)?;
+        self.benchmark_campaign = Some(campaign);
+        Ok(())
+    }
+
+    fn persist_benchmark_campaign(&self) -> Result<(), String> {
+        if let Some(campaign) = self.benchmark_campaign.as_ref() {
+            self.benchmark_campaign_store.save(campaign)?;
+        }
+        Ok(())
+    }
+
+    fn resume_benchmark_campaign(&mut self) -> Result<(), String> {
+        let verified = self.benchmark_campaign_verified_models()?;
+        let current = self
+            .benchmark_campaign
+            .as_ref()
+            .ok_or_else(|| "No persisted campaign is selected.".to_owned())?
+            .resume_identity_for_environment(self.benchmark_hardware.clone(), &verified);
+        self.benchmark_campaign
+            .as_mut()
+            .ok_or_else(|| "No persisted campaign is selected.".to_owned())?
+            .resume(current)?;
+        self.persist_benchmark_campaign()
+    }

@@ -0,0 +1,89 @@
+//! VFX-specific deferred command constructors owned with [`crate::game_io::GameCommand`].
+
+use std::collections::BTreeMap;
+
+use engine_authoring::Value;
+
+use crate::game_api::Commands;
+use crate::game_io::{GameCommand, GameCommandFamily, GameEntityHandle};
+
+impl GameCommand {
+    /// Starts or resumes one scene VFX player without resetting transient state.
+    pub fn play_vfx(target: GameEntityHandle) -> Self {
+        vfx_command(target, "play")
+    }
+
+    /// Pauses one scene VFX player while preserving deterministic transient state.
+    pub fn pause_vfx(target: GameEntityHandle) -> Self {
+        vfx_command(target, "pause")
+    }
+
+    /// Stops one scene VFX player without resetting it.
+    ///
+    /// Stage 4 stop is intentionally the same non-destructive transition as
+    /// pause. Use [`Self::restart_vfx`] to rebuild deterministic state.
+    pub fn stop_vfx(target: GameEntityHandle) -> Self {
+        Self::pause_vfx(target)
+    }
+
+    /// Restarts one scene VFX player from time zero and resumes playback.
+    pub fn restart_vfx(target: GameEntityHandle) -> Self {
+        vfx_command(target, "restart")
+    }
+}
+
+fn vfx_command(target: GameEntityHandle, operation: &str) -> GameCommand {
+    GameCommand {
+        family: GameCommandFamily::Vfx,
+        request_id: None,
+        target: Some(target),
+        payload: Value::Object(BTreeMap::from([(
+            "operation".to_owned(),
+            Value::String(operation.to_owned()),
+        )])),
+    }
+}
+
+impl Commands {
+    /// Starts or resumes one scene VFX player at the next host boundary.
+    pub fn play_vfx(&mut self, target: GameEntityHandle) {
+        self.push(GameCommand::play_vfx(target));
+    }
+
+    /// Pauses one scene VFX player at the next host boundary.
+    pub fn pause_vfx(&mut self, target: GameEntityHandle) {
+        self.push(GameCommand::pause_vfx(target));
+    }
+
+    /// Stops one scene VFX player without discarding transient state.
+    pub fn stop_vfx(&mut self, target: GameEntityHandle) {
+        self.push(GameCommand::stop_vfx(target));
+    }
+
+    /// Restarts one scene VFX player from time zero at the next host boundary.
+    pub fn restart_vfx(&mut self, target: GameEntityHandle) {
+        self.push(GameCommand::restart_vfx(target));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn vfx_commands_use_the_deferred_vfx_family() {
+        let target = GameEntityHandle {
+            id: 7,
+            generation: 3,
+        };
+        for command in [
+            GameCommand::play_vfx(target),
+            GameCommand::pause_vfx(target),
+            GameCommand::restart_vfx(target),
+        ] {
+            assert_eq!(command.family, GameCommandFamily::Vfx);
+            assert_eq!(command.target, Some(target));
+        }
+        assert_eq!(GameCommand::stop_vfx(target), GameCommand::pause_vfx(target));
+    }
+}

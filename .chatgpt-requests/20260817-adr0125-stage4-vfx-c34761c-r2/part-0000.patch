+++ b/crates/engine/src/game_commands/vfx.rs
@@ -0,0 +1,58 @@
+//! Deferred Project Rust VFX command preparation and application.
+
+use crate::game_commands::{object, string_field, GameCommandError};
+use crate::game_io::GameEntityHandle;
+use crate::vfx::VfxPlayer;
+use engine_authoring::Value;
+use engine_ecs::{Entity, World};
+
+pub(super) enum PreparedVfxCommand {
+    Play { entity: Entity },
+    Pause { entity: Entity },
+    Restart { entity: Entity },
+}
+
+pub(super) fn prepare(
+    world: &World,
+    index: usize,
+    target: GameEntityHandle,
+    entity: Entity,
+    payload: &Value,
+) -> Result<PreparedVfxCommand, GameCommandError> {
+    if world.get_component::<VfxPlayer>(entity).is_none() {
+        return Err(GameCommandError::InvalidPayload {
+            index,
+            message: format!(
+                "VFX command target {}:{} does not have engine.vfx_player",
+                target.id, target.generation
+            ),
+        });
+    }
+    let fields = object(payload, index, "VFX payload")?;
+    match string_field(fields, "operation", index)? {
+        "play" => Ok(PreparedVfxCommand::Play { entity }),
+        "pause" => Ok(PreparedVfxCommand::Pause { entity }),
+        "restart" => Ok(PreparedVfxCommand::Restart { entity }),
+        other => Err(GameCommandError::InvalidPayload {
+            index,
+            message: format!("unknown VFX operation `{other}`"),
+        }),
+    }
+}
+
+pub(super) fn apply(world: &mut World, command: PreparedVfxCommand) {
+    match command {
+        PreparedVfxCommand::Play { entity } => world
+            .get_component_mut::<VfxPlayer>(entity)
+            .expect("preflighted VFX player must remain live during exclusive apply")
+            .play(),
+        PreparedVfxCommand::Pause { entity } => world
+            .get_component_mut::<VfxPlayer>(entity)
+            .expect("preflighted VFX player must remain live during exclusive apply")
+            .pause(),
+        PreparedVfxCommand::Restart { entity } => world
+            .get_component_mut::<VfxPlayer>(entity)
+            .expect("preflighted VFX player must remain live during exclusive apply")
+            .restart(),
+    }
+}

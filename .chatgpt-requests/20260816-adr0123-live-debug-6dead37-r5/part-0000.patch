+/// Runtime-only status shown over one Behavior Tree source node.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum GraphDebugBadge {
+    /// The node is the deepest currently running node.
+    Running,
+    /// The node most recently completed successfully.
+    Success,
+    /// The node most recently completed with failure.
+    Failure,
+    /// A long-running action was recently entered.
+    Entered,
+    /// Active work was recently aborted.
+    Aborted,
+    /// Runtime state was recently reset.
+    Reset,
+}
+
+/// Transient runtime presentation for one graph node.
+#[derive(Debug, Clone, PartialEq, Default)]
+pub(crate) struct GraphDebugNodePresentation {
+    /// Whether this node belongs to the runtime active path.
+    pub(crate) active: bool,
+    /// Most relevant current or recent runtime status.
+    pub(crate) badge: Option<GraphDebugBadge>,
+    /// Runtime-reported active duration for this node.
+    pub(crate) elapsed_seconds: Option<f64>,
+    /// Optional lifecycle detail shown on hover.
+    pub(crate) detail: Option<String>,
+}

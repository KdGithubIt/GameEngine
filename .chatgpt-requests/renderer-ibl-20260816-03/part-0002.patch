+    fn prepare_environment_map(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        source: &EnvironmentMap,
+    ) -> f32 {
+        let source_key = source.source_key();
+        if self
+            .environment_gpu
+            .as_ref()
+            .is_none_or(|cached| cached.source_key != source_key)
+        {
+            let precomputed = precompute_environment(source);
+            let diffuse = IblGpuTexture::from_rgba16f(
+                device,
+                queue,
+                &precomputed.diffuse_irradiance,
+                "IBL diffuse irradiance",
+            );
+            let specular = IblGpuTexture::from_rgba16f(
+                device,
+                queue,
+                &precomputed.specular_prefiltered,
+                "IBL GGX prefiltered environment",
+            );
+            self.render
+                .bind_environment_map(device, &diffuse.view, &specular.view);
+            self.environment_gpu = Some(CachedEnvironmentGpu {
+                source_key,
+                _diffuse: diffuse,
+                specular,
+            });
+        }
+
+        self.environment_gpu
+            .as_ref()
+            .map(|cached| cached.specular.mip_count.saturating_sub(1) as f32)
+            .unwrap_or(0.0)
+    }
 

+        assert_eq!(missing_gpu.len(), missing.vertices.len());
+        assert!(missing_gpu.iter().all(|entry| entry.tangent == [0.0; 4]));
+
+        let mut sourced = Mesh::triangle();
+        sourced.tangents = Some(vec![[1.0, 0.0, 0.0, -1.0]; sourced.vertices.len()]);

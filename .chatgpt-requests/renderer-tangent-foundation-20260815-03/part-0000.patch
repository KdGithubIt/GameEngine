+fn gpu_tangent_data(mesh: &Mesh) -> Vec<TangentVertexData> {
+    match &mesh.tangents {
+        Some(tangents) => tangents
+            .iter()
+            .copied()
+            .map(|tangent| TangentVertexData { tangent })
+            .collect(),
+        None => vec![
+            TangentVertexData {
+                tangent: [0.0; 4],
+            };
+            mesh.vertices.len()
+        ],
+    }

+        let request = campaign.begin_next_run().expect("next").expect("request");
+        assert!(campaign.begin_next_run().is_err());
+        campaign.mark_measurement_started(&request).expect("measure");
+        assert!(campaign.begin_next_run().is_err());
+    }

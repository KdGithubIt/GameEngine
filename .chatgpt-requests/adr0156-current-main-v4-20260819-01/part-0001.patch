+        let store = BenchmarkCampaignStore::open(root.path().to_path_buf())
+            .expect("campaign store");
+        let mut campaign = BenchmarkCampaign::new(plan()).expect("campaign");
+        store.save(&campaign).expect("initial save");
+        campaign

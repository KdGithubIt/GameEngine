+fn mesh_uses_normal_map(ir_mesh: &crate::model_ir::IrMesh, document: &ModelDocument) -> bool {
+    ir_mesh.submesh_materials.iter().flatten().any(|selector| {
+        document
+            .materials
+            .iter()
+            .find(|material| material.source_index == *selector)
+            .is_some_and(|material| material.normal_texture.is_some())
+    })
+}
+
+struct MikkGeometry<'a> {
+    mesh: &'a Mesh,
+    tangents: Vec<Option<[f32; 4]>>,
+    conflicted: bool,
+}
+
+impl MikkGeometry<'_> {
+    fn vertex_index(&self, face: usize, vert: usize) -> usize {
+        let corner = face * 3 + vert;
+        self.mesh
+            .indices
+            .as_ref()
+            .map_or(corner, |indices| indices[corner] as usize)
+    }
+}
+
+impl Geometry for MikkGeometry<'_> {
+    fn num_faces(&self) -> usize {
+        self.mesh
+            .indices
+            .as_ref()
+            .map_or(self.mesh.vertices.len(), Vec::len)
+            / 3
+    }
+
+    fn num_vertices_of_face(&self, _face: usize) -> usize {
+        3
+    }
+
+    fn position(&self, face: usize, vert: usize) -> [f32; 3] {
+        self.mesh.vertices[self.vertex_index(face, vert)].position
+    }
+
+    fn normal(&self, face: usize, vert: usize) -> [f32; 3] {
+        self.mesh.vertices[self.vertex_index(face, vert)].normal
+    }
+
+    fn tex_coord(&self, face: usize, vert: usize) -> [f32; 2] {
+        self.mesh.vertices[self.vertex_index(face, vert)].uv
+    }
+
+    fn set_tangent_encoded(&mut self, tangent: [f32; 4], face: usize, vert: usize) {
+        let index = self.vertex_index(face, vert);
+        let candidate = glam::Vec3::from_array([tangent[0], tangent[1], tangent[2]])
+            .normalize_or_zero();
+        if candidate == glam::Vec3::ZERO || !tangent[3].is_finite() {
+            self.conflicted = true;
+            return;
+        }
+        let encoded = [
+            candidate.x,
+            candidate.y,
+            candidate.z,
+            if tangent[3] < 0.0 { -1.0 } else { 1.0 },
+        ];
+        if let Some(previous) = self.tangents[index] {
+            let previous_direction =
+                glam::Vec3::from_array([previous[0], previous[1], previous[2]]);
+            if previous_direction.dot(candidate) < 0.99
+                || previous[3].is_sign_negative() != encoded[3].is_sign_negative()
+            {
+                // MikkTSpace returns per-face-corner results. If an existing
+                // index aliases corners that need different tangent frames,
+                // retaining that index would be incorrect. Keep the mesh
+                // topology intact and let the renderer's derivative fallback
+                // handle this mesh instead.
+                self.conflicted = true;
+            }
+        } else {
+            self.tangents[index] = Some(encoded);
+        }
+    }
+}
+
+fn generate_mikktspace_tangents(mesh: &Mesh) -> Option<Vec<[f32; 4]>> {
+    let corner_count = mesh.indices.as_ref().map_or(mesh.vertices.len(), Vec::len);
+    if corner_count == 0 || corner_count % 3 != 0 {
+        return None;
+    }
+
+    let mut geometry = MikkGeometry {
+        mesh,
+        tangents: vec![None; mesh.vertices.len()],
+        conflicted: false,
+    };
+    if !mikktspace::generate_tangents(&mut geometry) || geometry.conflicted {
+        return None;
+    }
+
+    Some(
+        geometry
+            .tangents
+            .into_iter()
+            .map(|tangent| tangent.unwrap_or([0.0; 4]))
+            .collect(),
+    )
+}

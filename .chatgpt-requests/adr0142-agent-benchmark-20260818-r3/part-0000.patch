+                                .context_limit
+                                .map(|limit| limit.to_string())
+                                .unwrap_or_else(|| "n/a".to_owned()),
+                            list_or_none(&recommendation.candidate.modalities),
+                            list_or_none(&recommendation.candidate.tool_capabilities),
+                        ));
+                    });

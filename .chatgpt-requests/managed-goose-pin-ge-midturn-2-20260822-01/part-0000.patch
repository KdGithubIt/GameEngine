+        assert_eq!(
+            extract_semver("goose 1.45.0+gameengine.ge-midturn-2"),
+            Some("1.45.0+gameengine.ge-midturn-2".to_owned())
+        );
+        assert_eq!(extract_semver("goose 1.45.0+"), None);
         assert_eq!(extract_semver("goose unknown"), None);
     }
 

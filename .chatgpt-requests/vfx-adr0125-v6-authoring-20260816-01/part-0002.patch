+impl VfxModule {
+    /// Creates an enabled module in the operation's required phase.
+    pub fn new(operation: VfxModuleOperation) -> Self {
+        Self {
+            id: VfxModuleId::generate(),
+            phase: operation.required_phase(),
+            enabled: true,
+            operation,
+        }
+    }
+}

+/// Granular semantic edit applied transactionally to one VFX document.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "command", rename_all = "snake_case")]
+pub enum VfxCommand {
+    /// Renames the effect.
+    SetEffectName {
+        /// New human-readable name.
+        name: String,
+    },
+    /// Changes the effect's deterministic base seed.
+    SetEffectSeed {
+        /// New deterministic seed.
+        seed: u32,
+    },
+    /// Changes the effect-wide live-particle cap.
+    SetEffectMaxParticles {
+        /// New positive live-particle cap.
+        max_particles: u32,
+    },
+    /// Inserts an emitter at a deterministic document position.
+    AddEmitter {
+        /// Emitter to insert, including its stable ID.
+        emitter: VfxEmitter,
+        /// Zero-based insertion position.
+        index: usize,
+    },
+    /// Removes one emitter by stable ID.
+    RemoveEmitter {
+        /// Emitter to remove.
+        emitter: VfxEmitterId,
+    },
+    /// Moves one emitter to a new zero-based position.
+    MoveEmitter {
+        /// Emitter to move.
+        emitter: VfxEmitterId,
+        /// Destination position after removing the emitter from its old position.
+        index: usize,
+    },
+    /// Renames one emitter.
+    RenameEmitter {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// New human-readable name.
+        name: String,
+    },
+    /// Enables or disables one emitter without changing its stable identity.
+    SetEmitterEnabled {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// New enabled state.
+        enabled: bool,
+    },
+    /// Changes one emitter's hard live-particle cap.
+    SetEmitterMaxParticles {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// New positive live-particle cap.
+        max_particles: u32,
+    },
+    /// Inserts a module at a deterministic position in one emitter's stack.
+    AddModule {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// Module to insert, including its stable ID.
+        module: VfxModule,
+        /// Zero-based insertion position in the complete module stack.
+        index: usize,
+    },
+    /// Removes one module by stable ID.
+    RemoveModule {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// Module to remove.
+        module: VfxModuleId,
+    },
+    /// Moves one module inside its existing execution phase.
+    MoveModule {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// Module to move.
+        module: VfxModuleId,
+        /// Destination position among modules in the same phase.
+        phase_index: usize,
+    },
+    /// Enables or disables one module.
+    SetModuleEnabled {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// Target module.
+        module: VfxModuleId,
+        /// New enabled state.
+        enabled: bool,
+    },
+    /// Replaces one module's properties without changing its stable ID or phase.
+    ReplaceModuleOperation {
+        /// Target emitter.
+        emitter: VfxEmitterId,
+        /// Target module.
+        module: VfxModuleId,
+        /// Replacement typed operation. It must belong to the module's current phase.
+        operation: VfxModuleOperation,
+    },
+}

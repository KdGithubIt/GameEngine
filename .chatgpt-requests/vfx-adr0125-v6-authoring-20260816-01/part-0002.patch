+/// Severity attached to a structured VFX diagnostic.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum VfxDiagnosticSeverity {
+    /// Non-blocking authoring or performance warning.
+    Warning,
+    /// Blocking validation or compilation error.
+    Error,
+}
+
+/// Structured VFX diagnostic retaining stable source identities.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct VfxDiagnostic {
+    /// Stable machine-readable diagnostic code.
+    pub code: String,
+    /// Diagnostic severity.
+    pub severity: VfxDiagnosticSeverity,
+    /// Human-readable diagnostic message.
+    pub message: String,
+    /// Emitter associated with the diagnostic, when applicable.
+    pub emitter: Option<VfxEmitterId>,
+    /// Module associated with the diagnostic, when applicable.
+    pub module: Option<VfxModuleId>,
+}
+
+impl VfxDiagnostic {
+    /// Returns `true` when this diagnostic blocks compilation or commit.
+    pub fn is_blocking(&self) -> bool {
+        self.severity == VfxDiagnosticSeverity::Error
+    }
+
+    fn error(
+        code: &'static str,
+        message: impl Into<String>,
+        emitter: Option<&VfxEmitterId>,
+        module: Option<&VfxModuleId>,
+    ) -> Self {
+        Self {
+            code: code.to_owned(),
+            severity: VfxDiagnosticSeverity::Error,
+            message: message.into(),
+            emitter: emitter.cloned(),
+            module: module.cloned(),
+        }
+    }
+
+    fn warning(
+        code: &'static str,
+        message: impl Into<String>,
+        emitter: Option<&VfxEmitterId>,
+        module: Option<&VfxModuleId>,
+    ) -> Self {
+        Self {
+            code: code.to_owned(),
+            severity: VfxDiagnosticSeverity::Warning,
+            message: message.into(),
+            emitter: emitter.cloned(),
+            module: module.cloned(),
+        }
+    }
+}

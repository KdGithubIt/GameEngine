+fn active_level_count(radius: f32, available: usize) -> usize {
+    let available = available.max(1);
+    let radius = finite_or(radius, 0.0).max(0.0);
+    let mut count = 1usize;
+    let mut covered_radius = 1.0f32;
+    while count < available && covered_radius < radius {
+        covered_radius *= 2.0;
+        count += 1;
+    }
+    count
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::postprocess::BloomSettings;
+
+    #[test]
+    fn bloom_level_extents_half_resolution_and_stop_at_budget() {
+        assert_eq!(
+            bloom_level_extents([1920, 1080]),
+            vec![[960, 540], [480, 270], [240, 135], [120, 68], [60, 34]]
+        );
+        assert_eq!(bloom_level_extents([1, 1]), vec![[1, 1]]);
+    }
+
+    #[test]
+    fn bloom_radius_selects_progressively_deeper_pyramid_levels() {
+        assert_eq!(active_level_count(0.0, 5), 1);
+        assert_eq!(active_level_count(1.0, 5), 1);
+        assert_eq!(active_level_count(2.0, 5), 2);
+        assert_eq!(active_level_count(4.0, 5), 3);
+        assert_eq!(active_level_count(8.0, 5), 4);
+        assert_eq!(active_level_count(16.0, 5), 5);
+        assert_eq!(active_level_count(64.0, 3), 3);
+    }
+
+    #[test]
+    fn multi_resolution_bloom_pipeline_validates_when_a_gpu_adapter_is_available() {
+        let instance = wgpu::Instance::default();
+        let context = match pollster::block_on(engine_renderer::GpuContext::new(&instance, None)) {
+            Ok(context) => context,
+            Err(engine_renderer::GpuContextError::AdapterUnavailable) => return,
+            Err(error) => panic!("GPU device creation failed: {error}"),
+        };
+        let texture = context.device().create_texture(&wgpu::TextureDescriptor {
+            label: Some("Bloom validation HDR source"),
+            size: wgpu::Extent3d {
+                width: 64,
+                height: 32,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: BLOOM_FORMAT,
+            usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        });
+        let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+        let bloom = pollster::block_on(BloomPass::new(context.device(), &view))
+            .expect("multi-resolution bloom pipelines must validate");
+        let settings = PostProcessSettings {
+            bloom: BloomSettings {
+                enabled: true,
+                threshold: 1.0,
+                intensity: 0.2,
+                radius: 8.0,
+            },
+            ..PostProcessSettings::default()
+        };
+
+        context
+            .device()
+            .push_error_scope(wgpu::ErrorFilter::Validation);
+        bloom.execute(context.device(), context.queue(), &settings);
+        let error = pollster::block_on(context.device().pop_error_scope());
+        assert!(error.is_none(), "bloom execution validation failed: {error:?}");
+    }
+}

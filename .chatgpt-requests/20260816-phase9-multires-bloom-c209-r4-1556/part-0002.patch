+// Multi-resolution bloom preprocessing in linear HDR space (ADR 0131).
+
+struct BloomUniforms {
+    threshold: f32,
+    intensity: f32,
+    radius: f32,
+    enabled: u32,
+}
+
+@group(0) @binding(0) var source_a: texture_2d<f32>;
+@group(0) @binding(1) var source_b: texture_2d<f32>;
+@group(0) @binding(2) var bloom_sampler: sampler;
+@group(0) @binding(3) var<uniform> bloom: BloomUniforms;
+
+struct VertexOutput {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+
+@vertex
+fn vs_main(@builtin(vertex_index) index: u32) -> VertexOutput {
+    var positions = array<vec2<f32>, 3>(
+        vec2<f32>(-1.0, -3.0),
+        vec2<f32>(-1.0, 1.0),
+        vec2<f32>(3.0, 1.0),
+    );
+    var uvs = array<vec2<f32>, 3>(
+        vec2<f32>(0.0, 2.0),
+        vec2<f32>(0.0, 0.0),
+        vec2<f32>(2.0, 0.0),
+    );
+    var output: VertexOutput;

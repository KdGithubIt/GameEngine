+    let b = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(0.0, -2.0)).rgb;
+    let c = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(2.0, -2.0)).rgb;
+    let d = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(-2.0, 0.0)).rgb;
+    let e = textureSample(source_a, bloom_sampler, uv).rgb;
+    let f = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(2.0, 0.0)).rgb;
+    let g = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(-2.0, 2.0)).rgb;
+    let h = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(0.0, 2.0)).rgb;
+    let i = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(2.0, 2.0)).rgb;
+    let j = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(-1.0, -1.0)).rgb;
+    let k = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(1.0, -1.0)).rgb;
+    let l = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(-1.0, 1.0)).rgb;
+    let m = textureSample(source_a, bloom_sampler, uv + texel * vec2<f32>(1.0, 1.0)).rgb;
+
+    return e * 0.125

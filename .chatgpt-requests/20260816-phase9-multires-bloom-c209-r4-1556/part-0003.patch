+        + (b + d + f + h) * 0.0625
+        + (j + k + l + m) * 0.125;
+}
+
+fn upsample_tent(uv: vec2<f32>) -> vec3<f32> {
+    let dimensions = vec2<f32>(textureDimensions(source_b));
+    let texel = vec2<f32>(1.0) / dimensions;
+    let spread = clamp(0.5 + max(bloom.radius, 0.0) * 0.125, 0.5, 2.0);
+    let offset = texel * spread;
+    var color = textureSample(source_b, bloom_sampler, uv).rgb * 4.0;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(-1.0, 0.0)).rgb * 2.0;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(1.0, 0.0)).rgb * 2.0;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(0.0, -1.0)).rgb * 2.0;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(0.0, 1.0)).rgb * 2.0;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(-1.0, -1.0)).rgb;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(1.0, -1.0)).rgb;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(-1.0, 1.0)).rgb;
+    color += textureSample(source_b, bloom_sampler, uv + offset * vec2<f32>(1.0, 1.0)).rgb;
+    return color / 16.0;
+}
+
+@fragment
+fn fs_downsample_extract(input: VertexOutput) -> @location(0) vec4<f32> {
+    let color = max(downsample_13_tap(input.uv), vec3<f32>(0.0));
+    let value = luminance(color);
+    let contribution = max(value - bloom.threshold, 0.0) / max(value, 0.0001);
+    return vec4<f32>(color * contribution, 1.0);
+}
+
+@fragment
+fn fs_downsample(input: VertexOutput) -> @location(0) vec4<f32> {
+    return vec4<f32>(max(downsample_13_tap(input.uv), vec3<f32>(0.0)), 1.0);
+}
+
+@fragment
+fn fs_upsample(input: VertexOutput) -> @location(0) vec4<f32> {
+    let base = textureSample(source_a, bloom_sampler, input.uv).rgb;
+    let wider = upsample_tent(input.uv);
+    return vec4<f32>(max(base + wider * 0.5, vec3<f32>(0.0)), 1.0);
+}
+
+@fragment
+fn fs_composite(input: VertexOutput) -> @location(0) vec4<f32> {
+    let dimensions = vec2<i32>(textureDimensions(source_a));
+    let pixel = clamp(
+        vec2<i32>(input.position.xy),
+        vec2<i32>(0),
+        dimensions - vec2<i32>(1),
+    );
+    let scene = textureLoad(source_a, pixel, 0).rgb;
+    if bloom.enabled == 0u {
+        return vec4<f32>(scene, 1.0);
+    }
+    let glow = textureSample(source_b, bloom_sampler, input.uv).rgb;
+    return vec4<f32>(scene + glow * bloom.intensity, 1.0);
+}

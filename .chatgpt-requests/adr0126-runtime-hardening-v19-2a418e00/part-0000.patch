+                .diagnostics
+                .into_iter()
+                .map(|diagnostic| format!("[{}] {}", diagnostic.code, diagnostic.message))
+                .collect(),
+        )
+    })?;
+    Ok(PreparedTimeline {
+        asset,
+        document_id: document.id.clone(),
+        schedule,
+    })

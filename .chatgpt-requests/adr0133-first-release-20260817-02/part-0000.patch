+pub(crate) fn session_snapshot(
+    project_id: &str,
+    host: &AgentHost,
+    session_id: Option<&str>,
+    pending_permission: Option<(&str, AgentCapability)>,
+    project_root: &Path,
+) -> Result<Value, AgentHostError> {
+    let selected = match session_id {
+        Some(id) => host.session(id)?,
+        None => host
+            .session_ids()
+            .last()
+            .map(String::as_str)
+            .map(|id| host.session(id))
+            .transpose()?
+            .ok_or_else(|| AgentHostError::SessionNotFound("remote snapshot".to_owned()))?,
+    };
+    let active_run = host.active_writer_run_id().and_then(|id| host.run(id).ok());
+    Ok(json!({
+        "project_id": project_id,
+        "session": sanitize_session(selected, project_root),
+        "active_run": active_run.map(|run| sanitize_run(run, project_root)),
+        "pending_permission": pending_permission.map(|(run_id, capability)| json!({
+            "run_id": run_id,
+            "capability": serde_json::to_value(capability).unwrap_or(Value::Null),
+            "label": capability.label(),
+            "scopes": ["once", "run", "project", "deny"]
+        })),
+        "awaiting_user": active_run.filter(|run| run.state == AgentRunState::AwaitingUser).map(|run| json!({
+            "run_id": run.id,
+            "message": "The agent is waiting for a user response. Review the latest event for context."
+        }))
+    }))
+}
+
+pub(crate) fn active_run_snapshot(host: &AgentHost, project_root: &Path) -> Value {
+    host.active_writer_run_id()
+        .and_then(|id| host.run(id).ok())
+        .map(|run| sanitize_run(run, project_root))
+        .unwrap_or(Value::Null)
+}
+
+pub(crate) fn event_batch(host: &AgentHost, run_id: &str, after: u64, project_root: &Path) -> Result<Value, AgentHostError> {
+    let run = host.run(run_id)?;
+    let oldest = run.events.first().map_or(0, |event| event.sequence);
+    let latest = run.events.last().map_or(0, |event| event.sequence);
+    let stale = after != 0 && oldest != 0 && after.saturating_add(1) < oldest;
+    let events = run.events.iter().filter(|event| stale || event.sequence > after)
+        .map(|event| sanitize_event(event, project_root)).collect::<Vec<_>>();
+    Ok(json!({"run_id":run_id,"after":after,"oldest_cursor":oldest,"latest_cursor":latest,"stale_cursor":stale,"events":events}))
+}
+
+pub(crate) fn load_frame(
+    host: &AgentHost,
+    session_id: &str,
+    run_id: &str,
+    artifact_id: &str,
+) -> Result<Vec<u8>, AgentHostError> {
+    let session = host.session(session_id)?;
+    let run = session.runs.iter().find(|run| run.id == run_id)
+        .ok_or_else(|| AgentHostError::RunNotFound(run_id.to_owned()))?;
+    let belongs = run.events.iter().any(|event| matches!(
+        &event.evidence,
+        Some(AgentEventEvidence::CapturedFrame { artifact_id: id, .. }) if id == artifact_id
+    ));
+    if !belongs {
+        return Err(AgentHostError::RunNotFound(run_id.to_owned()));
+    }
+    fs::read(host.captured_frame_artifact_path(run_id, artifact_id)?).map_err(Into::into)
+}
+
+pub(crate) fn host_error(error: &AgentHostError) -> RemoteResponse {
+    match error {
+        AgentHostError::SessionNotFound(_) => RemoteResponse::error(404, "session_not_found", "AI Studio session was not found", false),
+        AgentHostError::RunNotFound(_) => RemoteResponse::error(404, "run_not_found", "AI Studio run was not found", false),
+        AgentHostError::ActiveWriterRun(_) => RemoteResponse::error(409, "run_active", "another AI Studio writer run is already active", true),
+        AgentHostError::StaleProposalVersion { .. } => RemoteResponse::error(409, "stale_proposal", "the authorized proposal version is stale", false),
+        AgentHostError::InvalidTransition { .. } => RemoteResponse::error(409, "invalid_run_state", "the run is not in a state that accepts this action", false),
+        AgentHostError::CompletionPending => RemoteResponse::error(409, "completion_pending", "required completion evidence is still unresolved", false),
+        _ => RemoteResponse::error(500, "host_error", "AI Studio could not complete the operation; see host diagnostics", false),
+    }
+}
+
+fn sanitize_session(session: &AgentSession, project_root: &Path) -> Value {
+    json!({
+        "id": session.id,
+        "title": sanitize_text(&session.title, project_root),
+        "messages": session.messages.iter().map(|message| json!({
+            "role": message.role,
+            "text": sanitize_text(&message.text, project_root),
+            "created_unix_ms": message.created_unix_ms
+        })).collect::<Vec<_>>(),
+        "proposal": sanitize_serialized(&session.proposal, project_root),
+        "proposal_history": sanitize_serialized(&session.proposal_history, project_root),
+        "shared_with_project": session.shared_with_project
+    })
+}
+
+fn sanitize_run(run: &crate::agent_host::AgentRun, project_root: &Path) -> Value {
+    let frames = run.events.iter().filter_map(|event| match &event.evidence {
+        Some(AgentEventEvidence::CapturedFrame { artifact_id, width, height }) => Some(json!({
+            "artifact_id": artifact_id,
+            "width": width,
+            "height": height,
+            "event_cursor": event.sequence
+        })),
+        _ => None,
+    }).collect::<Vec<_>>();
+    json!({
+        "id": run.id,
+        "proposal": sanitize_serialized(&run.proposal_snapshot, project_root),
+        "state": run.state,
+        "completion": sanitize_serialized(&run.completion, project_root),
+        "validation_attempts": sanitize_serialized(&run.validation_attempts, project_root),
+        "audit": sanitize_serialized(&run.audit, project_root),
+        "started_unix_ms": run.started_unix_ms,
+        "finished_unix_ms": run.finished_unix_ms,
+        "oldest_event_cursor": run.events.first().map_or(0, |event| event.sequence),
+        "latest_event_cursor": run.events.last().map_or(0, |event| event.sequence),
+        "frames": frames,
+        "events": run.events.iter().rev().take(80).rev().map(|event| sanitize_event(event, project_root)).collect::<Vec<_>>()
+    })
+}
+
+fn sanitize_event(event: &AgentEvent, project_root: &Path) -> Value {
+    let evidence = match &event.evidence {
+        Some(AgentEventEvidence::Progress { step, detail }) => json!({"evidence":"progress","step":sanitize_text(step, project_root),"detail":sanitize_text(detail, project_root)}),
+        Some(AgentEventEvidence::ToolAction { tool, success, .. }) => json!({"evidence":"tool_action","tool":tool,"success":success}),
+        Some(AgentEventEvidence::Playtest { launched, interactions_passed }) => json!({"evidence":"playtest","launched":launched,"interactions_passed":interactions_passed}),
+        Some(AgentEventEvidence::CapturedFrame { artifact_id, width, height }) => json!({"evidence":"captured_frame","artifact_id":artifact_id,"width":width,"height":height}),
+        Some(AgentEventEvidence::CompletionGate { gate, status }) => json!({"evidence":"completion_gate","gate":gate,"status":status}),
+        None => Value::Null,
+    };
+    let message = if event.kind == AgentEventKind::ProviderOutput {
+        "Provider diagnostic output is available only on the host.".to_owned()
+    } else {
+        sanitize_text(&event.message, project_root)
+    };
+    json!({"cursor":event.sequence,"created_unix_ms":event.created_unix_ms,"kind":event.kind,"message":message,"validation":event.validation,"evidence":evidence})
+}
+
+fn sanitize_serialized<T: serde::Serialize>(value: &T, project_root: &Path) -> Value {
+    sanitize_json(serde_json::to_value(value).unwrap_or(Value::Null), project_root)
+}
+
+fn sanitize_json(value: Value, project_root: &Path) -> Value {
+    match value {
+        Value::String(text) => Value::String(sanitize_text(&text, project_root)),
+        Value::Array(values) => Value::Array(values.into_iter().map(|value| sanitize_json(value, project_root)).collect()),
+        Value::Object(values) => Value::Object(values.into_iter().map(|(key, value)| (key, sanitize_json(value, project_root))).collect()),
+        other => other,
+    }
+}
+
+fn sanitize_text(text: &str, project_root: &Path) -> String {
+    let lower = text.to_ascii_lowercase();
+    if ["gameengine_mcp_auth_token", "authorization: bearer", "openai_api_key", "anthropic_api_key", "tailscale_auth", "gameengine_mcp_endpoint"]
+        .iter().any(|marker| lower.contains(marker))
+    {
+        return "[sensitive host detail omitted]".to_owned();
+    }
+    let mut sanitized = text.to_owned();
+    let path = project_root.display().to_string();
+    if !path.is_empty() {
+        sanitized = sanitized.replace(&path, "[project]");
+        sanitized = sanitized.replace(&path.replace('\\', "/"), "[project]");
+    }
+    sanitized
+}

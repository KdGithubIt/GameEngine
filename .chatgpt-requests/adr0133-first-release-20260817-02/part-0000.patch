+</style></head><body><main><header class="card"><h1>Remote AI Studio</h1><div id="connection" class="muted">Connecting to the authoritative project Agent Host…</div></header><div class="grid"><section class="card"><h2>Conversation</h2><div id="messages" class="messages"></div><textarea id="message" rows="3" style="width:100%" placeholder="Continue the same AI Studio conversation"></textarea><button class="primary" onclick="sendMessage()">Send</button></section><section class="card"><h2>Proposal</h2><div id="proposal"></div><h3>Acceptance criteria</h3><div id="criteria"></div><div class="row"><button class="primary" onclick="go()">Go exact proposal</button><button class="danger" onclick="stopRun()">Stop</button></div></section></div><div class="grid"><section class="card"><h2>Pending decision</h2><div id="decision" class="muted">None</div></section><section class="card"><h2>Run / completion</h2><div id="run"></div><div id="completion"></div></section></div><section class="card"><h2>Validation / playtest / repair progress</h2><div id="events" class="events"></div></section><section class="card"><h2>Captured frame / visual evaluation</h2><div id="frame"></div></section></main><script>

@@ -0,0 +1,799 @@
+//! Loopback-only Remote AI Studio application gateway.
+//!
+//! The gateway is a transport frontend over the existing [`AgentHost`]. It owns
+//! HTTP framing, idempotency, reconnect cursors, sanitization, and the responsive
+//! web companion. All mutations are dispatched back to the Editor thread so the
+//! local AI Studio and remote companion use the same authoritative host.
+
+use crate::agent_host::{
+    AgentCapability, AgentEvent, AgentEventEvidence, AgentEventKind, AgentHost, AgentHostError,
+    AgentRunState, AgentSession, ApprovalScope,
+};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, VecDeque};
+use std::fs;
+use std::io::{self, Read, Write};
+use std::net::{Ipv4Addr, SocketAddr, TcpListener, TcpStream};
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+
+const MAX_REQUEST_BYTES: usize = 64 * 1024;
+const IO_TIMEOUT: Duration = Duration::from_secs(5);
+const HOST_TIMEOUT: Duration = Duration::from_secs(30);
+const IDEMPOTENCY_TTL: Duration = Duration::from_secs(10 * 60);
+const MAX_IDEMPOTENCY_ENTRIES: usize = 512;
+
+/// One application operation sent from the loopback gateway to AI Studio.
+pub(crate) enum RemoteCommand {
+    SessionSnapshot { session_id: Option<String> },
+    ActiveRunSnapshot,
+    ConversationMessage { session_id: String, text: String },
+    Go { session_id: String, proposal_version: u64 },
+    Stop { run_id: String },
+    AwaitingUserResponse { session_id: String, run_id: String, text: String },
+    PermissionResponse {
+        run_id: String,
+        capability: AgentCapability,
+        scope: ApprovalScope,
+    },
+    Events { run_id: String, after: u64 },
+    CapturedFrame {
+        project_id: String,
+        session_id: String,
+        run_id: String,
+        artifact_id: String,
+    },
+}
+
+/// One request waiting for the authoritative Editor-owned host.
+pub(crate) struct RemoteGatewayRequest {
+    pub(crate) command: RemoteCommand,
+    response: mpsc::SyncSender<RemoteResponse>,
+}
+
+impl RemoteGatewayRequest {
+    pub(crate) fn respond(self, response: RemoteResponse) {
+        let _ = self.response.send(response);
+    }
+}
+
+/// Sanitized HTTP response returned by the application operation layer.
+#[derive(Clone)]
+pub(crate) struct RemoteResponse {
+    status: u16,
+    content_type: &'static str,
+    body: Vec<u8>,
+}
+
+impl RemoteResponse {
+    pub(crate) fn json(status: u16, value: Value) -> Self {
+        Self {
+            status,
+            content_type: "application/json; charset=utf-8",
+            body: serde_json::to_vec(&value).unwrap_or_else(|_| b"{}".to_vec()),
+        }
+    }
+
+    pub(crate) fn error(status: u16, category: &str, message: &str, retryable: bool) -> Self {
+        Self::json(
+            status,
+            json!({"error":{"category":category,"message":message,"retryable":retryable}}),
+        )
+    }
+
+    pub(crate) fn png(bytes: Vec<u8>) -> Self {
+        Self { status: 200, content_type: "image/png", body: bytes }
+    }
+}
+
+/// Running loopback-only HTTP gateway for one Editor project.
+pub(crate) struct RemoteAiStudioGateway {
+    local_addr: SocketAddr,
+    shutdown: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+}
+
+impl RemoteAiStudioGateway {
+    pub(crate) fn start() -> Result<(Self, mpsc::Receiver<RemoteGatewayRequest>), io::Error> {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0))?;
+        listener.set_nonblocking(true)?;
+        let local_addr = listener.local_addr()?;
+        let shutdown = Arc::new(AtomicBool::new(false));
+        let worker_shutdown = Arc::clone(&shutdown);
+        let ledger = Arc::new(Mutex::new(IdempotencyLedger::default()));
+        let (sender, receiver) = mpsc::channel();
+        let worker = thread::Builder::new()
+            .name("gameengine-remote-ai-studio".into())
+            .spawn(move || serve_loop(listener, sender, ledger, worker_shutdown))?;
+        Ok((Self { local_addr, shutdown, worker: Some(worker) }, receiver))
+    }
+
+    pub(crate) fn url(&self) -> String {
+        format!("http://{}/", self.local_addr)
+    }
+
+    #[cfg(test)]
+    fn local_addr(&self) -> SocketAddr {
+        self.local_addr
+    }
+}
+
+impl Drop for RemoteAiStudioGateway {
+    fn drop(&mut self) {
+        self.shutdown.store(true, Ordering::Release);
+        let _ = TcpStream::connect_timeout(&self.local_addr, Duration::from_millis(100));
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
+
+#[derive(Clone)]
+struct IdempotencyEntry {
+    fingerprint: String,
+    response: RemoteResponse,
+    created: Instant,
+}
+
+#[derive(Default)]
+struct IdempotencyLedger {
+    entries: BTreeMap<String, IdempotencyEntry>,
+    order: VecDeque<String>,
+}
+
+impl IdempotencyLedger {
+    fn replay(&mut self, request_id: &str, fingerprint: &str) -> Option<RemoteResponse> {
+        self.prune();
+        self.entries.get(request_id).map(|entry| {
+            if entry.fingerprint == fingerprint {
+                entry.response.clone()
+            } else {
+                RemoteResponse::error(
+                    409,
+                    "idempotency_conflict",
+                    "request identity was already used for a different mutation",
+                    false,
+                )
+            }
+        })
+    }
+
+    fn remember(&mut self, request_id: String, fingerprint: String, response: RemoteResponse) {
+        self.prune();
+        self.entries.insert(
+            request_id.clone(),
+            IdempotencyEntry { fingerprint, response, created: Instant::now() },
+        );
+        self.order.push_back(request_id);
+        while self.order.len() > MAX_IDEMPOTENCY_ENTRIES {
+            if let Some(oldest) = self.order.pop_front() {
+                self.entries.remove(&oldest);
+            }
+        }
+    }
+
+    fn prune(&mut self) {
+        let now = Instant::now();
+        while self.order.front().is_some_and(|id| {
+            self.entries
+                .get(id)
+                .is_none_or(|entry| now.duration_since(entry.created) >= IDEMPOTENCY_TTL)
+        }) {
+            if let Some(id) = self.order.pop_front() {
+                self.entries.remove(&id);
+            }
+        }
+    }
+}
+
+fn serve_loop(
+    listener: TcpListener,
+    sender: mpsc::Sender<RemoteGatewayRequest>,
+    ledger: Arc<Mutex<IdempotencyLedger>>,
+    shutdown: Arc<AtomicBool>,
+) {
+    while !shutdown.load(Ordering::Acquire) {
+        match listener.accept() {
+            Ok((stream, peer)) => {
+                if shutdown.load(Ordering::Acquire) {
+                    break;
+                }
+                if !peer.ip().is_loopback() {
+                    continue;
+                }
+                let sender = sender.clone();
+                let ledger = Arc::clone(&ledger);
+                let _ = thread::Builder::new()
+                    .name("gameengine-remote-ai-studio-request".into())
+                    .spawn(move || {
+                        let _ = handle_connection(stream, &sender, &ledger);
+                    });
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                thread::sleep(Duration::from_millis(10));
+            }
+            Err(_) => break,
+        }
+    }
+}
+
+fn handle_connection(
+    mut stream: TcpStream,
+    sender: &mpsc::Sender<RemoteGatewayRequest>,
+    ledger: &Arc<Mutex<IdempotencyLedger>>,
+) -> io::Result<()> {
+    stream.set_read_timeout(Some(IO_TIMEOUT))?;
+    stream.set_write_timeout(Some(IO_TIMEOUT))?;
+    let request = match read_request(&mut stream) {
+        Ok(request) => request,
+        Err(ReadError::TooLarge) => return write_response(&mut stream, RemoteResponse::error(413, "request_too_large", "request is too large", false)),
+        Err(ReadError::BadRequest) => return write_response(&mut stream, RemoteResponse::error(400, "bad_request", "request could not be parsed", false)),
+        Err(ReadError::Io(error)) => return Err(error),
+    };
+    let response = route_request(request, sender, ledger);
+    write_response(&mut stream, response)
+}
+
+struct HttpRequest {
+    method: String,
+    path: String,
+    body: Vec<u8>,
+}
+
+enum ReadError {
+    TooLarge,
+    BadRequest,
+    Io(io::Error),
+}
+
+fn read_request(stream: &mut TcpStream) -> Result<HttpRequest, ReadError> {
+    let mut bytes = Vec::new();
+    let mut chunk = [0_u8; 4096];
+    let header_end;
+    loop {
+        let read = stream.read(&mut chunk).map_err(ReadError::Io)?;
+        if read == 0 {
+            return Err(ReadError::BadRequest);
+        }
+        bytes.extend_from_slice(&chunk[..read]);
+        if bytes.len() > MAX_REQUEST_BYTES {
+            return Err(ReadError::TooLarge);
+        }
+        if let Some(index) = find_bytes(&bytes, b"\r\n\r\n") {
+            header_end = index + 4;
+            break;
+        }
+    }
+    let header = std::str::from_utf8(&bytes[..header_end]).map_err(|_| ReadError::BadRequest)?;
+    let mut lines = header.split("\r\n");
+    let mut request_line = lines.next().ok_or(ReadError::BadRequest)?.split_whitespace();
+    let method = request_line.next().ok_or(ReadError::BadRequest)?.to_owned();
+    let path = request_line.next().ok_or(ReadError::BadRequest)?.to_owned();
+    let mut content_length = 0_usize;
+    for line in lines {
+        let Some((name, value)) = line.split_once(':') else { continue; };
+        if name.eq_ignore_ascii_case("content-length") {
+            content_length = value.trim().parse().map_err(|_| ReadError::BadRequest)?;
+        }
+    }
+    if header_end + content_length > MAX_REQUEST_BYTES {
+        return Err(ReadError::TooLarge);
+    }
+    while bytes.len() < header_end + content_length {
+        let read = stream.read(&mut chunk).map_err(ReadError::Io)?;
+        if read == 0 {
+            return Err(ReadError::BadRequest);
+        }
+        bytes.extend_from_slice(&chunk[..read]);
+        if bytes.len() > MAX_REQUEST_BYTES {
+            return Err(ReadError::TooLarge);
+        }
+    }
+    Ok(HttpRequest {
+        method,
+        path,
+        body: bytes[header_end..header_end + content_length].to_vec(),
+    })
+}
+
+fn route_request(
+    request: HttpRequest,
+    sender: &mpsc::Sender<RemoteGatewayRequest>,
+    ledger: &Arc<Mutex<IdempotencyLedger>>,
+) -> RemoteResponse {
+    let (path, query) = request.path.split_once('?').map_or((request.path.as_str(), ""), |parts| parts);
+    match (request.method.as_str(), path) {
+        ("GET", "/") => RemoteResponse { status: 200, content_type: "text/html; charset=utf-8", body: COMPANION_HTML.as_bytes().to_vec() },
+        ("GET", "/api/session") => dispatch(sender, RemoteCommand::SessionSnapshot { session_id: query_value(query, "session_id") }),
+        ("GET", "/api/run") => dispatch(sender, RemoteCommand::ActiveRunSnapshot),
+        ("GET", "/api/events") => {
+            let Some(run_id) = query_value(query, "run_id") else {
+                return RemoteResponse::error(400, "bad_request", "run_id is required", false);
+            };
+            let after = query_value(query, "after").and_then(|value| value.parse().ok()).unwrap_or(0);
+            let response = dispatch(sender, RemoteCommand::Events { run_id, after });
+            if response.status != 200 {
+                return response;
+            }
+            let payload = String::from_utf8_lossy(&response.body);
+            RemoteResponse { status: 200, content_type: "text/event-stream; charset=utf-8", body: format!("event: agent-events\ndata: {payload}\n\n").into_bytes() }
+        }
+        ("GET", "/api/frame") => {
+            let fields = ["project_id", "session_id", "run_id", "artifact_id"];
+            let values = fields.map(|name| query_value(query, name));
+            let [Some(project_id), Some(session_id), Some(run_id), Some(artifact_id)] = values else {
+                return RemoteResponse::error(400, "bad_request", "frame identity is incomplete", false);
+            };
+            dispatch(sender, RemoteCommand::CapturedFrame { project_id, session_id, run_id, artifact_id })
+        }
+        ("POST", "/api/conversation") => parse_json::<ConversationRequest>(&request.body)
+            .map(|body| dispatch(sender, RemoteCommand::ConversationMessage { session_id: body.session_id, text: body.text }))
+            .unwrap_or_else(bad_json),
+        ("POST", "/api/go") => mutation::<GoRequest>(&request, ledger, |body| {
+            dispatch(sender, RemoteCommand::Go { session_id: body.session_id, proposal_version: body.proposal_version })
+        }),
+        ("POST", "/api/stop") => mutation::<StopRequest>(&request, ledger, |body| {
+            dispatch(sender, RemoteCommand::Stop { run_id: body.run_id })
+        }),
+        ("POST", "/api/awaiting-user") => mutation::<AwaitingRequest>(&request, ledger, |body| {
+            dispatch(sender, RemoteCommand::AwaitingUserResponse { session_id: body.session_id, run_id: body.run_id, text: body.text })
+        }),
+        ("POST", "/api/permission") => mutation::<PermissionRequest>(&request, ledger, |body| {
+            let capability = match serde_json::from_value::<AgentCapability>(Value::String(body.capability)) {
+                Ok(capability) => capability,
+                Err(_) => return RemoteResponse::error(400, "bad_request", "unknown permission capability", false),
+            };
+            let scope = match body.scope.as_str() {
+                "once" => ApprovalScope::Once,
+                "run" => ApprovalScope::Run,
+                "project" => ApprovalScope::Project,
+                "deny" => ApprovalScope::Deny,
+                _ => return RemoteResponse::error(400, "bad_request", "unknown permission scope", false),
+            };
+            dispatch(sender, RemoteCommand::PermissionResponse { run_id: body.run_id, capability, scope })
+        }),
+        _ => RemoteResponse::error(404, "not_found", "application operation does not exist", false),
+    }
+}
+
+trait HasRequestId {
+    fn request_id(&self) -> &str;
+}
+
+fn mutation<T: for<'de> Deserialize<'de> + HasRequestId>(
+    request: &HttpRequest,
+    ledger: &Arc<Mutex<IdempotencyLedger>>,
+    execute: impl FnOnce(T) -> RemoteResponse,
+) -> RemoteResponse {
+    let body = match parse_json::<T>(&request.body) {
+        Ok(body) => body,
+        Err(error) => return bad_json(error),
+    };
+    let request_id = body.request_id().to_owned();
+    if !valid_request_id(&request_id) {
+        return RemoteResponse::error(400, "bad_request", "request_id must be 8-128 safe ASCII characters", false);
+    }
+    let fingerprint = format!("{}:{}", request.path, String::from_utf8_lossy(&request.body));
+    if let Ok(mut locked) = ledger.lock()
+        && let Some(response) = locked.replay(&request_id, &fingerprint)
+    {
+        return response;
+    }
+    let response = execute(body);
+    if let Ok(mut locked) = ledger.lock() {
+        locked.remember(request_id, fingerprint, response.clone());
+    }
+    response
+}
+
+fn dispatch(sender: &mpsc::Sender<RemoteGatewayRequest>, command: RemoteCommand) -> RemoteResponse {
+    let (response_sender, response_receiver) = mpsc::sync_channel(1);
+    if sender.send(RemoteGatewayRequest { command, response: response_sender }).is_err() {
+        return RemoteResponse::error(503, "host_unavailable", "AI Studio host is unavailable", true);
+    }
+    response_receiver.recv_timeout(HOST_TIMEOUT).unwrap_or_else(|_| {
+        RemoteResponse::error(503, "host_busy", "AI Studio host did not answer in time", true)
+    })
+}

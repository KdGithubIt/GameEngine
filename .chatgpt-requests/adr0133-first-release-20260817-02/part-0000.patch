+    fn temp(name: &str) -> PathBuf {
+        let n = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos();
+        std::env::temp_dir().join(format!("gameengine-remote-{name}-{n}"))
+    }
+
+    fn host(name: &str) -> (AgentHost, PathBuf, PathBuf) {
+        let project = temp(&format!("{name}-project"));
+        let storage = temp(&format!("{name}-storage"));
+        fs::create_dir_all(&project).expect("project");
+        (AgentHost::open(project.clone(), storage.clone()).expect("host"), project, storage)
+    }
+
+    #[test]
+    fn gateway_binds_loopback_only() {
+        let (gateway, _requests) = RemoteAiStudioGateway::start().expect("gateway");
+        assert!(gateway.local_addr().ip().is_loopback());
+    }
+
+    #[test]
+    fn idempotent_go_runs_once_and_conflicting_retry_is_rejected() {
+        let mut ledger = IdempotencyLedger::default();
+        let response = RemoteResponse::json(200, json!({"run_id":"run-1"}));
+        ledger.remember("request-1".to_owned(), "go:v2".to_owned(), response.clone());
+        assert_eq!(ledger.replay("request-1", "go:v2").expect("replay").body, response.body);
+        assert_eq!(ledger.replay("request-1", "go:v3").expect("conflict").status, 409);
+        assert_eq!(ledger.entries.len(), 1);
+    }
+
+    #[test]
+    fn duplicate_permission_and_awaiting_responses_are_replayed_once() {
+        let mut ledger = IdempotencyLedger::default();
+        for (id, fingerprint) in [("permission-1", "permission:run"), ("awaiting-1", "awaiting:answer")] {
+            ledger.remember(id.to_owned(), fingerprint.to_owned(), RemoteResponse::json(200, json!({"ok":true})));
+            assert_eq!(ledger.replay(id, fingerprint).expect("replay").status, 200);
+            assert_eq!(ledger.entries.len(), if id == "permission-1" { 1 } else { 2 });
+        }
+    }
+
+    #[test]
+    fn stale_proposal_go_uses_authoritative_host_contract() {
+        let (mut host, project, storage) = host("stale");
+        let session = host.create_session("session").expect("session");
+        let mut first = host.session(&session).expect("session").proposal.clone();
+        first.goal = "first".to_owned();
+        let stale = host.update_proposal(&session, first).expect("first");
+        let mut second = host.session(&session).expect("session").proposal.clone();
+        second.goal = "second".to_owned();
+        host.update_proposal(&session, second).expect("second");
+        assert!(matches!(host.start_run_authorized(&session, stale, "provider"), Err(AgentHostError::StaleProposalVersion { .. })));
+        let _ = fs::remove_dir_all(project); let _ = fs::remove_dir_all(storage);
+    }
+
+    #[test]
+    fn reconnect_snapshot_keeps_active_run_and_pending_decisions() {
+        let (mut host, project, storage) = host("reconnect");
+        let session = host.create_session("session").expect("session");
+        let version = host.session(&session).expect("session").proposal.version;
+        let run = host.start_run_authorized(&session, version, "provider").expect("run");
+        host.transition_run(&run, AgentRunState::AwaitingUser, "Need a choice").expect("awaiting");
+        let snapshot = session_snapshot("project-test", &host, Some(&session), Some((&run, AgentCapability::NetworkAccess)), &project).expect("snapshot");
+        assert_eq!(snapshot["active_run"]["id"], run);
+        assert_eq!(snapshot["awaiting_user"]["run_id"], run);
+        assert_eq!(snapshot["pending_permission"]["run_id"], run);
+        assert_eq!(host.run(&run).expect("run").state, AgentRunState::AwaitingUser);
+        let _ = fs::remove_dir_all(project); let _ = fs::remove_dir_all(storage);
+    }
+
+    #[test]
+    fn event_cursor_resumes_order_and_recovers_when_retention_is_stale() {
+        let (mut host, project, storage) = host("events");
+        let session = host.create_session("session").expect("session");
+        let version = host.session(&session).expect("session").proposal.version;
+        let run = host.start_run_authorized(&session, version, "provider").expect("run");
+        for index in 0..530 { host.record_event(&run, AgentEventKind::SemanticProgress, format!("event {index}")).expect("event"); }
+        let state = host.run(&run).expect("run");
+        let oldest = state.events.first().expect("oldest").sequence;
+        let middle = oldest + 10;
+        let resumed = event_batch(&host, &run, middle, &project).expect("resume");
+        assert_eq!(resumed["events"][0]["cursor"].as_u64(), Some(middle + 1));
+        assert_eq!(resumed["stale_cursor"], false);
+        let stale = event_batch(&host, &run, 1, &project).expect("stale");
+        assert_eq!(stale["stale_cursor"], true);
+        assert_eq!(stale["events"][0]["cursor"].as_u64(), Some(oldest));
+        let _ = fs::remove_dir_all(project); let _ = fs::remove_dir_all(storage);
+    }
+

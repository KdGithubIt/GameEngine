+impl HasRequestId for GoRequest { fn request_id(&self) -> &str { &self.request_id } }
+#[derive(Deserialize)]
+struct StopRequest { request_id: String, run_id: String }
+impl HasRequestId for StopRequest { fn request_id(&self) -> &str { &self.request_id } }
+#[derive(Deserialize)]
+struct AwaitingRequest { request_id: String, session_id: String, run_id: String, text: String }
+impl HasRequestId for AwaitingRequest { fn request_id(&self) -> &str { &self.request_id } }
+#[derive(Deserialize)]
+struct PermissionRequest { request_id: String, run_id: String, capability: String, scope: String }
+impl HasRequestId for PermissionRequest { fn request_id(&self) -> &str { &self.request_id } }

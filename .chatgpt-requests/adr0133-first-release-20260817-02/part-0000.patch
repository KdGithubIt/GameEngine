${esc(p.label)}</p><div class="row">${p.scopes.map(x=>`<button onclick="permission('${x}')">${esc(x)}</button>`).join('')}</div>`;else if(a)document.getElementById('decision').innerHTML=`<b>AwaitingUser</b><p>${esc(a.message)}</p><textarea id="answer" rows="2" style="width:100%"></textarea><button onclick="answer()">Respond</button>`;else document.getElementById('decision').textContent='None';const f=r?.frames?.at(-1);document.getElementById('frame').innerHTML=f?`<img class="frame" alt="Captured run frame" src="/api/frame?project_id=${encodeURIComponent(snapshot.project_id)}&session_id=${encodeURIComponent(s.id)}&run_id=${encodeURIComponent(r.id)}&artifact_id=${encodeURIComponent(f.artifact_id)}"><p>visual_evaluation: <b>${esc(r.completion.visual_evaluation)}</b></p>`:'<span class="muted">No captured frame yet</span>'}async function post(path,body){return api(path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})}async function sendMessage(){const e=document.getElementById('message');if(e.value.trim())await post('/api/conversation',{session_id:snapshot.session.id,text:e.value.trim()});e.value='';refresh()}async function go(){await post('/api/go',{request_id:id(),session_id:snapshot.session.id,proposal_version:snapshot.session.proposal.version});refresh()}async function stopRun(){if(snapshot.active_run)await post('/api/stop',{request_id:id(),run_id:snapshot.active_run.id});refresh()}async function permission(scope){const p=snapshot.pending_permission;await post('/api/permission',{request_id:id(),run_id:p.run_id,capability:p.capability,scope});refresh()}async function answer(){const a=snapshot.awaiting_user,e=document.getElementById('answer');await post('/api/awaiting-user',{request_id:id(),session_id:snapshot.session.id,run_id:a.run_id,text:e.value});refresh()}refresh();
+</script></body></html>"#;

+//! Skeleton-independent humanoid motion authoring and bake support (ADR 0110).
+//!
+//! A [`HumanoidProfile`] belongs to a concrete imported model and maps stable humanoid
+//! semantics to that model's stable `BoneId`s. [`HumanoidMotion`] is the inverse side of
+//! that boundary: it stores rotations against [`HumanoidBone`] only, never source bone
+//! names or IDs. Conversion and target adaptation happen before runtime playback; the
+//! result is an ordinary target-bound [`AnimationClip`].
+
+use crate::animation::{lerp_channel, AnimChannel, AnimEvent, AnimProperty, AnimationClip, Keyframe};
+use crate::derived_cache::{CacheKey, DerivedCache};
+use crate::skeleton_asset::{BoneId, SkeletonAsset};
+use engine_assets::asset::{HumanoidBone, HumanoidProfile, HumanoidProfileOrigin};
+use engine_authoring::diagnostic::Diagnostic;
+use glam::Quat;
+use hashbrown::{HashMap, HashSet};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+
+/// Bumped whenever unchanged humanoid inputs would bake to different target clip bytes.
+pub const HUMANOID_RETARGET_ALGORITHM_VERSION: u32 = 1;
+
+const HUMANOID_BAKE_SCHEMA_VERSION: u32 = 1;
+const HUMANOID_CACHE_DOMAIN: &str = "humanoid_anim";
+const HUMANOID_CACHE_EXTENSION: &str = "clip.json";
+const QUAT_EPSILON: f32 = 1.0e-6;
+
+/// One portable rotation-delta channel targeting a humanoid semantic.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct HumanoidRotationChannel {
+    /// Semantic body target, independent of any concrete skeleton.
+    pub bone: HumanoidBone,
+    /// Model-space rotation delta samples, stored as XYZW quaternions.
+    pub keyframes: Vec<Keyframe>,
+}
+
+/// Root-motion samples extracted from a profile's dedicated `motion_root`.
+///
+/// ADR 0110 intentionally does not define cross-proportion translation scaling. The payload
+/// is therefore retained as source-space model translation data for authoring/inspection,
+/// while [`bake_humanoid_motion`] deliberately does not apply it to a target skeleton.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct HumanoidRootMotion {
+    /// Model-space translation deltas from the source rest pose.
+    pub keyframes: Vec<Keyframe>,
+}
+
+/// Skeleton-independent humanoid derivative of one imported native animation.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct HumanoidMotion {
+    /// Total motion length in seconds.
+    pub duration: f32,
+    /// Portable model-space rotation deltas keyed by humanoid semantics.
+    pub rotations: Vec<HumanoidRotationChannel>,
+    /// Optional locomotion metadata extracted through the profile's `motion_root`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub root_motion: Option<HumanoidRootMotion>,
+    /// Timeline markers that are not tied to source BoneIds.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub events: Vec<AnimEvent>,
+    /// Source skeleton identity used only for provenance/staleness diagnostics.
+    pub source_skeleton_identity: u64,
+}
+
+/// Successful native-to-humanoid conversion plus non-blocking loss diagnostics.
+#[derive(Debug, Clone)]
+pub struct HumanoidMotionBuildResult {
+    /// Portable motion payload.
+    pub motion: HumanoidMotion,
+    /// Warnings for source-specific channels intentionally excluded by ADR 0110.
+    pub diagnostics: Vec<Diagnostic>,
+}
+
+/// Successful humanoid-to-target bake plus non-blocking adaptation diagnostics.
+#[derive(Debug, Clone)]
+pub struct HumanoidBakeResult {
+    /// Ordinary target-skeleton clip consumed by the runtime Animator.
+    pub clip: AnimationClip,
+    /// Warnings for portable data intentionally not applied by current policy.
+    pub diagnostics: Vec<Diagnostic>,
+}
+
+/// Why a profile or portable motion cannot be used safely.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum HumanoidError {
+    /// Profile was recorded for another skeleton asset.
+    SkeletonMismatch,
+    /// Profile was recorded against a stale skeleton identity.
+    SkeletonIdentityMismatch,
+    /// A required semantic has no mapping.
+    MissingRequired(HumanoidBone),
+    /// A mapped stable BoneId is absent from the skeleton.
+    MissingBone { semantic: HumanoidBone, bone: u32 },
+    /// Two semantics were mapped to the same concrete bone.
+    DuplicateBone {
+        first: HumanoidBone,
+        second: HumanoidBone,
+        bone: u32,
+    },
+    /// A required body chain violates ancestry order.
+    InvalidHierarchy {
+        ancestor: HumanoidBone,
+        descendant: HumanoidBone,
+    },
+    /// Native clip was sampled against a different skeleton/profile pair.
+    ClipSkeletonMismatch,
+    /// Cache serialization or persistence failed.
+    Cache(String),
+}
+
+impl fmt::Display for HumanoidError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::SkeletonMismatch => formatter.write_str("humanoid profile targets a different skeleton"),
+            Self::SkeletonIdentityMismatch => formatter.write_str("humanoid profile is stale for the current skeleton identity"),
+            Self::MissingRequired(bone) => write!(formatter, "humanoid profile is missing required semantic {bone:?}"),
+            Self::MissingBone { semantic, bone } => write!(formatter, "humanoid semantic {semantic:?} refers to missing BoneId({bone})"),
+            Self::DuplicateBone { first, second, bone } => write!(formatter, "humanoid semantics {first:?} and {second:?} both refer to BoneId({bone})"),
+            Self::InvalidHierarchy { ancestor, descendant } => write!(formatter, "humanoid semantic {ancestor:?} must be an ancestor of {descendant:?}"),
+            Self::ClipSkeletonMismatch => formatter.write_str("native clip does not match the humanoid profile's source skeleton"),
+            Self::Cache(message) => write!(formatter, "humanoid derived-cache error: {message}"),
+        }
+    }
+}
+
+impl std::error::Error for HumanoidError {}
+
+/// Result of import-time humanoid detection for one skeleton.
+#[derive(Debug, Clone)]
+pub struct HumanoidProfileDetection {
+    /// Valid profile when all required semantics were resolved and passed structural checks.
+    pub profile: Option<HumanoidProfile>,
+    /// Diagnostics explaining uncertainty or why conversion is unavailable.
+    pub diagnostics: Vec<Diagnostic>,
+}
+
+/// Validates a persisted model profile against the concrete skeleton it claims to describe.
+///
+/// Chain checks use ancestry, never direct-parent adjacency, so twist/helper bones may remain
+/// between mapped semantics as required by ADR 0110.
+pub fn validate_humanoid_profile(
+    profile: &HumanoidProfile,
+    skeleton: &SkeletonAsset,
+) -> Result<(), HumanoidError> {
+    if profile.skeleton != skeleton.id.as_str() {
+        return Err(HumanoidError::SkeletonMismatch);
+    }
+    if profile.skeleton_identity != skeleton.identity.0 {
+        return Err(HumanoidError::SkeletonIdentityMismatch);
+    }
+
+    for semantic in HumanoidBone::REQUIRED {
+        if !profile.bones.contains_key(&semantic) {
+            return Err(HumanoidError::MissingRequired(semantic));
+        }
+    }
+
+    let mut assigned = HashMap::<u32, HumanoidBone>::new();
+    for (&semantic, &bone) in &profile.bones {
+        if skeleton.bone_index(BoneId(bone)).is_none() {
+            return Err(HumanoidError::MissingBone { semantic, bone });
+        }
+        if let Some(first) = assigned.insert(bone, semantic) {
+            return Err(HumanoidError::DuplicateBone {
+                first,
+                second: semantic,
+                bone,
+            });
+        }
+    }
+    if let Some(root) = profile.motion_root
+        && skeleton.bone_index(BoneId(root)).is_none()
+    {
+        return Err(HumanoidError::MissingBone {
+            semantic: HumanoidBone::Hips,
+            bone: root,
+        });
+    }
+
+    for (ancestor, descendant) in required_ancestry_pairs() {
+        let ancestor_id = BoneId(profile.bones[&ancestor]);
+        let descendant_id = BoneId(profile.bones[&descendant]);
+        if !is_ancestor(skeleton, ancestor_id, descendant_id) {
+            return Err(HumanoidError::InvalidHierarchy {
+                ancestor,
+                descendant,
+            });
+        }
+    }
+    Ok(())
+}
+
+/// Detects a conservative first humanoid profile from common PMX/Mixamo/VRM-style names.
+///
+/// Exact normalized aliases are only a first-import heuristic. The result is immediately
+/// validated structurally and persisted as BoneIds by the caller; runtime conversion never
+/// rebinds by name. Ambiguous aliases are reported and not guessed.
+pub fn detect_humanoid_profile(skeleton: &SkeletonAsset) -> HumanoidProfileDetection {
+    let mut candidates = BTreeMap::<HumanoidBone, Vec<BoneId>>::new();
+    for bone in &skeleton.bones {
+        let normalized = normalize_bone_name(&bone.name);
+        for semantic in all_semantics() {
+            if aliases(semantic).contains(&normalized.as_str()) {
+                candidates.entry(semantic).or_default().push(bone.id);
+            }
+        }
+    }
+
+    let mut bones = BTreeMap::new();
+    let mut diagnostics = Vec::new();
+    let mut uncertain = Vec::new();
+    for semantic in all_semantics() {
+        match candidates.get(&semantic).map(Vec::as_slice) {
+            Some([bone]) => {
+                bones.insert(semantic, bone.0);
+            }
+            Some(many) if !many.is_empty() => {
+                uncertain.push(semantic);
+                diagnostics.push(Diagnostic::warning(
+                    "anim.humanoid_mapping_ambiguous",
+                    format!("humanoid semantic {semantic:?} matched {} source bones; configure the model profile explicitly", many.len()),
+                ));
+            }
+            _ => {}
+        }
+    }
+
+    let motion_root = skeleton
+        .bones
+        .iter()
+        .find(|bone| {
+            matches!(
+                normalize_bone_name(&bone.name).as_str(),
+                "root" | "motionroot" | "全ての親" | "センター"
+            )
+        })
+        .map(|bone| bone.id.0);
+    let profile = HumanoidProfile {
+        skeleton: skeleton.id.as_str().to_owned(),
+        skeleton_identity: skeleton.identity.0,
+        bones,
+        motion_root,
+        uncertain_bones: uncertain,
+        origin: HumanoidProfileOrigin::Automatic,
+    };
+    match validate_humanoid_profile(&profile, skeleton) {
+        Ok(()) => HumanoidProfileDetection {
+            profile: Some(profile),
+            diagnostics,
+        },
+        Err(error) => {
+            diagnostics.push(Diagnostic::warning(
+                "anim.humanoid_profile_unavailable",
+                format!("skeleton `{}` cannot expose a Humanoid variant automatically: {error}", skeleton.name),
+            ));
+            HumanoidProfileDetection {
+                profile: None,
+                diagnostics,
+            }
+        }
+    }
+}
+
+/// Converts a source-bound native clip into a skeleton-independent body-rotation motion.
+pub fn build_humanoid_motion(
+    clip: &AnimationClip,
+    skeleton: &SkeletonAsset,
+    profile: &HumanoidProfile,
+) -> Result<HumanoidMotionBuildResult, HumanoidError> {
+    validate_humanoid_profile(profile, skeleton)?;
+    if clip.skeleton.as_ref() != Some(&skeleton.id)
+        || clip.skeleton_identity != Some(skeleton.identity)
+    {
+        return Err(HumanoidError::ClipSkeletonMismatch);
+    }
+
+    let rotation_channels = native_rotation_channels(clip);
+    let rest_model = rest_model_rotations(skeleton);
+    let mut sample_times = BTreeSet::<OrderedTime>::new();
+    sample_times.insert(OrderedTime(0.0));
+    if clip.duration.is_finite() && clip.duration > 0.0 {
+        sample_times.insert(OrderedTime(clip.duration));
+    }
+    for channel in rotation_channels.values() {
+        for keyframe in &channel.keyframes {
+            if keyframe.time.is_finite() && keyframe.time >= 0.0 {
+                sample_times.insert(OrderedTime(keyframe.time));
+            }
+        }
+    }
+    let sample_times = sample_times.into_iter().map(|time| time.0).collect::<Vec<_>>();
+
+    let mut rotations = Vec::new();
+    for (&semantic, &bone_value) in &profile.bones {
+        let bone = BoneId(bone_value);
+        let Some(index) = skeleton.bone_index(bone) else {
+            continue;
+        };
+        let ancestor_is_animated = ancestor_chain(skeleton, index)
+            .into_iter()
+            .any(|ancestor| rotation_channels.contains_key(&skeleton.bones[ancestor].id));
+        if !ancestor_is_animated {
+            continue;
+        }
+        let mut keyframes = Vec::with_capacity(sample_times.len());
+        for &time in &sample_times {
+            let animated = animated_model_rotations(skeleton, &rotation_channels, time);
+            let delta = normalize_quat(animated[index] * rest_model[index].inverse());
+            keyframes.push(Keyframe {
+                time,
+                value: quat_value(delta),
+            });
+        }
+        if !all_identity(&keyframes) {
+            rotations.push(HumanoidRotationChannel { bone: semantic, keyframes });
+        }
+    }
+    rotations.sort_by_key(|channel| channel.bone);
+
+    let mut diagnostics = Vec::new();
+    let mapped_ids = profile.bones.values().copied().collect::<HashSet<_>>();
+    let excluded_transform_channels = clip
+        .channels
+        .iter()
+        .filter(|channel| {
+            channel.property != AnimProperty::Rotation
+                || channel.target_bone.is_none_or(|bone| !mapped_ids.contains(&bone.0))
+        })
+        .count();
+    let excluded = excluded_transform_channels + clip.morph_channels.len();
+    if excluded != 0 {
+        diagnostics.push(Diagnostic::warning(
+            "anim.humanoid_source_channels_excluded",
+            format!("Humanoid variant keeps body rotation semantics only; {excluded} source-specific transform/morph channels remain available on the Native variant"),
+        ));
+    }
+    let root_motion = extract_root_motion_metadata(clip, skeleton, profile);
+    if root_motion.is_some() {
+        diagnostics.push(Diagnostic::warning(
+            "anim.humanoid_root_motion_policy_required",
+            "Humanoid root-motion translation is retained as metadata but is not applied across skeleton proportions until an explicit scaling policy is selected",
+        ));
+    }
+
+    Ok(HumanoidMotionBuildResult {
+        motion: HumanoidMotion {
+            duration: clip.duration,
+            rotations,
+            root_motion,
+            events: clip.events.clone(),
+            source_skeleton_identity: skeleton.identity.0,
+        },
+        diagnostics,
+    })
+}
+
+/// Bakes portable humanoid body rotations onto one target profile/skeleton.
+///
+/// The output is a normal target-bound [`AnimationClip`]. No humanoid solver is required in
+/// Animator, Animation Graph, blending, root-motion extraction, foot IK, or secondary motion.
+pub fn bake_humanoid_motion(
+    motion: &HumanoidMotion,
+    target: &SkeletonAsset,
+    profile: &HumanoidProfile,
+) -> Result<HumanoidBakeResult, HumanoidError> {
+    validate_humanoid_profile(profile, target)?;
+    let rest_model = rest_model_rotations(target);
+    let by_semantic = motion
+        .rotations
+        .iter()
+        .map(|channel| (channel.bone, channel))
+        .collect::<BTreeMap<_, _>>();
+    let target_semantics = profile
+        .bones
+        .iter()
+        .filter_map(|(&semantic, &bone)| target.bone_index(BoneId(bone)).map(|index| (index, semantic)))
+        .collect::<HashMap<_, _>>();
+
+    let mut times = BTreeSet::<OrderedTime>::new();
+    times.insert(OrderedTime(0.0));
+    if motion.duration.is_finite() && motion.duration > 0.0 {
+        times.insert(OrderedTime(motion.duration));
+    }
+    for channel in &motion.rotations {
+        for keyframe in &channel.keyframes {
+            if keyframe.time.is_finite() && keyframe.time >= 0.0 {
+                times.insert(OrderedTime(keyframe.time));
+            }
+        }
+    }
+    let times = times.into_iter().map(|value| value.0).collect::<Vec<_>>();
+    let mut output = BTreeMap::<HumanoidBone, Vec<Keyframe>>::new();
+    for &time in &times {
+        let mut animated_model = Vec::with_capacity(target.bones.len());
+        let mut animated_local = Vec::with_capacity(target.bones.len());
+        for (index, bone) in target.bones.iter().enumerate() {
+            let model_rotation = if let Some(semantic) = target_semantics.get(&index)
+                && let Some(channel) = by_semantic.get(semantic)
+            {
+                let delta = sample_humanoid_rotation(channel, time);
+                normalize_quat(delta * rest_model[index])
+            } else {
+                match bone.parent {
+                    Some(parent) => normalize_quat(animated_model[parent] * bone.rest_rotation),
+                    None => normalize_quat(bone.rest_rotation),
+                }
+            };
+            let local_rotation = match bone.parent {
+                Some(parent) => normalize_quat(animated_model[parent].inverse() * model_rotation),
+                None => model_rotation,
+            };
+            animated_model.push(model_rotation);
+            animated_local.push(local_rotation);
+        }
+        for (&index, &semantic) in &target_semantics {
+            if by_semantic.contains_key(&semantic) {
+                output.entry(semantic).or_default().push(Keyframe {
+                    time,
+                    value: quat_value(animated_local[index]),
+                });
+            }
+        }
+    }
+
+    let mut channels = output
+        .into_iter()
+        .filter_map(|(semantic, keyframes)| {
+            let bone = BoneId(profile.bones[&semantic]);
+            (!keyframes.is_empty()).then_some(AnimChannel {
+                property: AnimProperty::Rotation,
+                target_bone: Some(bone),
+                keyframes,
+            })
+        })
+        .collect::<Vec<_>>();
+    channels.sort_by_key(|channel| channel.target_bone.map_or(u32::MAX, |bone| bone.0));
+
+    let mut diagnostics = Vec::new();
+    if motion.root_motion.is_some() {
+        diagnostics.push(Diagnostic::warning(
+            "anim.humanoid_root_motion_not_applied",
+            "Humanoid bake omitted portable root translation because ADR 0110 requires an explicit cross-proportion translation policy",
+        ));
+    }
+    Ok(HumanoidBakeResult {
+        clip: AnimationClip {
+            duration: motion.duration,
+            channels,
+            morph_channels: Vec::new(),
+            events: motion.events.clone(),
+            skeleton: Some(target.id.clone()),
+            skeleton_identity: Some(target.identity),
+            root_bone: profile.motion_root.map(BoneId),
+            contacts: Vec::new(),
+        },
+        diagnostics,
+    })
+}
+
+/// Computes the content-addressed cache key for one humanoid target bake.
+pub fn humanoid_bake_cache_key(
+    motion: &HumanoidMotion,
+    target: &SkeletonAsset,
+    profile: &HumanoidProfile,
+) -> Result<CacheKey, HumanoidError> {
+    let motion_json = serde_json::to_vec(motion).map_err(|error| HumanoidError::Cache(error.to_string()))?;
+    let profile_json = serde_json::to_vec(profile).map_err(|error| HumanoidError::Cache(error.to_string()))?;
+    let mut hash = fnv1a_seed();
+    hash_u64(&mut hash, u64::from(HUMANOID_RETARGET_ALGORITHM_VERSION));
+    hash_bytes(&mut hash, &motion_json);
+    hash_u64(&mut hash, target.identity.0);
+    hash_bytes(&mut hash, &profile_json);
+    Ok(CacheKey(hash))
+}

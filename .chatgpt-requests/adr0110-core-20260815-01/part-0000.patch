+/// Resolves a target humanoid bake from the disposable Derived Cache or creates it on miss.
+pub fn resolve_or_bake_humanoid_motion(
+    cache: &DerivedCache,
+    motion: &HumanoidMotion,
+    target: &SkeletonAsset,
+    profile: &HumanoidProfile,
+) -> Result<HumanoidBakeResult, HumanoidError> {
+    validate_humanoid_profile(profile, target)?;
+    let key = humanoid_bake_cache_key(motion, target, profile)?;
+    if let Some(bytes) = cache.get(HUMANOID_CACHE_DOMAIN, &key, HUMANOID_CACHE_EXTENSION)
+        && let Ok(envelope) = serde_json::from_slice::<HumanoidBakeEnvelope>(&bytes)
+        && envelope.schema_version == HUMANOID_BAKE_SCHEMA_VERSION
+    {
+        return Ok(HumanoidBakeResult {
+            clip: envelope.clip,
+            diagnostics: Vec::new(),
+        });
+    }
+    let baked = bake_humanoid_motion(motion, target, profile)?;
+    let bytes = serde_json::to_vec(&HumanoidBakeEnvelope {
+        schema_version: HUMANOID_BAKE_SCHEMA_VERSION,
+        clip: baked.clip.clone(),
+    })
+    .map_err(|error| HumanoidError::Cache(error.to_string()))?;
+    cache
+        .put(HUMANOID_CACHE_DOMAIN, &key, HUMANOID_CACHE_EXTENSION, &bytes)
+        .map_err(|error| HumanoidError::Cache(error.to_string()))?;
+    Ok(baked)
+}
+
+#[derive(Serialize, Deserialize)]
+struct HumanoidBakeEnvelope {
+    schema_version: u32,
+    clip: AnimationClip,
+}

+/// Machine-level readiness of the pinned Codex ACP package.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum CodexAcpAvailability {
+    /// The executable exists and reports the exact validated package version.
+    Available,
+    /// No launchable `codex-acp` executable could be found in the selected placement.
+    Missing,
+    /// An executable exists but reports a version this adapter has not validated.
+    VersionMismatch {
+        /// Version required by this GameEngine adapter.
+        expected: String,
+        /// Version reported by the executable, when one could be extracted.
+        observed: Option<String>,
+    },
+    /// The executable was found but its version probe could not complete successfully.
+    ProbeFailed(String),
+}
+
+impl CodexAcpAvailability {
+    /// Returns whether a run may proceed to ACP initialization.
+    pub(crate) const fn is_available(&self) -> bool {
+        matches!(self, Self::Available)
+    }
+
+    /// Produces an actionable local diagnostic without exposing credentials.
+    pub(crate) fn diagnostic(&self) -> Option<String> {
+        match self {
+            Self::Available => None,
+            Self::Missing => Some(format!(
+                "Codex ACP is not installed in the selected execution environment. Install {} or select an environment where `{}` is available.",
+                CODEX_ACP_INSTALL_PACKAGE, CODEX_ACP_EXECUTABLE
+            )),
+            Self::VersionMismatch { expected, observed } => Some(match observed {
+                Some(observed) => format!(
+                    "Codex ACP {observed} is installed, but GameEngine requires exactly {expected}. Run the pinned Codex ACP setup action before using this adapter."
+                ),
+                None => format!(
+                    "Codex ACP is installed but did not report a parseable version. GameEngine requires exactly {expected}."
+                ),
+            }),
+            Self::ProbeFailed(message) => Some(format!(
+                "Codex ACP could not be probed in the selected execution environment: {message}"
+            )),
+        }
+    }
+}

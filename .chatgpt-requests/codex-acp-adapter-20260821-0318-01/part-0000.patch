+/// Provider-neutral snapshot of the Codex ACP initialize advertisement.
+///
+/// Shared ACP transport code populates this from the wire. Keeping the wire SDK
+/// types out of this structure preserves ADR 0166's ACP boundary.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CodexAcpAdvertisement {
+    /// Negotiated stable ACP protocol version.
+    pub(crate) protocol_version: u16,
+    /// Agent name advertised by ACP initialization.
+    pub(crate) agent_name: String,
+    /// Agent version advertised by ACP initialization.
+    pub(crate) agent_version: Option<String>,
+    /// Whether `session/load` is advertised.
+    pub(crate) session_load: bool,
+    /// Whether session resume is advertised.
+    pub(crate) session_resume: bool,
+    /// Whether session listing is advertised.
+    pub(crate) session_list: bool,
+    /// MCP HTTP support advertised by the agent.
+    pub(crate) mcp_http: bool,
+    /// MCP SSE support advertised by the agent.
+    pub(crate) mcp_sse: bool,
+    /// MCP-over-ACP support advertised by the agent.
+    pub(crate) mcp_over_acp: bool,
+    /// Session configuration options advertised by the opened session.
+    pub(crate) config_options: BTreeMap<String, CodexAcpConfigOptionKind>,
+    /// Authentication method IDs advertised during initialization.
+    pub(crate) auth_methods: BTreeSet<String>,
+    /// Optional ACP extension identifiers retained for diagnostics/integration.
+    pub(crate) extensions: BTreeSet<String>,
+}
+
+impl CodexAcpAdvertisement {
+    /// Validates that the ACP peer is the exact Codex adapter package this code
+    /// was written against.
+    ///
+    /// # Errors
+    ///
+    /// Returns a protocol error when the wire version or runtime identity is not
+    /// the exact validated identity.
+    pub(crate) fn validate_exact_identity(&self) -> Result<(), AcpRuntimeError> {
+        if self.protocol_version != ACP_STABLE_PROTOCOL_VERSION {
+            return Err(AcpRuntimeError::Protocol(format!(
+                "Codex ACP negotiated protocol version {}, but GameEngine requires stable ACP v{}",
+                self.protocol_version, ACP_STABLE_PROTOCOL_VERSION
+            )));
+        }
+        if self.agent_name != CODEX_ACP_PACKAGE_NAME {
+            return Err(AcpRuntimeError::Protocol(format!(
+                "Codex ACP initialized as `{}`, expected `{CODEX_ACP_PACKAGE_NAME}`",
+                self.agent_name
+            )));
+        }
+        if self.agent_version.as_deref() != Some(CODEX_ACP_PACKAGE_VERSION) {
+            return Err(AcpRuntimeError::Protocol(format!(
+                "Codex ACP initialized with version {}, expected exactly {CODEX_ACP_PACKAGE_VERSION}",
+                self.agent_version.as_deref().unwrap_or("<missing>")
+            )));
+        }
+        Ok(())
+    }
+
+    /// Maps the advertisement to the provider-neutral capabilities consumed by
+    /// GameEngine orchestration.
+    pub(crate) fn normalized_capabilities(&self) -> AcpCapabilities {
+        AcpCapabilities {
+            session_load: self.session_load,
+            session_resume: self.session_resume,
+            session_list: self.session_list,
+            session_config_options: !self.config_options.is_empty(),
+            mcp_http: self.mcp_http,
+            mcp_sse: self.mcp_sse,
+            mcp_over_acp: self.mcp_over_acp,
+            extensions: self.extensions.clone(),
+        }
+    }
+
+    /// Builds the diagnostic shown when ACP reports authentication is required.
+    ///
+    /// Authentication remains provider-owned; this message only names the
+    /// methods the agent advertised and never asks GameEngine to read a token.
+    pub(crate) fn authentication_required_diagnostic(&self) -> String {
+        if self.auth_methods.is_empty() {
+            return "Codex ACP requires authentication but advertised no usable ACP authentication method. Re-run Codex ACP setup or inspect the adapter installation.".to_owned();
+        }
+        format!(
+            "Codex ACP requires authentication. Complete one of its advertised ACP methods: {}. GameEngine does not read or persist the provider credential.",
+            self.auth_methods.iter().cloned().collect::<Vec<_>>().join(", ")
+        )
+    }
+}

+//! Codex-specific adapter metadata for the common ACP runtime.
+//!
+//! This module owns discovery, package setup, exact runtime identity, process
+//! placement, and Codex ACP session-option mapping. ACP wire I/O stays in the
+//! shared transport used by integration, while the legacy `codex exec --json`
+//! path remains untouched as a rollback path.
+
+use crate::acp_agent_runtime::{
+    ACP_STABLE_PROTOCOL_VERSION, AcpAgentDescriptor, AcpCapabilities, AcpMcpAccessLevel,
+    AcpRuntimeError, AcpRuntimeIdentity, AcpSessionBinding,
+};
+use crate::external_agent_provider::{
+    ExternalAgentExecutionEnvironment, ExternalAgentExecutionPlacement, command_output,
+    installer_is_available, placed_launch_command, probe_wsl_loopback_reachability,
+    wsl_environment_forwarding,
+};
+use std::collections::{BTreeMap, BTreeSet};
+use std::ffi::{OsStr, OsString};
+use std::io;

+            mcp_over_acp: false,
+            config_options: BTreeMap::from([
+                (MODEL_CONFIG_ID.to_owned(), CodexAcpConfigOptionKind::Select),
+                (
+                    REASONING_EFFORT_CONFIG_ID.to_owned(),
+                    CodexAcpConfigOptionKind::Select,
+                ),
+                (MODE_CONFIG_ID.to_owned(), CodexAcpConfigOptionKind::Select),
+                (
+                    FAST_MODE_CONFIG_ID.to_owned(),
+                    CodexAcpConfigOptionKind::Boolean,
+                ),
+            ]),
+            auth_methods: BTreeSet::from([
+                "api-key".to_owned(),
+                "chat-gpt".to_owned(),
+                "chat-gpt-device-code".to_owned(),
+            ]),
+            extensions: BTreeSet::from(["steering".to_owned(), "goal".to_owned()]),
+        }
+    }
+
+    fn available_probe() -> CodexAcpProbe {
+        CodexAcpProbe {
+            availability: CodexAcpAvailability::Available,
+            installer_available: true,
+            expected_identity: AcpRuntimeIdentity::stable(
+                CODEX_ACP_PACKAGE_NAME,
+                Some(CODEX_ACP_PACKAGE_VERSION.to_owned()),
+            ),
+        }
+    }
+
+    fn read_only_binding() -> AcpSessionBinding {
+        AcpSessionBinding::read_only(
+            "session-1",
+            "http://127.0.0.1:4000/mcp",
+            "secret",
+        )
+        .expect("read-only binding")
+    }
+
+    fn run_bound_binding() -> AcpSessionBinding {
+        AcpSessionBinding::run_bound(
+            "session-1",
+            "run-1",
+            "http://127.0.0.1:4000/mcp",
+            "secret",
+        )
+        .expect("run-bound binding")
+    }
+
+    #[test]
+    fn version_probe_requires_the_exact_pinned_adapter_version() {
+        assert_eq!(
+            extract_version("@agentclientprotocol/codex-acp 1.6.2\n"),
+            Some("1.6.2".to_owned())
+        );
+        assert!(output_reports_exact_version("codex-acp 1.6.2"));
+        assert!(!output_reports_exact_version("codex-acp 1.6.3"));
+    }
+
+    #[test]
+    fn descriptor_uses_exact_advertised_identity_and_normalized_capabilities() {
+        let descriptor = codex_acp_descriptor(
+            &available_probe(),
+            &ExternalAgentExecutionPlacement::windows_native(),
+            &advertisement(),
+        )
+        .expect("descriptor");
+
+        assert_eq!(descriptor.id, CODEX_ACP_DESCRIPTOR_ID);
+        assert_eq!(
+            descriptor.runtime_identity.agent_name,
+            CODEX_ACP_PACKAGE_NAME
+        );
+        assert_eq!(
+            descriptor.runtime_identity.agent_version.as_deref(),
+            Some(CODEX_ACP_PACKAGE_VERSION)
+        );
+        assert!(descriptor.capabilities.session_load);
+        assert!(descriptor.capabilities.session_resume);
+        assert!(descriptor.capabilities.session_list);
+        assert!(descriptor.capabilities.session_config_options);
+        assert!(descriptor.capabilities.mcp_http);
+        assert!(!descriptor.capabilities.mcp_over_acp);
+        assert!(descriptor.capabilities.extensions.contains("goal"));
+    }
+
+
+    #[test]
+    fn registration_exposes_only_the_codex_logical_target_and_descriptor() {
+        let registration = codex_acp_registration(
+            &available_probe(),
+            &ExternalAgentExecutionPlacement::windows_native(),
+            &advertisement(),
+        )
+        .expect("registration");
+
+        assert_eq!(registration.logical_target, CODEX_ACP_LOGICAL_TARGET);
+        assert_eq!(registration.descriptor.id, CODEX_ACP_DESCRIPTOR_ID);
+    }
+
+    #[test]
+    fn mismatched_initialized_identity_is_rejected() {
+        let mut advertisement = advertisement();
+        advertisement.agent_version = Some("1.6.3".to_owned());
+
+        assert!(matches!(
+            advertisement.validate_exact_identity(),
+            Err(AcpRuntimeError::Protocol(_))
+        ));
+    }
+
+    #[test]
+    fn install_command_pins_the_codex_acp_package_without_touching_legacy_codex() {
+        let plan = codex_acp_install_command(
+            &ExternalAgentExecutionPlacement::windows_native(),
+        );
+        assert!(plan.arguments.iter().any(|argument| {
+            argument.to_string_lossy() == CODEX_ACP_INSTALL_PACKAGE
+        }));
+        assert!(!plan.arguments.iter().any(|argument| {
+            argument.to_string_lossy() == "@openai/codex@0.148.0"
+        }));
+    }
+
+    #[test]
+    fn wsl_server_launch_preserves_agent_name_and_forwards_initial_mode() {
+        let placement = ExternalAgentExecutionPlacement {
+            environment: ExternalAgentExecutionEnvironment::Wsl2Linux,
+            distribution: "Ubuntu-24.04".to_owned(),
+        };
+        let command = codex_acp_server_command(&placement, &run_bound_binding());
+
+        assert_eq!(command.program, OsString::from("wsl.exe"));
+        assert_eq!(
+            command.arguments[..4],
+            [
+                OsString::from("-d"),
+                OsString::from("Ubuntu-24.04"),
+                OsString::from("--"),
+                OsString::from(CODEX_ACP_EXECUTABLE),
+            ]
+        );
+        assert!(command.environment.iter().any(|(name, value)| {
+            name == INITIAL_AGENT_MODE_ENV && value == AGENT_MODE_ID
+        }));
+        assert!(command.environment.iter().any(|(name, value)| {
+            name == "WSLENV"
+                && value
+                    .to_string_lossy()
+                    .split(':')
+                    .any(|entry| entry == INITIAL_AGENT_MODE_ENV)
+        }));
+    }
+
+    #[test]
+    fn gameengine_access_maps_to_safe_codex_approval_and_sandbox_modes() {
+        assert_eq!(
+            codex_acp_policy(&read_only_binding()),
+            CodexAcpPolicy {
+                approval: CodexAcpApprovalPolicy::OnRequest,
+                sandbox: CodexAcpSandboxMode::ReadOnly,
+                mode_id: READ_ONLY_MODE_ID,
+            }
+        );
+        assert_eq!(
+            codex_acp_policy(&run_bound_binding()),
+            CodexAcpPolicy {
+                approval: CodexAcpApprovalPolicy::OnRequest,
+                sandbox: CodexAcpSandboxMode::WorkspaceWrite,
+                mode_id: AGENT_MODE_ID,
+            }
+        );
+    }
+
+    #[test]
+    fn session_preferences_map_only_to_advertised_acp_config_options() {
+        let preferences = CodexAcpSessionPreferences {
+            model: Some("gpt-5.3-codex".to_owned()),
+            reasoning_effort: Some("high".to_owned()),
+            fast_mode: Some(true),
+        };
+        let selections = codex_acp_session_config(
+            &run_bound_binding(),
+            &preferences,
+            &advertisement(),
+        )
+        .expect("config selections");
+
+        assert_eq!(
+            selections,
+            vec![
+                CodexAcpConfigSelection {
+                    option_id: MODE_CONFIG_ID.to_owned(),
+                    value: CodexAcpConfigValue::Select(AGENT_MODE_ID.to_owned()),
+                },
+                CodexAcpConfigSelection {
+                    option_id: MODEL_CONFIG_ID.to_owned(),
+                    value: CodexAcpConfigValue::Select("gpt-5.3-codex".to_owned()),
+                },
+                CodexAcpConfigSelection {
+                    option_id: REASONING_EFFORT_CONFIG_ID.to_owned(),
+                    value: CodexAcpConfigValue::Select("high".to_owned()),
+                },
+                CodexAcpConfigSelection {
+                    option_id: FAST_MODE_CONFIG_ID.to_owned(),
+                    value: CodexAcpConfigValue::Boolean(true),
+                },
+            ]
+        );
+    }
+
+    #[test]
+    fn fast_mode_uses_select_values_for_clients_without_boolean_config_support() {
+        let mut advertisement = advertisement();
+        advertisement.config_options.insert(
+            FAST_MODE_CONFIG_ID.to_owned(),
+            CodexAcpConfigOptionKind::Select,
+        );
+
+        let selections = codex_acp_session_config(
+            &run_bound_binding(),
+            &CodexAcpSessionPreferences {
+                fast_mode: Some(false),
+                ..CodexAcpSessionPreferences::default()
+            },
+            &advertisement,
+        )
+        .expect("config selections");
+
+        assert_eq!(
+            selections.last(),
+            Some(&CodexAcpConfigSelection {
+                option_id: FAST_MODE_CONFIG_ID.to_owned(),
+                value: CodexAcpConfigValue::Select(FAST_MODE_OFF.to_owned()),
+            })
+        );
+    }
+
+    #[test]
+    fn missing_formal_config_option_fails_instead_of_falling_back_to_cli_flags() {
+        let mut advertisement = advertisement();
+        advertisement.config_options.remove(REASONING_EFFORT_CONFIG_ID);
+
+        let error = codex_acp_session_config(
+            &run_bound_binding(),
+            &CodexAcpSessionPreferences {
+                reasoning_effort: Some("high".to_owned()),
+                ..CodexAcpSessionPreferences::default()
+            },
+            &advertisement,
+        )
+        .expect_err("missing option must fail closed");
+
+        assert!(matches!(error, AcpRuntimeError::Unsupported(_)));
+    }
+
+    #[test]
+    fn authentication_diagnostic_names_only_advertised_provider_methods() {
+        let diagnostic = advertisement().authentication_required_diagnostic();
+        assert!(diagnostic.contains("api-key"));
+        assert!(diagnostic.contains("chat-gpt"));
+        assert!(!diagnostic.contains("secret"));
+    }
+}

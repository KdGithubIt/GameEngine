+/// Codex filesystem/process sandbox represented by the agent's ACP `mode` option.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CodexAcpSandboxMode {
+    /// Read-only provider sandbox.
+    ReadOnly,
+    /// Workspace-write provider sandbox.
+    WorkspaceWrite,
+}
+
+/// Provider policy selected from authoritative GameEngine ACP access.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct CodexAcpPolicy {
+    /// Approval behavior represented by the selected ACP mode.
+    pub(crate) approval: CodexAcpApprovalPolicy,
+    /// Provider sandbox represented by the selected ACP mode.
+    pub(crate) sandbox: CodexAcpSandboxMode,
+    /// ACP session-mode/config-option ID.
+    pub(crate) mode_id: &'static str,
+}
+
+/// Maps the authoritative GameEngine session binding to the narrowest Codex ACP
+/// provider mode that can serve it.
+///
+/// GameEngine never selects Codex ACP's `agent-full-access` mode. Provider
+/// sandboxing is defense in depth and does not replace the Host permission
+/// broker or the run-bound Editor MCP credential.
+pub(crate) fn codex_acp_policy(binding: &AcpSessionBinding) -> CodexAcpPolicy {
+    match binding.mcp.access {
+        AcpMcpAccessLevel::ReadOnly => CodexAcpPolicy {
+            approval: CodexAcpApprovalPolicy::OnRequest,
+            sandbox: CodexAcpSandboxMode::ReadOnly,
+            mode_id: READ_ONLY_MODE_ID,
+        },
+        AcpMcpAccessLevel::AgentRunBoundReadWrite => CodexAcpPolicy {
+            approval: CodexAcpApprovalPolicy::OnRequest,
+            sandbox: CodexAcpSandboxMode::WorkspaceWrite,
+            mode_id: AGENT_MODE_ID,
+        },
+    }
+}
+
+/// Probes the selected execution environment for the exact pinned Codex ACP
+/// executable/package.
+///
+/// The probe uses the same Windows launcher resolution and WSL placement as the
+/// existing external-agent path, so it predicts the process that integration
+/// will actually start.
+pub(crate) fn probe_codex_acp(
+    placement: &ExternalAgentExecutionPlacement,
+) -> CodexAcpProbe {
+    let availability = match command_output(
+        placement,
+        OsStr::new(CODEX_ACP_EXECUTABLE),
+        ["--version"],
+    ) {
+        Ok((true, output)) if output_reports_exact_version(&output) => {
+            CodexAcpAvailability::Available
+        }
+        Ok((true, output)) => CodexAcpAvailability::VersionMismatch {
+            expected: CODEX_ACP_PACKAGE_VERSION.to_owned(),
+            observed: extract_version(&output),
+        },
+        Ok((false, output)) => {
+            let detail = output.trim();
+            CodexAcpAvailability::ProbeFailed(if detail.is_empty() {
+                "`codex-acp --version` exited unsuccessfully".to_owned()
+            } else {
+                detail.to_owned()
+            })
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => CodexAcpAvailability::Missing,
+        Err(error) => CodexAcpAvailability::ProbeFailed(error.to_string()),
+    };
+    CodexAcpProbe {
+        availability,
+        installer_available: installer_is_available(placement),
+        expected_identity: AcpRuntimeIdentity::stable(
+            CODEX_ACP_PACKAGE_NAME,
+            Some(CODEX_ACP_PACKAGE_VERSION.to_owned()),
+        ),
+    }
+}
+
+/// Builds the pinned npm installation command for the selected execution
+/// environment.
+///
+/// This setup changes only the Codex ACP package. The legacy `@openai/codex`
+/// installation used by `codex exec --json` is intentionally left untouched.
+pub(crate) fn codex_acp_install_command(
+    placement: &ExternalAgentExecutionPlacement,
+) -> CodexAcpCommand {
+    let npm = match placement.environment {
+        ExternalAgentExecutionEnvironment::WindowsNative => "npm.cmd",
+        ExternalAgentExecutionEnvironment::Wsl2Linux => "npm",
+    };
+    let (program, arguments) = placed_launch_command(
+        placement,
+        OsString::from(npm),
+        vec![
+            OsString::from("install"),
+            OsString::from("-g"),
+            OsString::from(CODEX_ACP_INSTALL_PACKAGE),
+        ],
+    );
+    CodexAcpCommand {
+        program,
+        arguments,
+        environment: Vec::new(),
+    }
+}
+
+/// Builds the long-lived stdio ACP server command.
+///
+/// No provider credential or GameEngine MCP bearer token is placed in this
+/// command. Authentication is negotiated through ACP, and the shared ACP
+/// transport supplies the ephemeral Editor MCP connection when it opens a
+/// session.
+pub(crate) fn codex_acp_server_command(
+    placement: &ExternalAgentExecutionPlacement,
+    binding: &AcpSessionBinding,
+) -> CodexAcpCommand {
+    let (program, arguments) = placed_launch_command(
+        placement,
+        OsString::from(CODEX_ACP_EXECUTABLE),
+        Vec::new(),
+    );
+    let policy = codex_acp_policy(binding);
+    let mut environment = vec![(
+        OsString::from(INITIAL_AGENT_MODE_ENV),
+        OsString::from(policy.mode_id),
+    )];
+    if placement.environment == ExternalAgentExecutionEnvironment::Wsl2Linux {
+        let forwarding = wsl_environment_forwarding(&environment, &[]);
+        environment.push(forwarding);
+    }
+    CodexAcpCommand {
+        program,
+        arguments,
+        environment,
+    }
+}
+
+/// Verifies placement-specific prerequisites before the shared ACP transport
+/// opens a session.
+///
+/// The existing external-agent WSL probe is reused so the loopback Editor MCP
+/// endpoint is proven from the same distribution that will host `codex-acp`.
+/// Windows-native placement is a no-op.
+///
+/// # Errors
+///
+/// Returns the existing actionable WSL/MCP diagnostic when the selected
+/// distribution cannot reach the bound Editor MCP endpoint.
+pub(crate) fn preflight_codex_acp_session_environment(
+    placement: &ExternalAgentExecutionPlacement,
+    binding: &AcpSessionBinding,
+) -> Result<(), String> {
+    probe_wsl_loopback_reachability(
+        placement,
+        binding.mcp.endpoint(),
+        binding.mcp.authorization_token(),
+    )
+}
+
+/// Creates the immutable ACP descriptor after the shared transport has observed
+/// the agent's initialize advertisement.
+///
+/// # Errors
+///
+/// Returns an error if machine setup is not ready or if the initialized peer
+/// does not match the exact validated Codex ACP identity.
+pub(crate) fn codex_acp_descriptor(
+    probe: &CodexAcpProbe,
+    placement: &ExternalAgentExecutionPlacement,
+    advertisement: &CodexAcpAdvertisement,
+) -> Result<AcpAgentDescriptor, AcpRuntimeError> {
+    if !probe.is_available() {
+        return Err(AcpRuntimeError::Transport(
+            probe
+                .setup_diagnostic()
+                .unwrap_or_else(|| "Codex ACP setup is unavailable".to_owned()),
+        ));
+    }
+    advertisement.validate_exact_identity()?;
+
+    let (executable, arguments) = placed_launch_command(
+        placement,
+        OsString::from(CODEX_ACP_EXECUTABLE),
+        Vec::new(),
+    );
+    Ok(AcpAgentDescriptor {
+        id: CODEX_ACP_DESCRIPTOR_ID.to_owned(),
+        executable,
+        arguments,
+        capabilities: advertisement.normalized_capabilities(),
+        runtime_identity: AcpRuntimeIdentity {
+            protocol_version: advertisement.protocol_version,
+            agent_name: advertisement.agent_name.clone(),
+            agent_version: advertisement.agent_version.clone(),
+        },
+    })
+}
+
+/// Returns the complete logical-target mapping consumed by ACP integration.
+///
+/// # Errors
+///
+/// Returns the same setup or exact-identity error as [`codex_acp_descriptor`].
+pub(crate) fn codex_acp_registration(
+    probe: &CodexAcpProbe,
+    placement: &ExternalAgentExecutionPlacement,
+    advertisement: &CodexAcpAdvertisement,
+) -> Result<CodexAcpRegistration, AcpRuntimeError> {
+    Ok(CodexAcpRegistration {
+        logical_target: CODEX_ACP_LOGICAL_TARGET,
+        descriptor: codex_acp_descriptor(probe, placement, advertisement)?,
+    })
+}
+
+/// Maps GameEngine's authoritative ACP access and user model preferences to the
+/// session config options the Codex ACP peer actually advertised.
+///
+/// # Errors
+///
+/// Returns an unsupported-operation error when a requested mapping is not
+/// formally present in the advertisement. The adapter does not fall back to
+/// Codex CLI-only flags or invent a provider-specific permission scope.
+pub(crate) fn codex_acp_session_config(
+    binding: &AcpSessionBinding,
+    preferences: &CodexAcpSessionPreferences,
+    advertisement: &CodexAcpAdvertisement,
+) -> Result<Vec<CodexAcpConfigSelection>, AcpRuntimeError> {
+    let mut selections = Vec::new();
+    let policy = codex_acp_policy(binding);
+
+    require_select_option(advertisement, MODE_CONFIG_ID)?;
+    selections.push(CodexAcpConfigSelection {
+        option_id: MODE_CONFIG_ID.to_owned(),
+        value: CodexAcpConfigValue::Select(policy.mode_id.to_owned()),
+    });
+
+    if let Some(model) = non_empty_preference("model", preferences.model.as_deref())? {
+        require_select_option(advertisement, MODEL_CONFIG_ID)?;
+        selections.push(CodexAcpConfigSelection {
+            option_id: MODEL_CONFIG_ID.to_owned(),
+            value: CodexAcpConfigValue::Select(model.to_owned()),
+        });
+    }
+
+    if let Some(effort) =
+        non_empty_preference("reasoning effort", preferences.reasoning_effort.as_deref())?
+    {
+        require_select_option(advertisement, REASONING_EFFORT_CONFIG_ID)?;
+        selections.push(CodexAcpConfigSelection {
+            option_id: REASONING_EFFORT_CONFIG_ID.to_owned(),
+            value: CodexAcpConfigValue::Select(effort.to_owned()),
+        });
+    }
+
+    if let Some(enabled) = preferences.fast_mode {
+        let kind = advertisement
+            .config_options
+            .get(FAST_MODE_CONFIG_ID)
+            .copied()
+            .ok_or_else(|| unsupported_config(FAST_MODE_CONFIG_ID))?;
+        let value = match kind {
+            CodexAcpConfigOptionKind::Boolean => CodexAcpConfigValue::Boolean(enabled),
+            CodexAcpConfigOptionKind::Select => CodexAcpConfigValue::Select(
+                if enabled { FAST_MODE_ON } else { FAST_MODE_OFF }.to_owned(),
+            ),
+        };
+        selections.push(CodexAcpConfigSelection {
+            option_id: FAST_MODE_CONFIG_ID.to_owned(),
+            value,
+        });
+    }
+
+    Ok(selections)
+}
+
+fn require_select_option(
+    advertisement: &CodexAcpAdvertisement,
+    option_id: &str,
+) -> Result<(), AcpRuntimeError> {
+    match advertisement.config_options.get(option_id) {
+        Some(CodexAcpConfigOptionKind::Select) => Ok(()),
+        Some(CodexAcpConfigOptionKind::Boolean) => Err(AcpRuntimeError::Protocol(format!(
+            "Codex ACP advertised `{option_id}` with boolean type, but this mapping requires a select option"
+        ))),
+        None => Err(unsupported_config(option_id)),
+    }
+}
+
+fn unsupported_config(option_id: &str) -> AcpRuntimeError {
+    AcpRuntimeError::Unsupported(format!(
+        "Codex ACP did not advertise the `{option_id}` session config option"
+    ))
+}
+
+fn non_empty_preference<'a>(
+    name: &str,
+    value: Option<&'a str>,
+) -> Result<Option<&'a str>, AcpRuntimeError> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Err(AcpRuntimeError::Unsupported(format!(
+            "Codex ACP {name} preference must not be empty"
+        )));
+    }
+    Ok(Some(trimmed))
+}
+
+fn output_reports_exact_version(output: &str) -> bool {
+    extract_version(output).as_deref() == Some(CODEX_ACP_PACKAGE_VERSION)
+}
+
+fn extract_version(output: &str) -> Option<String> {
+    output
+        .split(|character: char| {
+            !(character.is_ascii_alphanumeric() || character == '.' || character == '-')
+        })
+        .map(|token| token.trim_start_matches('v'))
+        .find(|token| {
+            let mut parts = token.split('.');
+            let valid = (0..3).all(|_| {
+                parts
+                    .next()
+                    .is_some_and(|part| !part.is_empty() && part.chars().all(|c| c.is_ascii_digit()))
+            });
+            valid && parts.next().is_none()
+        })
+        .map(str::to_owned)
+}

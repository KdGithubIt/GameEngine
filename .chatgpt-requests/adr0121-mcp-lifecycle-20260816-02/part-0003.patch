+                    return write_json_rpc_error(
+                        &mut stream,
+                        id,
+                        -32603,
+                        "Editor authoring host timed out",
+                    );
+                }
+            }
+        }
+        _ => {
+            return write_json_rpc_error(&mut stream, id, -32601, "method not found");
+        }
+    };
+
+    write_json_rpc_result(&mut stream, id, result)
+}

+            prepare_game_commands(
+                &world,
+                &[GameCommand::play_spatial_sound_effect(
+                    stale,
+                    "asset_01JP0000000000000000000601",
+                    crate::game_io::GameSpatialAudioOptions::default(),
+                )],
+            ),

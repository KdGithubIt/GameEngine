+    pub(super) fn active_navigation_currentness_error(&self) -> Option<String> {
+        let project = self.project_root.as_ref()?;
+        let scene = self.session.scene()?;
+        let surface_type = engine_authoring::ComponentTypeId::new(
+            engine::scene_bridge::NAV_MESH_SURFACE_COMPONENT,
+        );
+        let (_, surface) = scene
+            .entities()
+            .find(|(_, entity)| entity.components.contains_key(&surface_type))?;
+        let source = match surface.components.get(&surface_type) {
+            Some(engine_authoring::Value::Object(fields)) => match fields.get("source") {
+                Some(engine_authoring::Value::AssetRef(asset)) => asset,
+                _ => {
+                    return Some(
+                        "navigation surface has no assigned NavMesh; bake navigation before continuing"
+                            .to_owned(),
+                    )
+                }
+            },
+            _ => {
+                return Some(
+                    "navigation surface value is invalid; repair it and rebake navigation"
+                        .to_owned(),
+                )
+            }
+        };
+        let scene_path = self.session.current_document_path()?;
+        let scene_stem = scene_path
+            .file_stem()
+            .and_then(|stem| stem.to_str())
+            .unwrap_or("arena")
+            .trim_end_matches(".scene");
+        let document_path = project
+            .assets_root()
+            .join("navigation")
+            .join(format!("{scene_stem}.navmesh.bake.json"));
+        let document_json = match std::fs::read_to_string(&document_path) {
+            Ok(json) => json,
+            Err(error) => {
+                return Some(format!(
+                    "navigation bake document {} is unavailable: {error}",
+                    document_path.display()
+                ))
+            }
+        };
+        let document = match crate::navmesh_shared::NavMeshBakeDocument::from_json(&document_json) {
+            Ok(document) => document,
+            Err(error) => {
+                return Some(format!(
+                    "navigation bake document {} is invalid: {error}",
+                    document_path.display()
+                ))
+            }
+        };
+        let Some(entry) = self.asset_manifest.get(source) else {
+            return Some(format!(
+                "navigation surface references unregistered asset `{}`",
+                source.as_str()
+            ));
+        };
+        if entry.path != document.output_asset {
+            return Some(format!(
+                "navigation surface uses `{}` but the active bake document outputs `{}`; rebake navigation",
+                entry.path, document.output_asset
+            ));
+        }
+        let asset_path = match project.resolve_asset(&entry.path) {
+            Ok(path) => path,
+            Err(error) => return Some(format!("navigation asset is unavailable: {error}")),
+        };
+        let nav_mesh = match std::fs::read_to_string(&asset_path)
+            .map_err(|error| error.to_string())
+            .and_then(|json| {
+                serde_json::from_str::<engine::navmesh::NavMesh>(&json)
+                    .map_err(|error| error.to_string())
+            })
+        {
+            Ok(nav_mesh) => nav_mesh,
+            Err(error) => {
+                return Some(format!(
+                    "navigation asset {} is invalid: {error}",
+                    asset_path.display()
+                ))
+            }
+        };
+        match crate::navmesh_shared::is_scene_navmesh_current(
+            scene,
+            project,
+            &self.asset_manifest,
+            &document,
+            &nav_mesh,
+        ) {
+            Ok(true) => None,
+            Ok(false) => {
+                Some("navigation bake is stale; rebake navigation before continuing".to_owned())
+            }
+            Err(error) => Some(format!("navigation currentness check failed: {error}")),
+        }
+    }

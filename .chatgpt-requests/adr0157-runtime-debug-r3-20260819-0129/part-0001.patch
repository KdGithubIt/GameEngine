+    #[test]
+    fn fixed_tick_plan_executes_and_releases_ai_owned_input() {
+        let mut runtime = runtime_fixture();
+        runtime.set_paused(true);
+        let plan = RuntimeDebugPlan::new(
+            vec![
+                RuntimeDebugScheduledInput::at_tick(
+                    0,
+                    InputCommand::Key {
+                        key: KeyCode::KeyW,
+                        pressed: true,
+                    },
+                )
+                .unwrap(),
+                RuntimeDebugScheduledInput::at_tick(
+                    2,
+                    InputCommand::Key {
+                        key: KeyCode::KeyW,
+                        pressed: false,
+                    },
+                )
+                .unwrap(),

+fn resolve_and_start_spatial(
+    asset_id: &str,
+    gains: StereoGains,
+    looping: bool,
+    audio: Option<&mut AudioSystem>,
+    server: Option<&mut AssetServer>,
+    manifest: Option<&AssetManifest>,

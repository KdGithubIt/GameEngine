+fn credential_io_error(error: io::Error) -> HostedBackendError {
+    HostedBackendError::new(
+        HostedFailureCategory::CredentialUnavailable,
+        false,
+        None,
+        format!("secure credential storage failed: {error}"),
+    )
+}

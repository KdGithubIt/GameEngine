+#[repr(C)]
+#[derive(Debug, Clone, Copy, Pod, Zeroable)]
+struct IblUniformData {
+    fallback_radiance: [f32; 4],
+    params: [f32; 4],
+}
+
+impl IblUniformData {
+    fn disabled() -> Self {
+        Self {
+            fallback_radiance: [0.0; 4],
+            params: [0.0; 4],
+        }
+    }
+
+    fn from_resources(
+        ambient: &AmbientLight,
+        environment: &EnvironmentLighting,
+        has_map: bool,
+        max_specular_lod: f32,
+    ) -> Self {
+        let color = environment.diffuse_color;
+        Self {
+            fallback_radiance: [
+                color.x,
+                color.y,
+                color.z,
+                ambient.intensity.max(0.0) * environment.intensity.max(0.0),
+            ],
+            params: [
+                f32::from(environment.diffuse_ibl_enabled),
+                f32::from(has_map),
+                max_specular_lod,
+                0.0,
+            ],
+        }
+    }
+}

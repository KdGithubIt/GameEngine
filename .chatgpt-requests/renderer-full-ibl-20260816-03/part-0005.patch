+    pub(crate) fn update_environment(
+        &mut self,
+        queue: &wgpu::Queue,
+        ambient: &AmbientLight,
+        environment: &EnvironmentLighting,
+        source: Option<&EnvironmentMap>,
+    ) {
+        let active_source = environment.diffuse_ibl_enabled.then_some(source).flatten();
+        self.ibl_environment.upload_if_changed(queue, active_source);
+        let uniform = IblUniformData::from_resources(
+            ambient,
+            environment,
+            self.ibl_environment.has_source(),
+            self.ibl_environment.max_specular_lod(),
+        );
+        queue.write_buffer(
+            &self.ibl_uniform_buffer,
+            0,
+            bytemuck::bytes_of(&uniform),
+        );
+    }

+impl GpuIblEnvironment {
+    pub(crate) fn new(device: &wgpu::Device) -> Self {
+        let irradiance_texture = create_cube(
+            device,
+            "IBL diffuse irradiance cube",
+            IRRADIANCE_CUBE_SIZE,
+            1,
+        );
+        let irradiance_view = cube_view(&irradiance_texture, "IBL diffuse irradiance cube view");
+        let mip_count = PREFILTERED_CUBE_SIZE.ilog2() + 1;
+        let prefiltered_texture = create_cube(
+            device,
+            "IBL prefiltered specular cube",
+            PREFILTERED_CUBE_SIZE,
+            mip_count,
+        );
+        let prefiltered_view =
+            cube_view(&prefiltered_texture, "IBL prefiltered specular cube view");
+        Self {
+            _irradiance_texture: irradiance_texture,
+            irradiance_view,
+            _prefiltered_texture: prefiltered_texture,
+            prefiltered_view,
+            source_key: None,
+        }
+    }
+
+    pub(crate) fn upload_if_changed(
+        &mut self,
+        queue: &wgpu::Queue,
+        source: Option<&EnvironmentMap>,
+    ) -> bool {
+        let Some(source) = source else {
+            let changed = self.source_key.take().is_some();
+            return changed;
+        };
+        if self.source_key == Some(source.content_key()) {
+            return false;
+        }
+
+        let baked = bake_environment(&LinearEnvironment::from_source(source.source()));
+        write_cube_mip(
+            queue,
+            &self._irradiance_texture,
+            0,
+            IRRADIANCE_CUBE_SIZE,
+            &rgba16_bytes(&baked.irradiance),
+        );
+        for (mip, pixels) in baked.specular_mips.iter().enumerate() {
+            let size = (PREFILTERED_CUBE_SIZE >> mip).max(1);
+            write_cube_mip(
+                queue,
+                &self._prefiltered_texture,
+                mip as u32,
+                size,
+                &rgba16_bytes(pixels),
+            );
+        }
+        self.source_key = Some(source.content_key());
+        true
+    }
+
+    pub(crate) fn has_source(&self) -> bool {
+        self.source_key.is_some()
+    }
+
+    pub(crate) fn max_specular_lod(&self) -> f32 {
+        PREFILTERED_CUBE_SIZE.ilog2() as f32
+    }
+}
+
+fn create_cube(device: &wgpu::Device, label: &str, size: u32, mip_level_count: u32) -> wgpu::Texture {
+    device.create_texture(&wgpu::TextureDescriptor {
+        label: Some(label),
+        size: wgpu::Extent3d {
+            width: size,
+            height: size,
+            depth_or_array_layers: 6,
+        },
+        mip_level_count,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: wgpu::TextureFormat::Rgba16Float,
+        usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+        view_formats: &[],
+    })
+}
+
+fn cube_view(texture: &wgpu::Texture, label: &str) -> wgpu::TextureView {
+    texture.create_view(&wgpu::TextureViewDescriptor {
+        label: Some(label),
+        dimension: Some(wgpu::TextureViewDimension::Cube),
+        ..Default::default()
+    })
+}
+
+fn write_cube_mip(
+    queue: &wgpu::Queue,
+    texture: &wgpu::Texture,
+    mip_level: u32,
+    size: u32,
+    bytes: &[u8],
+) {
+    queue.write_texture(
+        wgpu::TexelCopyTextureInfo {
+            texture,
+            mip_level,
+            origin: wgpu::Origin3d::ZERO,
+            aspect: wgpu::TextureAspect::All,
+        },
+        bytes,
+        wgpu::TexelCopyBufferLayout {
+            offset: 0,
+            bytes_per_row: Some(size * 8),
+            rows_per_image: Some(size),
+        },
+        wgpu::Extent3d {
+            width: size,
+            height: size,
+            depth_or_array_layers: 6,
+        },
+    );
+}
+
+/// Device-local split-sum BRDF integration texture shared by every environment.
+pub(crate) struct BrdfLut {
+    _texture: wgpu::Texture,
+    pub(crate) view: wgpu::TextureView,
+}
+
+impl BrdfLut {
+    pub(crate) fn new(device: &wgpu::Device, queue: &wgpu::Queue) -> Self {
+        static LUT_BYTES: OnceLock<Vec<u8>> = OnceLock::new();
+        let bytes = LUT_BYTES.get_or_init(brdf_lut_bytes);
+        let texture = device.create_texture_with_data(
+            queue,
+            &wgpu::TextureDescriptor {
+                label: Some("IBL split-sum BRDF LUT"),
+                size: wgpu::Extent3d {
+                    width: BRDF_LUT_SIZE,
+                    height: BRDF_LUT_SIZE,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rg16Float,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            },
+            wgpu::util::TextureDataOrder::MipMajor,
+            bytes,
+        );
+        let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+        Self {
+            _texture: texture,
+            view,
+        }
+    }
+}

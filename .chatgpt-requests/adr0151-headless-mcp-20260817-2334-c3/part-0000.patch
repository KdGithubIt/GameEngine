+//! Loopback Streamable HTTP transport shared by GameEngine MCP hosts.
+//!
+//! This module owns HTTP/JSON-RPC framing and authentication only. Authoring
+//! requests are dispatched to the application host through a channel.
+
+use engine_mcp::{authoring_tool_descriptors, McpToolDescriptor};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::fmt;
+use std::io::{self, Read, Write};
+use std::net::{Ipv4Addr, SocketAddr, TcpListener, TcpStream};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+/// MCP protocol version implemented by the local GameEngine host transport.
+pub const MCP_PROTOCOL_VERSION: &str = "2025-11-25";
+const MCP_PATH: &str = "/mcp";
+const MAX_HEADER_BYTES: usize = 32 * 1024;
+const MAX_BODY_BYTES: usize = 1024 * 1024;
+const IO_TIMEOUT: Duration = Duration::from_secs(5);
+const HOST_RESPONSE_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// Descriptive metadata returned from MCP `initialize`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct McpServerInfo {
+    name: String,
+    instructions: String,
+}
+
+impl McpServerInfo {
+    /// Creates server metadata with a stable implementation name and host-specific instructions.
+    pub fn new(name: impl Into<String>, instructions: impl Into<String>) -> Self {
+        Self {
+            name: name.into(),
+            instructions: instructions.into(),
+        }
+    }
+}
+
+/// Result returned by an application host for one MCP tool request.
+pub enum McpHostResult {
+    /// Successful structured tool result.
+    Success(Value),
+    /// Structured tool failure surfaced through MCP `isError`.
+    ToolError {
+        /// Stable diagnostic-style code.
+        code: String,
+        /// Human-readable error message.
+        message: String,
+    },
+}
+
+/// One tool invocation waiting to run against an application-owned authoring state.
+pub struct McpRequest {
+    name: String,
+    arguments: Value,
+    response: mpsc::SyncSender<McpHostResult>,
+}
+
+impl McpRequest {
+    /// Returns the requested MCP tool name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Returns the structured tool arguments.
+    pub fn arguments(&self) -> &Value {
+        &self.arguments
+    }
+
+    /// Completes this request with the application host result.
+    pub fn respond(self, result: McpHostResult) {
+        let _ = self.response.send(result);
+    }
+}
+
+/// Failure to start a local MCP transport.
+#[derive(Debug)]
+pub enum McpServerError {
+    /// Loopback bind failed.
+    Bind(io::Error),
+    /// Listener configuration failed.
+    Configure(io::Error),
+    /// Session credential generation failed.
+    Random(String),
+    /// Listener thread creation failed.
+    Thread(io::Error),
+}
+
+impl fmt::Display for McpServerError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Bind(error) => write!(formatter, "could not bind MCP loopback endpoint: {error}"),
+            Self::Configure(error) => write!(formatter, "could not configure MCP loopback endpoint: {error}"),
+            Self::Random(error) => write!(formatter, "could not create MCP session credential: {error}"),
+            Self::Thread(error) => write!(formatter, "could not start MCP listener thread: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for McpServerError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Bind(error) | Self::Configure(error) | Self::Thread(error) => Some(error),
+            Self::Random(_) => None,
+        }
+    }
+}
+
+/// Running loopback-only MCP server.
+pub struct McpServer {
+    local_addr: SocketAddr,
+    endpoint: String,
+    authorization_token: String,
+    shutdown: Arc<AtomicBool>,
+    listener_thread: Option<JoinHandle<()>>,
+}
+
+impl McpServer {
+    /// Starts the authenticated loopback transport and returns its host request receiver.
+    ///
+    /// `wake_host` is called after a tool request is queued. GUI hosts can use
+    /// it to request a frame; blocking headless hosts normally pass a no-op.
+    pub fn start<F>(
+        server_info: McpServerInfo,
+        wake_host: F,
+    ) -> Result<(Self, mpsc::Receiver<McpRequest>), McpServerError>
+    where
+        F: Fn() + Send + Sync + 'static,
+    {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).map_err(McpServerError::Bind)?;
+        listener
+            .set_nonblocking(true)
+            .map_err(McpServerError::Configure)?;
+        let local_addr = listener.local_addr().map_err(McpServerError::Configure)?;
+        let endpoint = format!("http://{local_addr}{MCP_PATH}");
+        let authorization_token = new_authorization_token()?;
+        let worker_token = authorization_token.clone();
+        let shutdown = Arc::new(AtomicBool::new(false));
+        let worker_shutdown = Arc::clone(&shutdown);
+        let wake_host: Arc<dyn Fn() + Send + Sync> = Arc::new(wake_host);
+        let (request_sender, request_receiver) = mpsc::channel();
+
+        let listener_thread = thread::Builder::new()
+            .name(format!("{}-mcp", server_info.name))
+            .spawn(move || {
+                serve_loop(
+                    listener,
+                    worker_token,
+                    request_sender,
+                    wake_host,
+                    server_info,
+                    worker_shutdown,
+                );
+            })
+            .map_err(McpServerError::Thread)?;
+
+        Ok((
+            Self {
+                local_addr,
+                endpoint,
+                authorization_token,
+                shutdown,
+                listener_thread: Some(listener_thread),
+            },
+            request_receiver,
+        ))
+    }
+
+    /// Returns the loopback Streamable HTTP endpoint URL.
+    pub fn endpoint(&self) -> &str {
+        &self.endpoint
+    }
+
+    /// Returns the process-local bearer credential required by the endpoint.
+    pub fn authorization_token(&self) -> &str {
+        &self.authorization_token
+    }
+}
+
+impl Drop for McpServer {
+    fn drop(&mut self) {
+        self.shutdown.store(true, Ordering::Release);
+        let _ = TcpStream::connect_timeout(&self.local_addr, Duration::from_millis(100));
+        if let Some(thread) = self.listener_thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+fn new_authorization_token() -> Result<String, McpServerError> {
+    let mut bytes = [0_u8; 32];
+    getrandom::fill(&mut bytes).map_err(|error| McpServerError::Random(error.to_string()))?;
+    let mut token = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        use std::fmt::Write as _;
+        write!(&mut token, "{byte:02x}").expect("writing hexadecimal text into String cannot fail");
+    }
+    Ok(token)
+}
+
+fn serve_loop(
+    listener: TcpListener,
+    authorization_token: String,
+    request_sender: mpsc::Sender<McpRequest>,
+    wake_host: Arc<dyn Fn() + Send + Sync>,
+    server_info: McpServerInfo,
+    shutdown: Arc<AtomicBool>,
+) {
+    while !shutdown.load(Ordering::Acquire) {
+        match listener.accept() {
+            Ok((stream, _peer)) => {
+                if shutdown.load(Ordering::Acquire) {
+                    break;
+                }
+                let token = authorization_token.clone();
+                let sender = request_sender.clone();
+                let wake = Arc::clone(&wake_host);
+                let info = server_info.clone();
+                let thread_name = format!("{}-mcp-request", server_info.name);
+                let _ = thread::Builder::new().name(thread_name).spawn(move || {
+                    let _ = handle_connection(stream, &token, &sender, &wake, &info);
+                });
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                thread::sleep(Duration::from_millis(10));
+            }
+            Err(_) => break,
+        }
+    }
+}
+
+fn handle_connection(
+    mut stream: TcpStream,
+    authorization_token: &str,
+    request_sender: &mpsc::Sender<McpRequest>,
+    wake_host: &Arc<dyn Fn() + Send + Sync>,
+    server_info: &McpServerInfo,
+) -> io::Result<()> {
+    stream.set_read_timeout(Some(IO_TIMEOUT))?;
+    stream.set_write_timeout(Some(IO_TIMEOUT))?;
+
+    let request = match read_http_request(&mut stream) {
+        Ok(request) => request,
+        Err(HttpReadError::RequestTooLarge) => return write_http_response(&mut stream, 413, "text/plain", b"request too large"),
+        Err(HttpReadError::LengthRequired) => return write_http_response(&mut stream, 411, "text/plain", b"content length required"),
+        Err(HttpReadError::UnsupportedTransferEncoding) => return write_http_response(&mut stream, 501, "text/plain", b"transfer encoding is not supported"),
+        Err(HttpReadError::BadRequest) => return write_http_response(&mut stream, 400, "text/plain", b"bad request"),
+        Err(HttpReadError::Io(error)) => return Err(error),
+    };
+
+    let path = request.path.split('?').next().unwrap_or(request.path.as_str());
+    if path != MCP_PATH {
+        return write_http_response(&mut stream, 404, "text/plain", b"not found");
+    }
+    if request.headers.get("origin").is_some_and(|origin| !origin_is_loopback(origin)) {
+        return write_http_response(&mut stream, 403, "text/plain", b"forbidden origin");
+    }
+    let expected_authorization = format!("Bearer {authorization_token}");
+    if request.headers.get("authorization") != Some(&expected_authorization) {
+        return write_http_response(&mut stream, 401, "text/plain", b"unauthorized");
+    }
+    match request.method.as_str() {
+        "GET" => return write_http_response(&mut stream, 405, "text/plain", b"server-sent event stream is not enabled"),
+        "POST" => {}
+        _ => return write_http_response(&mut stream, 405, "text/plain", b"method not allowed"),
+    }
+    if !request.headers.get("content-type").is_some_and(|value| value.to_ascii_lowercase().starts_with("application/json")) {
+        return write_http_response(&mut stream, 415, "text/plain", b"application/json is required");
+    }
+    let accepts = request.headers.get("accept").map(|value| value.to_ascii_lowercase()).unwrap_or_default();
+    if !accepts.contains("application/json") || !accepts.contains("text/event-stream") {

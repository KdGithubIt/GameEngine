+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(runtime_io(error)),
+        }
+        if environment == ManagedExecutionEnvironment::Wsl2Linux {
+            self.clear_restart_required()?;
+        }
+        Ok(())
+    }

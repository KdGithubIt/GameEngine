+/// Typed operation carried by one VFX module.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum VfxModuleOperation {
+    /// Continuously emits particles at a rate per second.
+    SpawnRate {
+        /// Authored emission rate in particles per second.
+        particles_per_second: f32,
+    },
+    /// Emits one deterministic burst at an emitter-local time.
+    Burst {
+        /// Emitter-local burst time in seconds.
+        time: f32,
+        /// Number of particles requested by the burst.
+        count: u32,
+    },
+    /// Chooses the spawn volume for subsequent particles.
+    Shape {
+        /// Authored spawn shape.
+        shape: VfxShape,
+    },
+    /// Chooses particle lifetime at spawn.
+    Lifetime {
+        /// Lifetime in seconds.
+        value: VfxScalarValue,
+    },
+    /// Chooses initial speed along the direction produced by the active shape.
+    ///
+    /// This keeps the simple-emitter cone contract on the same compiled IR as
+    /// advanced effects without introducing a second runtime simulator.
+    InitialSpeed {
+        /// Initial speed in units per second.
+        value: VfxScalarValue,
+    },
+    /// Chooses initial local velocity at spawn, replacing shape-directed speed.
+    InitialVelocity {
+        /// Initial XYZ velocity in units per second.
+        value: VfxVectorValue,
+    },
+    /// Chooses initial linear RGBA color.
+    InitialColor {
+        /// Linear RGBA spawn color.
+        color: [f32; 4],
+    },
+    /// Chooses initial uniform size.
+    InitialSize {
+        /// Uniform spawn size.
+        value: VfxScalarValue,
+    },
+    /// Chooses initial billboard or mesh rotation in radians.
+    InitialRotation {
+        /// Spawn rotation in radians.
+        value: VfxScalarValue,
+    },
+    /// Applies a constant world-space acceleration every update.
+    Force {
+        /// XYZ acceleration in units per second squared.
+        acceleration: [f32; 3],
+    },
+    /// Applies velocity-proportional drag every update.
+    Drag {
+        /// Non-negative drag coefficient.
+        coefficient: f32,
+    },
+    /// Replaces particle color from a normalized-lifetime gradient.
+    ColorOverLife {
+        /// Linear RGBA gradient.
+        gradient: VfxGradient,
+    },
+    /// Multiplies particle size by a normalized-lifetime curve.
+    SizeOverLife {
+        /// Uniform size multiplier curve.
+        curve: VfxCurve,
+    },
+    /// Adds rotation sampled from a normalized-lifetime curve.
+    RotationOverLife {
+        /// Rotation in radians over normalized lifetime.
+        curve: VfxCurve,
+    },
+    /// Renders particles as camera-facing quads.
+    Billboard {
+        /// Optional material asset used by this output.
+        material: Option<AssetId>,
+        /// Optional texture-sheet animation.
+        texture_sheet: Option<VfxTextureSheet>,
+    },
+    /// Renders particles as instanced meshes.
+    Mesh {
+        /// Mesh asset drawn for each particle.
+        mesh: AssetId,
+        /// Optional material asset used by this output.
+        material: Option<AssetId>,
+        /// Optional texture-sheet animation.
+        texture_sheet: Option<VfxTextureSheet>,
+    },
+}
+
+impl VfxModuleOperation {
+    /// Returns the stable engine-owned module type identifier.
+    pub fn type_id(&self) -> &'static str {
+        match self {
+            Self::SpawnRate { .. } => "engine.vfx.spawn_rate",
+            Self::Burst { .. } => "engine.vfx.burst",
+            Self::Shape { .. } => "engine.vfx.shape",
+            Self::Lifetime { .. } => "engine.vfx.lifetime",
+            Self::InitialSpeed { .. } => "engine.vfx.initial_speed",
+            Self::InitialVelocity { .. } => "engine.vfx.initial_velocity",
+            Self::InitialColor { .. } => "engine.vfx.initial_color",
+            Self::InitialSize { .. } => "engine.vfx.initial_size",
+            Self::InitialRotation { .. } => "engine.vfx.initial_rotation",
+            Self::Force { .. } => "engine.vfx.force",
+            Self::Drag { .. } => "engine.vfx.drag",
+            Self::ColorOverLife { .. } => "engine.vfx.color_over_life",
+            Self::SizeOverLife { .. } => "engine.vfx.size_over_life",
+            Self::RotationOverLife { .. } => "engine.vfx.rotation_over_life",
+            Self::Billboard { .. } => "engine.vfx.billboard",
+            Self::Mesh { .. } => "engine.vfx.mesh",
+        }
+    }
+
+    /// Returns the only valid execution phase for this operation.
+    pub fn required_phase(&self) -> VfxPhase {
+        match self {
+            Self::SpawnRate { .. }
+            | Self::Burst { .. }
+            | Self::Shape { .. }
+            | Self::Lifetime { .. }
+            | Self::InitialSpeed { .. }
+            | Self::InitialVelocity { .. }
+            | Self::InitialColor { .. }
+            | Self::InitialSize { .. }
+            | Self::InitialRotation { .. } => VfxPhase::Spawn,
+            Self::Force { .. }
+            | Self::Drag { .. }
+            | Self::ColorOverLife { .. }
+            | Self::SizeOverLife { .. }
+            | Self::RotationOverLife { .. } => VfxPhase::Update,
+            Self::Billboard { .. } | Self::Mesh { .. } => VfxPhase::Render,
+        }
+    }
+}
+
+/// One ordered typed module in a VFX emitter.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxModule {
+    /// Stable module identifier used by diagnostics and granular edits.
+    pub id: VfxModuleId,
+    /// Explicit execution phase. Validation rejects phase/type mismatches.
+    pub phase: VfxPhase,
+    /// Whether this module participates in compilation.
+    pub enabled: bool,
+    /// Typed engine-owned operation and properties.
+    pub operation: VfxModuleOperation,

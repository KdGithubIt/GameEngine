+/// Stable deterministic random-stream selector used by authored ranges.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(transparent)]
+pub struct VfxRandomChannel(u32);
+
+impl VfxRandomChannel {
+    /// Creates a deterministic random channel from its stable numeric index.
+    pub const fn new(index: u32) -> Self {
+        Self(index)
+    }
+
+    /// Returns the stable numeric channel index.
+    pub const fn index(self) -> u32 {
+        self.0
+    }
+}
+
+/// A scalar authored either as a constant or deterministic random range.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "mode", rename_all = "snake_case")]
+pub enum VfxScalarValue {
+    /// Uses one constant value for every particle.
+    Constant {
+        /// Authored scalar value.
+        value: f32,
+    },
+    /// Samples uniformly from an inclusive range using a named random channel.
+    Range {
+        /// Inclusive minimum value.
+        min: f32,
+        /// Inclusive maximum value.
+        max: f32,
+        /// Deterministic random channel used for the sample.
+        channel: VfxRandomChannel,
+    },
+}
+
+impl VfxScalarValue {
+    /// Returns the greatest possible authored value.
+    pub fn maximum(&self) -> f32 {
+        match self {
+            Self::Constant { value } => *value,
+            Self::Range { max, .. } => *max,
+        }
+    }
+
+    fn validate(&self) -> bool {
+        match self {
+            Self::Constant { value } => value.is_finite(),
+            Self::Range { min, max, .. } => min.is_finite() && max.is_finite() && min <= max,
+        }
+    }
+}
+
+/// A 3D vector authored either as a constant or per-axis deterministic range.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "mode", rename_all = "snake_case")]
+pub enum VfxVectorValue {
+    /// Uses one constant vector.
+    Constant {
+        /// Authored XYZ vector.
+        value: [f32; 3],
+    },
+    /// Samples each axis between `min` and `max` using one deterministic channel.
+    Range {
+        /// Inclusive per-axis minima.
+        min: [f32; 3],
+        /// Inclusive per-axis maxima.
+        max: [f32; 3],
+        /// Deterministic random channel used for the sample.
+        channel: VfxRandomChannel,
+    },
+}
+
+impl VfxVectorValue {
+    fn validate(&self) -> bool {
+        match self {
+            Self::Constant { value } => finite3(*value),
+            Self::Range { min, max, .. } => {
+                finite3(*min)
+                    && finite3(*max)
+                    && min.iter().zip(max).all(|(min, max)| min <= max)
+            }
+        }
+    }
+}
+
+/// Interpolation mode between two scalar curve keys.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum VfxCurveInterpolation {
+    /// Holds the left key value until the next key.
+    Step,
+    /// Linearly interpolates between key values.
+    Linear,
+}
+
+/// One stable scalar-curve key on normalized particle lifetime.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxCurveKey {
+    /// Stable key identifier preserved when the key is moved.
+    pub id: VfxCurveKeyId,
+    /// Normalized lifetime position in `[0, 1]`.
+    pub time: f32,
+    /// Scalar value at this key.
+    pub value: f32,
+    /// Interpolation leaving this key.
+    pub interpolation: VfxCurveInterpolation,
+}
+
+/// Ordered scalar curve evaluated over normalized particle lifetime.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxCurve {
+    /// Strictly time-ordered curve keys.
+    pub keys: Vec<VfxCurveKey>,
+}
+
+impl VfxCurve {
+    /// Creates a constant two-key curve spanning normalized lifetime.
+    pub fn constant(value: f32) -> Self {
+        Self {
+            keys: vec![
+                VfxCurveKey {
+                    id: VfxCurveKeyId::generate(),
+                    time: 0.0,
+                    value,
+                    interpolation: VfxCurveInterpolation::Linear,
+                },
+                VfxCurveKey {
+                    id: VfxCurveKeyId::generate(),
+                    time: 1.0,
+                    value,
+                    interpolation: VfxCurveInterpolation::Linear,
+                },
+            ],
+        }
+    }
+
+    /// Evaluates the curve at normalized lifetime `time`.
+    ///
+    /// Values outside `[0, 1]` are clamped to the curve's endpoints. Invalid
+    /// curves return `0.0`; callers should normally validate the document first.
+    pub fn evaluate(&self, time: f32) -> f32 {
+        let Some(first) = self.keys.first() else {
+            return 0.0;
+        };
+        if time <= first.time {
+            return first.value;
+        }
+        let Some(last) = self.keys.last() else {
+            return first.value;
+        };
+        if time >= last.time {
+            return last.value;
+        }
+        for pair in self.keys.windows(2) {
+            let left = &pair[0];
+            let right = &pair[1];
+            if time <= right.time {
+                return match left.interpolation {
+                    VfxCurveInterpolation::Step => left.value,
+                    VfxCurveInterpolation::Linear => {
+                        let span = right.time - left.time;
+                        if span <= f32::EPSILON {
+                            right.value
+                        } else {
+                            let factor = ((time - left.time) / span).clamp(0.0, 1.0);
+                            left.value + (right.value - left.value) * factor
+                        }
+                    }
+                };
+            }
+        }
+        last.value
+    }
+
+    fn is_valid(&self) -> bool {
+        if self.keys.is_empty() {
+            return false;
+        }
+        let mut ids = BTreeSet::new();
+        let mut previous = -1.0_f32;
+        for key in &self.keys {
+            if !ids.insert(key.id.clone())
+                || !key.time.is_finite()
+                || !(0.0..=1.0).contains(&key.time)
+                || key.time <= previous
+                || !key.value.is_finite()
+            {
+                return false;
+            }
+            previous = key.time;
+        }
+        true
+    }
+}
+
+/// One stable color-gradient key on normalized particle lifetime.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxGradientKey {
+    /// Stable key identifier preserved when the key is moved.
+    pub id: VfxGradientKeyId,
+    /// Normalized lifetime position in `[0, 1]`.
+    pub time: f32,
+    /// Linear RGBA color at this key.
+    pub color: [f32; 4],
+}
+
+/// Ordered color gradient evaluated over normalized particle lifetime.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VfxGradient {
+    /// Strictly time-ordered color keys.
+    pub keys: Vec<VfxGradientKey>,
+}
+
+impl VfxGradient {
+    /// Creates a two-key gradient between `start` and `end`.
+    pub fn linear(start: [f32; 4], end: [f32; 4]) -> Self {
+        Self {
+            keys: vec![
+                VfxGradientKey {
+                    id: VfxGradientKeyId::generate(),
+                    time: 0.0,
+                    color: start,
+                },
+                VfxGradientKey {
+                    id: VfxGradientKeyId::generate(),
+                    time: 1.0,
+                    color: end,
+                },
+            ],
+        }
+    }
+
+    /// Evaluates the gradient at normalized lifetime `time`.
+    ///
+    /// Values outside `[0, 1]` are clamped to the gradient's endpoints. Invalid
+    /// gradients return transparent black; callers should validate first.
+    pub fn evaluate(&self, time: f32) -> [f32; 4] {
+        let Some(first) = self.keys.first() else {
+            return [0.0; 4];
+        };
+        if time <= first.time {
+            return first.color;
+        }
+        let Some(last) = self.keys.last() else {
+            return first.color;
+        };
+        if time >= last.time {
+            return last.color;
+        }
+        for pair in self.keys.windows(2) {
+            let left = &pair[0];
+            let right = &pair[1];
+            if time <= right.time {
+                let span = right.time - left.time;
+                let factor = if span <= f32::EPSILON {
+                    1.0
+                } else {
+                    ((time - left.time) / span).clamp(0.0, 1.0)
+                };
+                let mut color = [0.0; 4];
+                for (index, value) in color.iter_mut().enumerate() {
+                    *value = left.color[index] + (right.color[index] - left.color[index]) * factor;
+                }
+                return color;
+            }
+        }
+        last.color
+    }
+
+    fn is_valid(&self) -> bool {
+        if self.keys.is_empty() {
+            return false;
+        }
+        let mut ids = BTreeSet::new();
+        let mut previous = -1.0_f32;
+        for key in &self.keys {
+            if !ids.insert(key.id.clone())
+                || !key.time.is_finite()
+                || !(0.0..=1.0).contains(&key.time)
+                || key.time <= previous
+                || !finite4(key.color)
+            {
+                return false;
+            }
+            previous = key.time;
+        }
+        true
+    }
+}
+
+/// Spawn volume used by the shape module.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "shape", rename_all = "snake_case")]
+pub enum VfxShape {
+    /// Spawns at the emitter origin.
+    Point,
+    /// Spawns inside an axis-aligned box centered on the emitter.
+    Box {
+        /// Positive XYZ half-extents.
+        half_extents: [f32; 3],
+    },
+    /// Spawns inside a sphere centered on the emitter.
+    Sphere {
+        /// Non-negative sphere radius.
+        radius: f32,
+    },
+    /// Spawns inside a cone oriented by a local direction.
+    Cone {
+        /// Local cone axis; zero vectors are invalid.
+        direction: [f32; 3],
+        /// Half-angle in radians in `[0, pi/2)`.
+        angle_radians: f32,
+        /// Non-negative radius at the cone base.
+        radius: f32,
+    },
+}
+
+impl VfxShape {
+    fn validate(&self) -> bool {
+        match self {
+            Self::Point => true,
+            Self::Box { half_extents } => {
+                finite3(*half_extents) && half_extents.iter().all(|value| *value >= 0.0)
+            }
+            Self::Sphere { radius } => radius.is_finite() && *radius >= 0.0,
+            Self::Cone {
+                direction,
+                angle_radians,
+                radius,
+            } => {
+                finite3(*direction)
+                    && direction.iter().any(|value| value.abs() > f32::EPSILON)
+                    && angle_radians.is_finite()
+                    && (0.0..std::f32::consts::FRAC_PI_2).contains(angle_radians)
+                    && radius.is_finite()
+                    && *radius >= 0.0
+            }
+        }
+    }
+}

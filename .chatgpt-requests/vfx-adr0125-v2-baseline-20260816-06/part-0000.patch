+pub struct VfxAuthoringService;
+
+impl VfxAuthoringService {
+    /// Creates the shared authoring service.
+    pub fn new() -> Self {
+        Self
+    }
+
+    /// Returns the deterministic VFX module schema catalog.
+    pub fn schemas(&self) -> VfxSchemaCatalog {
+        let modules = [
+            ("engine.vfx.spawn_rate", "Spawn Rate", "Emission", VfxPhase::Spawn),
+            ("engine.vfx.burst", "Burst", "Emission", VfxPhase::Spawn),
+            ("engine.vfx.shape", "Shape", "Spawn", VfxPhase::Spawn),
+            ("engine.vfx.lifetime", "Lifetime", "Spawn", VfxPhase::Spawn),
+            (
+                "engine.vfx.initial_speed",
+                "Initial Speed",
+                "Spawn",
+                VfxPhase::Spawn,
+            ),
+            (
+                "engine.vfx.initial_velocity",
+                "Initial Velocity",
+                "Spawn",
+                VfxPhase::Spawn,
+            ),
+            (
+                "engine.vfx.initial_color",
+                "Initial Color",
+                "Spawn",
+                VfxPhase::Spawn,
+            ),
+            (
+                "engine.vfx.initial_size",
+                "Initial Size",
+                "Spawn",
+                VfxPhase::Spawn,
+            ),
+            (
+                "engine.vfx.initial_rotation",
+                "Initial Rotation",
+                "Spawn",
+                VfxPhase::Spawn,
+            ),
+            ("engine.vfx.force", "Force", "Motion", VfxPhase::Update),
+            ("engine.vfx.drag", "Drag", "Motion", VfxPhase::Update),
+            (
+                "engine.vfx.color_over_life",
+                "Color Over Life",
+                "Over Life",
+                VfxPhase::Update,
+            ),
+            (
+                "engine.vfx.size_over_life",
+                "Size Over Life",
+                "Over Life",
+                VfxPhase::Update,
+            ),
+            (
+                "engine.vfx.rotation_over_life",
+                "Rotation Over Life",
+                "Over Life",
+                VfxPhase::Update,
+            ),
+            (
+                "engine.vfx.billboard",
+                "Billboard Renderer",
+                "Render",
+                VfxPhase::Render,
+            ),
+            (
+                "engine.vfx.mesh",
+                "Mesh Renderer",
+                "Render",
+                VfxPhase::Render,
+            ),
+        ]
+        .into_iter()
+        .map(|(type_id, display_name, category, phase)| VfxModuleSchema {
+            type_id: type_id.to_owned(),
+            display_name: display_name.to_owned(),
+            category: category.to_owned(),
+            phase,
+        })
+        .collect();
+        VfxSchemaCatalog {
+            schema_version: VFX_SCHEMA_VERSION,
+            modules,
+        }
+    }
+
+    /// Parses and validates a current-format VFX JSON document.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`VfxDocumentError`] for malformed JSON, unsupported versions,
+    /// or blocking semantic diagnostics.
+    pub fn effect_from_json(&self, json: &str) -> Result<VfxEffect, VfxDocumentError> {
+        #[derive(Deserialize)]
+        struct VersionProbe {
+            schema_version: u32,
+        }
+
+        let version: VersionProbe = serde_json::from_str(json).map_err(VfxDocumentError::Json)?;
+        if version.schema_version != VFX_SCHEMA_VERSION {
+            return Err(VfxDocumentError::UnsupportedVersion {
+                found: version.schema_version,
+            });
+        }
+        let effect: VfxEffect = serde_json::from_str(json).map_err(VfxDocumentError::Json)?;
+        let validation = self.validate(&effect);
+        if validation.success {
+            Ok(effect)
+        } else {
+            Err(VfxDocumentError::Invalid {
+                diagnostics: validation
+                    .diagnostics
+                    .into_iter()
+                    .filter(VfxDiagnostic::is_blocking)
+                    .collect(),
+            })
+        }
+    }
+
+    /// Serializes a validated VFX document as deterministic pretty JSON.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`VfxDocumentError::Invalid`] when semantic validation fails or
+    /// [`VfxDocumentError::Json`] if serialization unexpectedly fails.
+    pub fn effect_to_canonical_json(&self, effect: &VfxEffect) -> Result<String, VfxDocumentError> {
+        let validation = self.validate(effect);
+        if !validation.success {
+            return Err(VfxDocumentError::Invalid {
+                diagnostics: validation
+                    .diagnostics
+                    .into_iter()
+                    .filter(VfxDiagnostic::is_blocking)
+                    .collect(),
+            });
+        }
+        let mut json = serde_json::to_string_pretty(effect).map_err(VfxDocumentError::Json)?;
+        json.push('\n');
+        Ok(json)
+    }
+
+    /// Validates one VFX document and returns stable-ID-addressable diagnostics.
+    pub fn validate(&self, effect: &VfxEffect) -> VfxValidation {
+        let mut diagnostics = Vec::new();
+        if effect.schema_version != VFX_SCHEMA_VERSION {
+            diagnostics.push(VfxDiagnostic::error(
+                "vfx.unsupported_version",
+                format!(
+                    "schema version {} is unsupported; expected {VFX_SCHEMA_VERSION}",
+                    effect.schema_version
+                ),
+                None,
+                None,
+            ));
+        }
+        if effect.name.trim().is_empty() {
+            diagnostics.push(VfxDiagnostic::error(
+                "vfx.blank_name",
+                "effect name must not be blank",
+                None,
+                None,
+            ));
+        }
+        if effect.max_particles == 0 {
+            diagnostics.push(VfxDiagnostic::error(
+                "vfx.zero_effect_budget",
+                "effect max_particles must be greater than zero",
+                None,
+                None,
+            ));
+        }
+        if effect.emitters.is_empty() {
+            diagnostics.push(VfxDiagnostic::warning(
+                "vfx.no_emitters",
+                "effect contains no emitters",
+                None,
+                None,
+            ));
+        }
+
+        let mut emitter_ids = BTreeSet::new();
+        let mut module_ids = BTreeSet::new();
+        let mut total_budget = 0_u64;
+        for emitter in &effect.emitters {
+            if !emitter_ids.insert(emitter.id.clone()) {
+                diagnostics.push(VfxDiagnostic::error(
+                    "vfx.duplicate_emitter_id",
+                    format!("emitter ID `{}` is duplicated", emitter.id),
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+            if emitter.name.trim().is_empty() {
+                diagnostics.push(VfxDiagnostic::error(
+                    "vfx.blank_emitter_name",
+                    "emitter name must not be blank",
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+            if emitter.max_particles == 0 {
+                diagnostics.push(VfxDiagnostic::error(
+                    "vfx.zero_emitter_budget",
+                    "emitter max_particles must be greater than zero",
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+            total_budget = total_budget.saturating_add(u64::from(emitter.max_particles));
+
+            let mut render_count = 0_u32;
+            for module in &emitter.modules {
+                if !module_ids.insert(module.id.clone()) {
+                    diagnostics.push(VfxDiagnostic::error(
+                        "vfx.duplicate_module_id",
+                        format!("module ID `{}` is duplicated", module.id),
+                        Some(&emitter.id),
+                        Some(&module.id),
+                    ));
+                }
+                if module.phase != module.operation.required_phase() {
+                    diagnostics.push(VfxDiagnostic::error(
+                        "vfx.phase_mismatch",
+                        format!(
+                            "module `{}` is in {:?} but `{}` requires {:?}",
+                            module.id,
+                            module.phase,
+                            module.operation.type_id(),
+                            module.operation.required_phase()
+                        ),
+                        Some(&emitter.id),
+                        Some(&module.id),
+                    ));
+                }
+                validate_operation(emitter, module, &mut diagnostics);
+                if module.enabled && module.phase == VfxPhase::Render {
+                    render_count = render_count.saturating_add(1);
+                }
+            }
+            if emitter.enabled && render_count == 0 {
+                diagnostics.push(VfxDiagnostic::warning(
+                    "vfx.no_renderer",
+                    "enabled emitter has no enabled render module",
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+
+            let estimated = estimate_capacity(emitter);
+            if estimated > emitter.max_particles {
+                diagnostics.push(VfxDiagnostic::warning(
+                    "vfx.emitter_budget_exceeded",
+                    format!(
+                        "authored rate, bursts, and lifetime imply about {estimated} particles, capped to {}",
+                        emitter.max_particles
+                    ),
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+        }
+        if total_budget > u64::from(effect.max_particles) {
+            diagnostics.push(VfxDiagnostic::warning(
+                "vfx.effect_budget_exceeded",
+                format!(
+                    "emitter budgets total {total_budget}, exceeding effect cap {}",
+                    effect.max_particles
+                ),
+                None,
+                None,
+            ));
+        }
+
+        VfxValidation {
+            success: !diagnostics.iter().any(VfxDiagnostic::is_blocking),
+            diagnostics,
+        }
+    }
+
+    /// Validates and compiles a VFX document to backend-neutral runtime IR.
+    pub fn compile(&self, effect: &VfxEffect) -> VfxCompilation {
+        let validation = self.validate(effect);
+        if !validation.success {
+            return VfxCompilation {
+                success: false,
+                diagnostics: validation.diagnostics,
+                compiled_effect: None,
+            };
+        }
+
+        let mut capabilities = VfxCapabilityRequirements::default();
+        let mut emitters = Vec::new();
+        for emitter in effect.emitters.iter().filter(|emitter| emitter.enabled) {
+            let mut attribute_layout = VfxAttributeLayout::default();
+            let mut spawn_operations = Vec::new();
+            let mut update_operations = Vec::new();
+            let mut render_operations = Vec::new();
+            for module in emitter.modules.iter().filter(|module| module.enabled) {
+                update_attribute_layout(&mut attribute_layout, &module.operation);
+                update_capabilities(&mut capabilities, &module.operation);
+                let operation = CompiledVfxOperation {
+                    source_module: module.id.clone(),
+                    operation: module.operation.clone(),
+                };
+                match module.phase {
+                    VfxPhase::Spawn => spawn_operations.push(operation),
+                    VfxPhase::Update => update_operations.push(operation),
+                    VfxPhase::Render => render_operations.push(operation),
+                }
+            }
+            emitters.push(CompiledVfxEmitter {
+                source: emitter.id.clone(),
+                name: emitter.name.clone(),
+                max_particles: emitter.max_particles,
+                attribute_layout,
+                spawn_operations,
+                update_operations,
+                render_operations,
+                estimated_capacity: estimate_capacity(emitter),
+            });
+        }
+
+        VfxCompilation {
+            success: true,
+            diagnostics: validation.diagnostics,
+            compiled_effect: Some(CompiledVfxEffect {
+                source_schema_version: effect.schema_version,
+                seed: effect.seed,
+                max_particles: effect.max_particles,
+                emitters,
+                capabilities,
+            }),
+        }
+    }
+
+    /// Applies commands to a clone, validates once, and commits atomically on success.
+    ///
+    /// The input document is never mutated. Successful results also contain an
+    /// ordered inverse command list that restores the input document.
+    pub fn apply(&self, effect: &VfxEffect, commands: &[VfxCommand]) -> VfxApply {
+        let mut draft = effect.clone();
+        let mut undo_commands = Vec::new();
+        for command in commands {
+            match apply_command(&mut draft, command) {
+                Ok(inverse) => undo_commands.push(inverse),
+                Err(diagnostic) => {
+                    return VfxApply {
+                        success: false,
+                        diagnostics: vec![diagnostic],
+                        effect: None,
+                        undo_commands: Vec::new(),
+                    };
+                }
+            }
+        }
+        undo_commands.reverse();
+        let validation = self.validate(&draft);
+        if !validation.success {
+            return VfxApply {
+                success: false,
+                diagnostics: validation.diagnostics,
+                effect: None,
+                undo_commands: Vec::new(),
+            };
+        }
+        VfxApply {
+            success: true,
+            diagnostics: validation.diagnostics,
+            effect: Some(draft),
+            undo_commands,
+        }
+    }
+
+    /// Creates one ordinary VFX document from a built-in starting template.
+    pub fn template(&self, template: VfxTemplate) -> VfxEffect {
+        match template {
+            VfxTemplate::Spark => spark_template(),
+            VfxTemplate::Smoke => smoke_template(),
+            VfxTemplate::Burst => burst_template(),
+            VfxTemplate::Trail => trail_template(),
+        }
+    }
+}
+
+fn finite3(value: [f32; 3]) -> bool {
+    value.into_iter().all(f32::is_finite)
+}
+
+fn finite4(value: [f32; 4]) -> bool {
+    value.into_iter().all(f32::is_finite)
+}
+
+fn validate_operation(
+    emitter: &VfxEmitter,
+    module: &VfxModule,
+    diagnostics: &mut Vec<VfxDiagnostic>,
+) {
+    let valid = match &module.operation {
+        VfxModuleOperation::SpawnRate {
+            particles_per_second,
+        } => particles_per_second.is_finite() && *particles_per_second >= 0.0,
+        VfxModuleOperation::Burst { time, .. } => time.is_finite() && *time >= 0.0,
+        VfxModuleOperation::Shape { shape } => shape.validate(),
+        VfxModuleOperation::Lifetime { value } => value.validate() && value.maximum() > 0.0,
+        VfxModuleOperation::InitialSpeed { value } => value.validate(),
+        VfxModuleOperation::InitialVelocity { value } => value.validate(),
+        VfxModuleOperation::InitialColor { color } => finite4(*color),
+        VfxModuleOperation::InitialSize { value } => value.validate() && value.maximum() >= 0.0,
+        VfxModuleOperation::InitialRotation { value } => value.validate(),
+        VfxModuleOperation::Force { acceleration } => finite3(*acceleration),
+        VfxModuleOperation::Drag { coefficient } => coefficient.is_finite() && *coefficient >= 0.0,
+        VfxModuleOperation::ColorOverLife { gradient } => gradient.is_valid(),
+        VfxModuleOperation::SizeOverLife { curve }
+        | VfxModuleOperation::RotationOverLife { curve } => curve.is_valid(),
+        VfxModuleOperation::Billboard { texture_sheet, .. }
+        | VfxModuleOperation::Mesh { texture_sheet, .. } => texture_sheet
+            .as_ref()
+            .is_none_or(VfxTextureSheet::is_valid),
+    };
+    if !valid {
+        diagnostics.push(VfxDiagnostic::error(
+            "vfx.invalid_module_properties",
+            format!(
+                "module `{}` (`{}`) contains non-finite, out-of-range, or invalid ordered data",
+                module.id,
+                module.operation.type_id()
+            ),
+            Some(&emitter.id),
+            Some(&module.id),
+        ));
+    }
+}
+
+fn estimate_capacity(emitter: &VfxEmitter) -> u32 {
+    let mut rate = 0.0_f32;
+    let mut burst = 0_u64;
+    let mut lifetime = 1.0_f32;
+    for module in emitter.modules.iter().filter(|module| module.enabled) {
+        match &module.operation {
+            VfxModuleOperation::SpawnRate {
+                particles_per_second,
+            } if particles_per_second.is_finite() => rate += particles_per_second.max(0.0),
+            VfxModuleOperation::Burst { count, .. } => burst = burst.saturating_add(u64::from(*count)),
+            VfxModuleOperation::Lifetime { value } if value.validate() => {
+                lifetime = lifetime.max(value.maximum().max(0.0));
+            }
+            _ => {}
+        }
+    }
+    let continuous = (rate * lifetime).ceil().max(0.0) as u64;
+    continuous
+        .saturating_add(burst)
+        .min(u64::from(u32::MAX)) as u32
+}
+
+fn update_attribute_layout(layout: &mut VfxAttributeLayout, operation: &VfxModuleOperation) {
+    match operation {
+        VfxModuleOperation::InitialSpeed { .. }
+        | VfxModuleOperation::InitialVelocity { .. }
+        | VfxModuleOperation::Force { .. }
+        | VfxModuleOperation::Drag { .. } => layout.velocity = true,
+        VfxModuleOperation::InitialColor { .. } | VfxModuleOperation::ColorOverLife { .. } => {
+            layout.color = true;
+        }
+        VfxModuleOperation::InitialSize { .. } | VfxModuleOperation::SizeOverLife { .. } => {
+            layout.size = true;
+        }
+        VfxModuleOperation::InitialRotation { .. } | VfxModuleOperation::RotationOverLife { .. } => {
+            layout.rotation = true;
+        }
+        _ => {}
+    }
+}
+
+fn update_capabilities(
+    capabilities: &mut VfxCapabilityRequirements,
+    operation: &VfxModuleOperation,
+) {
+    match operation {
+        VfxModuleOperation::Billboard { texture_sheet, .. } => {
+            capabilities.billboard_rendering = true;
+            capabilities.texture_sheet_animation |= texture_sheet.is_some();
+        }
+        VfxModuleOperation::Mesh { texture_sheet, .. } => {
+            capabilities.mesh_rendering = true;
+            capabilities.texture_sheet_animation |= texture_sheet.is_some();
+        }
+        _ => {}
+    }
+}
+
+fn emitter_index(effect: &VfxEffect, id: &VfxEmitterId) -> Option<usize> {
+    effect.emitters.iter().position(|emitter| &emitter.id == id)
+}
+
+fn emitter_mut<'a>(effect: &'a mut VfxEffect, id: &VfxEmitterId) -> Option<&'a mut VfxEmitter> {
+    effect.emitters.iter_mut().find(|emitter| &emitter.id == id)
+}
+
+fn module_index(emitter: &VfxEmitter, id: &VfxModuleId) -> Option<usize> {
+    emitter.modules.iter().position(|module| &module.id == id)
+}
+
+fn edit_error(
+    code: &'static str,
+    message: impl Into<String>,
+    emitter: Option<&VfxEmitterId>,
+    module: Option<&VfxModuleId>,
+) -> VfxDiagnostic {
+    VfxDiagnostic::error(code, message, emitter, module)
+}
+
+fn apply_command(effect: &mut VfxEffect, command: &VfxCommand) -> Result<VfxCommand, VfxDiagnostic> {
+    match command {
+        VfxCommand::SetEffectName { name } => {
+            let previous = std::mem::replace(&mut effect.name, name.clone());
+            Ok(VfxCommand::SetEffectName { name: previous })
+        }
+        VfxCommand::SetEffectSeed { seed } => {
+            let previous = std::mem::replace(&mut effect.seed, *seed);
+            Ok(VfxCommand::SetEffectSeed { seed: previous })
+        }
+        VfxCommand::SetEffectMaxParticles { max_particles } => {
+            let previous = std::mem::replace(&mut effect.max_particles, *max_particles);
+            Ok(VfxCommand::SetEffectMaxParticles {
+                max_particles: previous,
+            })
+        }
+        VfxCommand::AddEmitter { emitter, index } => {
+            if *index > effect.emitters.len() {
+                return Err(edit_error(
+                    "vfx.edit.index_out_of_range",
+                    format!("emitter insertion index {index} is out of range"),
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+            if effect.emitters.iter().any(|entry| entry.id == emitter.id) {
+                return Err(edit_error(
+                    "vfx.edit.duplicate_emitter_id",
+                    format!("emitter `{}` already exists", emitter.id),
+                    Some(&emitter.id),
+                    None,
+                ));
+            }
+            effect.emitters.insert(*index, emitter.clone());
+            Ok(VfxCommand::RemoveEmitter {
+                emitter: emitter.id.clone(),
+            })
+        }
+        VfxCommand::RemoveEmitter { emitter } => {
+            let index = emitter_index(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    None,
+                )
+            })?;
+            let removed = effect.emitters.remove(index);
+            Ok(VfxCommand::AddEmitter {
+                emitter: removed,
+                index,
+            })
+        }
+        VfxCommand::MoveEmitter { emitter, index } => {
+            let previous = emitter_index(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    None,
+                )
+            })?;
+            if *index >= effect.emitters.len() {
+                return Err(edit_error(
+                    "vfx.edit.index_out_of_range",
+                    format!("emitter destination index {index} is out of range"),
+                    Some(emitter),
+                    None,
+                ));
+            }
+            let moved = effect.emitters.remove(previous);
+            effect.emitters.insert(*index, moved);
+            Ok(VfxCommand::MoveEmitter {
+                emitter: emitter.clone(),
+                index: previous,
+            })
+        }
+        VfxCommand::RenameEmitter { emitter, name } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    None,
+                )
+            })?;
+            let previous = std::mem::replace(&mut target.name, name.clone());
+            Ok(VfxCommand::RenameEmitter {
+                emitter: emitter.clone(),
+                name: previous,
+            })
+        }
+        VfxCommand::SetEmitterEnabled { emitter, enabled } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    None,
+                )
+            })?;
+            let previous = std::mem::replace(&mut target.enabled, *enabled);
+            Ok(VfxCommand::SetEmitterEnabled {
+                emitter: emitter.clone(),
+                enabled: previous,
+            })
+        }
+        VfxCommand::SetEmitterMaxParticles {
+            emitter,
+            max_particles,
+        } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    None,
+                )
+            })?;
+            let previous = std::mem::replace(&mut target.max_particles, *max_particles);
+            Ok(VfxCommand::SetEmitterMaxParticles {
+                emitter: emitter.clone(),
+                max_particles: previous,
+            })
+        }
+        VfxCommand::AddModule {
+            emitter,
+            module,
+            index,
+        } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    Some(&module.id),
+                )
+            })?;
+            if *index > target.modules.len() {
+                return Err(edit_error(
+                    "vfx.edit.index_out_of_range",
+                    format!("module insertion index {index} is out of range"),
+                    Some(emitter),
+                    Some(&module.id),
+                ));
+            }
+            if target.modules.iter().any(|entry| entry.id == module.id) {
+                return Err(edit_error(
+                    "vfx.edit.duplicate_module_id",
+                    format!("module `{}` already exists in emitter", module.id),
+                    Some(emitter),
+                    Some(&module.id),
+                ));
+            }
+            target.modules.insert(*index, module.clone());
+            Ok(VfxCommand::RemoveModule {
+                emitter: emitter.clone(),
+                module: module.id.clone(),
+            })
+        }
+        VfxCommand::RemoveModule { emitter, module } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let index = module_index(target, module).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.module_not_found",
+                    format!("module `{module}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let removed = target.modules.remove(index);
+            Ok(VfxCommand::AddModule {
+                emitter: emitter.clone(),
+                module: removed,
+                index,
+            })
+        }
+        VfxCommand::MoveModule {
+            emitter,
+            module,
+            phase_index,
+        } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let current = module_index(target, module).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.module_not_found",
+                    format!("module `{module}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let phase = target.modules[current].phase;
+            let phase_positions: Vec<usize> = target
+                .modules
+                .iter()
+                .enumerate()
+                .filter_map(|(index, entry)| (entry.phase == phase).then_some(index))
+                .collect();
+            let previous_phase_index = phase_positions
+                .iter()
+                .position(|position| *position == current)
+                .expect("current module must be present in its own phase positions");
+            if *phase_index >= phase_positions.len() {
+                return Err(edit_error(
+                    "vfx.edit.index_out_of_range",
+                    format!("module phase destination index {phase_index} is out of range"),
+                    Some(emitter),
+                    Some(module),
+                ));
+            }
+            let moved = target.modules.remove(current);
+            let remaining_phase_positions: Vec<usize> = target
+                .modules
+                .iter()
+                .enumerate()
+                .filter_map(|(index, entry)| (entry.phase == phase).then_some(index))
+                .collect();
+            let insert_at = if *phase_index >= remaining_phase_positions.len() {
+                remaining_phase_positions
+                    .last()
+                    .map_or(target.modules.len(), |index| index + 1)
+            } else {
+                remaining_phase_positions[*phase_index]
+            };
+            target.modules.insert(insert_at, moved);
+            Ok(VfxCommand::MoveModule {
+                emitter: emitter.clone(),
+                module: module.clone(),
+                phase_index: previous_phase_index,
+            })
+        }
+        VfxCommand::SetModuleEnabled {
+            emitter,
+            module,
+            enabled,
+        } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let index = module_index(target, module).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.module_not_found",
+                    format!("module `{module}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let previous = std::mem::replace(&mut target.modules[index].enabled, *enabled);
+            Ok(VfxCommand::SetModuleEnabled {
+                emitter: emitter.clone(),
+                module: module.clone(),
+                enabled: previous,
+            })
+        }
+        VfxCommand::ReplaceModuleOperation {
+            emitter,
+            module,
+            operation,
+        } => {
+            let target = emitter_mut(effect, emitter).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.emitter_not_found",
+                    format!("emitter `{emitter}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            let index = module_index(target, module).ok_or_else(|| {
+                edit_error(
+                    "vfx.edit.module_not_found",
+                    format!("module `{module}` was not found"),
+                    Some(emitter),
+                    Some(module),
+                )
+            })?;
+            if operation.required_phase() != target.modules[index].phase {
+                return Err(edit_error(
+                    "vfx.edit.phase_change_forbidden",
+                    "replace operation cannot move a module to another execution phase",
+                    Some(emitter),
+                    Some(module),
+                ));
+            }
+            let previous = std::mem::replace(&mut target.modules[index].operation, operation.clone());
+            Ok(VfxCommand::ReplaceModuleOperation {
+                emitter: emitter.clone(),
+                module: module.clone(),
+                operation: previous,
+            })
+        }
+    }
+}
+
+fn module(operation: VfxModuleOperation) -> VfxModule {
+    VfxModule::new(operation)
+}
+
+fn base_emitter(name: &str, max_particles: u32) -> VfxEmitter {
+    VfxEmitter::new(name, max_particles)
+}
+
+fn spark_template() -> VfxEffect {
+    let mut effect = VfxEffect::new("spark", 1024);
+    let mut emitter = base_emitter("sparks", 512);
+    emitter.modules = vec![
+        module(VfxModuleOperation::Burst { time: 0.0, count: 48 }),
+        module(VfxModuleOperation::Shape {
+            shape: VfxShape::Cone {
+                direction: [0.0, 1.0, 0.0],
+                angle_radians: 0.8,
+                radius: 0.05,
+            },
+        }),
+        module(VfxModuleOperation::Lifetime {
+            value: VfxScalarValue::Range {
+                min: 0.25,
+                max: 0.8,
+                channel: VfxRandomChannel::new(0),
+            },
+        }),
+        module(VfxModuleOperation::InitialVelocity {
+            value: VfxVectorValue::Range {
+                min: [-2.0, 2.0, -2.0],
+                max: [2.0, 7.0, 2.0],
+                channel: VfxRandomChannel::new(1),
+            },
+        }),
+        module(VfxModuleOperation::InitialColor {
+            color: [1.0, 0.8, 0.25, 1.0],
+        }),
+        module(VfxModuleOperation::InitialSize {
+            value: VfxScalarValue::Range {
+                min: 0.02,

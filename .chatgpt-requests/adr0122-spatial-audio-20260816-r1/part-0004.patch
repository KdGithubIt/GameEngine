diff --git a/crates/engine/src/components/validation.rs b/crates/engine/src/components/validation.rs
--- a/crates/engine/src/components/validation.rs
+++ b/crates/engine/src/components/validation.rs
@@ -1,4 +1,71 @@
+    diagnostics.extend(validate_spatial_audio_scene(scene));
     diagnostics.extend(validate_skinned_models_without_renderers(scene));
     diagnostics.extend(crate::render_limits::validate_scene_render_limits(scene));
     diagnostics
 }
+
+fn validate_spatial_audio_scene(scene: &AuthoringScene) -> Vec<Diagnostic> {
+    let listener_type = ComponentTypeId::new(AUDIO_LISTENER_COMPONENT);
+    let emitter_type = ComponentTypeId::new(AUDIO_EMITTER_COMPONENT);
+    let mut listeners = Vec::new();
+    for (entity_id, entity) in scene.entities() {
+        let Some(Value::Object(fields)) = entity.components.get(&listener_type) else {
+            continue;
+        };
+        if !matches!(fields.get("enabled"), Some(Value::Bool(true))) {
+            continue;
+        }
+        let priority = match fields.get("priority") {
+            Some(Value::I64(value)) => *value,
+            Some(Value::U64(value)) => i64::try_from(*value).unwrap_or(i64::MAX),
+            _ => continue,
+        };
+        listeners.push((entity_id.clone(), priority));
+    }
+
+    let mut diagnostics = Vec::new();
+    if let Some(highest) = listeners.iter().map(|(_, priority)| *priority).max() {
+        let highest_listeners: Vec<_> = listeners
+            .iter()
+            .filter(|(_, priority)| *priority == highest)
+            .collect();
+        if highest_listeners.len() > 1 {
+            for (entity, _) in highest_listeners {
+                diagnostics.push(
+                    Diagnostic::warning(
+                        "scene.audio_listener_priority_tie",
+                        format!(
+                            "multiple enabled Audio Listeners share highest priority {highest}; runtime selection falls back to deterministic entity order"
+                        ),
+                    )
+                    .with_target(DiagnosticTarget::Component {
+                        entity: entity.clone(),
+                        component_type: listener_type.clone(),
+                    }),
+                );
+            }
+        }
+    }
+
+    if listeners.is_empty() {
+        for (entity_id, entity) in scene.entities() {
+            let Some(Value::Object(fields)) = entity.components.get(&emitter_type) else {
+                continue;
+            };
+            let spatial_blend = fields.get("spatial_blend").and_then(value_as_f64);
+            if spatial_blend.is_some_and(|blend| blend.is_finite() && blend > 0.0) {
+                diagnostics.push(
+                    Diagnostic::warning(
+                        "scene.audio_spatial_listener_missing",
+                        "positional Audio Emitter has no enabled Audio Listener in the scene",
+                    )
+                    .with_target(DiagnosticTarget::Component {
+                        entity: entity_id.clone(),
+                        component_type: emitter_type.clone(),
+                    }),
+                );
+            }
+        }
+    }
+    diagnostics
+}


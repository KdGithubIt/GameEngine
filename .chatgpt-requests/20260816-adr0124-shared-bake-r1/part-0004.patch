+/// Backend-neutral source geometry and authored navigation controls.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct NavigationSource {
+    /// World-space triangles eligible for navigation.
+    pub triangles: Vec<NavigationTriangle>,
+    /// Exclusion and area modifiers.
+    pub modifiers: Vec<NavigationModifier>,
+    /// Explicit off-mesh traversals.
+    pub links: Vec<NavigationBuildLink>,
+}
+
+impl NavigationSource {
+    /// Normalizes ordering so equivalent inputs produce the same fingerprint.
+    fn normalized(&self) -> Self {
+        let mut source = self.clone();
+        source.triangles.sort_by_key(triangle_sort_key);
+        source.modifiers.sort_by(|left, right| left.id.cmp(&right.id));
+        source.links.sort_by(|left, right| left.id.cmp(&right.id));
+        source
+    }
+}
+
+fn triangle_sort_key(triangle: &NavigationTriangle) -> [u32; 10] {
+    [
+        triangle.a[0].to_bits(),
+        triangle.a[1].to_bits(),
+        triangle.a[2].to_bits(),
+        triangle.b[0].to_bits(),
+        triangle.b[1].to_bits(),
+        triangle.b[2].to_bits(),
+        triangle.c[0].to_bits(),
+        triangle.c[1].to_bits(),
+        triangle.c[2].to_bits(),
+        u32::from(triangle.area),
+    ]
+}
+
+/// Summary produced by one successful shared bake.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NavigationBakeStats {
+    /// Number of profiles baked.
+    pub profile_count: usize,
+    /// Total generated tiles across profiles.
+    pub tile_count: usize,
+    /// Total generated polygons across profiles.
+    pub polygon_count: usize,
+    /// Total resolved off-mesh links across profiles.
+    pub link_count: usize,
+    /// Bake duration excluding persistence.
+    pub elapsed: Duration,
+}
+
+/// Successful shared service result.
+pub struct NavigationBakeOutput {
+    /// Production runtime asset.
+    pub nav_mesh: NavMesh,
+    /// Normalized input fingerprint recorded into the document after success.
+    pub source_fingerprint: String,
+    /// Bake statistics.
+    pub stats: NavigationBakeStats,
+}
+
+/// GUI-free shared production navigation bake service.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NavigationBakeService;
+
+impl NavigationBakeService {
+    /// Builds deterministic backend-neutral baker input from shared source/settings.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`NavigationBakeServiceError`] when source/settings are invalid.
+    pub fn prepare(
+        &self,
+        source: &NavigationSource,
+        document: &NavMeshBakeDocument,
+    ) -> Result<NavigationBuildInput, NavigationBakeServiceError> {
+        document.validate()?;
+        let normalized = source.normalized();
+        if normalized.triangles.is_empty() {
+            return Err(NavigationBakeServiceError::MissingGeometry);
+        }
+        let fingerprint = source_fingerprint(&normalized, &document.settings)?;
+        let input = NavigationBuildInput {
+            source_fingerprint: fingerprint,
+            triangles: normalized.triangles,
+            modifiers: normalized.modifiers,
+            links: normalized.links,
+            profiles: document.settings.profiles.clone(),
+            tile_size: document.settings.tile_size,
+        };
+        input
+            .validate()
+            .map_err(NavigationBakeServiceError::Bake)?;
+        Ok(input)
+    }
+
+    /// Returns whether current source/settings differ from the last successful bake.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`NavigationBakeServiceError`] when the source cannot be prepared.
+    pub fn is_stale(
+        &self,
+        source: &NavigationSource,
+        document: &NavMeshBakeDocument,
+    ) -> Result<bool, NavigationBakeServiceError> {
+        let input = self.prepare(source, document)?;
+        Ok(document.source_fingerprint.as_deref() != Some(input.source_fingerprint.as_str()))
+    }
+
+    /// Bakes without touching the filesystem. This is the primitive used by every adapter.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`NavigationBakeServiceError::Cancelled`] on cancellation, otherwise validation
+    /// or production baker failures.
+    pub fn bake(
+        &self,
+        source: &NavigationSource,
+        document: &NavMeshBakeDocument,
+        cancelled: &AtomicBool,
+    ) -> Result<NavigationBakeOutput, NavigationBakeServiceError> {
+        let input = self.prepare(source, document)?;
+        if cancelled.load(Ordering::Relaxed) {
+            return Err(NavigationBakeServiceError::Cancelled);
+        }
+        let started = Instant::now();
+        let nav_mesh = ProductionNavigationBaker
+            .bake(&input, &|| cancelled.load(Ordering::Relaxed))
+            .map_err(|error| match error {
+                NavigationBakeError::Cancelled => NavigationBakeServiceError::Cancelled,
+                other => NavigationBakeServiceError::Bake(other),
+            })?;
+        if cancelled.load(Ordering::Relaxed) {
+            return Err(NavigationBakeServiceError::Cancelled);
+        }
+        let stats = NavigationBakeStats {
+            profile_count: nav_mesh.profiles.len(),
+            tile_count: nav_mesh.profiles.iter().map(|profile| profile.tiles.len()).sum(),
+            polygon_count: nav_mesh
+                .profiles
+                .iter()
+                .flat_map(|profile| &profile.tiles)
+                .map(|tile| tile.polygons.len())
+                .sum(),
+            link_count: nav_mesh.profiles.iter().map(|profile| profile.links.len()).sum(),
+            elapsed: started.elapsed(),
+        };
+        Ok(NavigationBakeOutput {
+            nav_mesh,
+            source_fingerprint: input.source_fingerprint,
+            stats,
+        })
+    }
+
+    /// Bakes and safely replaces the derived runtime asset only after successful completion.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`NavigationBakeServiceError`] for bake/cancellation/JSON/I/O failures. The
+    /// previous output remains untouched when baking, serialization, temp-file writing, or
+    /// cancellation fails before the final atomic replacement.
+    pub fn bake_to_path(
+        &self,
+        source: &NavigationSource,
+        document: &NavMeshBakeDocument,
+        output_path: &Path,
+        cancelled: &AtomicBool,
+    ) -> Result<NavigationBakeOutput, NavigationBakeServiceError> {
+        let output = self.bake(source, document, cancelled)?;
+        if cancelled.load(Ordering::Relaxed) {
+            return Err(NavigationBakeServiceError::Cancelled);
+        }
+        let json = serde_json::to_vec_pretty(&output.nav_mesh)
+            .map_err(NavigationBakeServiceError::Json)?;
+        if cancelled.load(Ordering::Relaxed) {
+            return Err(NavigationBakeServiceError::Cancelled);
+        }
+        replace_file_bytes(output_path, &json, cancelled)?;
+        Ok(output)
+    }
+}
+
+fn source_fingerprint(
+    source: &NavigationSource,
+    settings: &NavMeshBakeSettings,
+) -> Result<String, NavigationBakeServiceError> {
+    let bytes = serde_json::to_vec(&(source, settings)).map_err(NavigationBakeServiceError::Json)?;
+    let mut hash = 0xcbf29ce484222325_u64;
+    for byte in bytes {
+        hash ^= u64::from(byte);
+        hash = hash.wrapping_mul(0x100000001b3);
+    }
+    Ok(format!("nav-v2-fnv1a64:{hash:016x}"))
+}
+
+fn replace_file_bytes(
+    path: &Path,
+    bytes: &[u8],
+    cancelled: &AtomicBool,
+) -> Result<(), NavigationBakeServiceError> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).map_err(NavigationBakeServiceError::Io)?;
+    }
+    let temp = unique_temp_path(path);
+    let write_result = (|| -> Result<(), NavigationBakeServiceError> {
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&temp)
+            .map_err(NavigationBakeServiceError::Io)?;
+        let mut offset = 0;
+        while offset < bytes.len() {
+            if cancelled.load(Ordering::Relaxed) {
+                return Err(NavigationBakeServiceError::Cancelled);
+            }
+            let end = (offset + 64 * 1024).min(bytes.len());
+            file.write_all(&bytes[offset..end])
+                .map_err(NavigationBakeServiceError::Io)?;
+            offset = end;
+        }
+        file.flush().map_err(NavigationBakeServiceError::Io)?;
+        if cancelled.load(Ordering::Relaxed) {
+            return Err(NavigationBakeServiceError::Cancelled);
+        }
+        atomic_replace(&temp, path).map_err(NavigationBakeServiceError::Io)
+    })();
+    if write_result.is_err() {
+        let _ = fs::remove_file(&temp);
+    }
+    write_result
+}
+
+fn unique_temp_path(path: &Path) -> PathBuf {
+    let stamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    let process = std::process::id();
+    let base = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("navmesh");
+    path.with_file_name(format!(".{base}.{process}.{stamp}.tmp"))
+}
+
+#[cfg(windows)]
+fn atomic_replace(from: &Path, to: &Path) -> io::Result<()> {
+    use std::os::windows::ffi::OsStrExt;
+
+    type Bool = i32;
+    type Dword = u32;
+    const REPLACEFILE_WRITE_THROUGH: Dword = 0x0000_0001;
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn ReplaceFileW(
+            replaced_file_name: *const u16,
+            replacement_file_name: *const u16,
+            backup_file_name: *const u16,
+            replace_flags: Dword,
+            exclude: *mut core::ffi::c_void,
+            reserved: *mut core::ffi::c_void,
+        ) -> Bool;
+    }
+
+    if !to.exists() {
+        return fs::rename(from, to);
+    }
+    let mut to_wide = to.as_os_str().encode_wide().collect::<Vec<_>>();
+    to_wide.push(0);
+    let mut from_wide = from.as_os_str().encode_wide().collect::<Vec<_>>();
+    from_wide.push(0);
+    // SAFETY: both vectors are NUL-terminated UTF-16 strings kept alive for the call.
+    let replaced = unsafe {
+        ReplaceFileW(
+            to_wide.as_ptr(),
+            from_wide.as_ptr(),
+            std::ptr::null(),
+            REPLACEFILE_WRITE_THROUGH,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+        )
+    };
+    if replaced == 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}

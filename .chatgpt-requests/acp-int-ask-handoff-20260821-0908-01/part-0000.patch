+            self.ensure_acp_runtime(agent_id)?;
+        }
+        self.execution_router.sync_registry(self.acp.registry());
+        self.execution_router
+            .resolve(logical_ai_id, route_key)
+            .map(|resolution| resolution.driver)
+            .map_err(|error| error.to_string())
+    }

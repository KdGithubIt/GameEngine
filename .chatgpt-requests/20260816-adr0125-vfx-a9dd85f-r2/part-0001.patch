+fn edit_curve(ui: &mut egui::Ui, curve: &mut VfxCurve) {
+    ui.label("Curve");
+    draw_curve(ui, curve);
+    let mut remove = None;
+    let key_count = curve.keys.len();
+    for (index, key) in curve.keys.iter_mut().enumerate() {
+        ui.horizontal(|ui| {
+            ui.monospace(short_id(key.id.as_str()));
+            ui.label("t");

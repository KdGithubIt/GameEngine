+    /// Replaces the Timeline working-copy request consumed by the persistent PreviewWorld.
+    pub(crate) fn set_timeline_preview_request(&mut self, request: Option<TimelinePreviewRequest>) {
+        let toggled = self.timeline_preview_request.is_some() != request.is_some();
+        self.timeline_preview_request = request;
+        if toggled {
+            // Fixed-system order is immutable after installation. Rebuild once when Timeline
+            // preview enters or leaves so the production prepare/animation/transform order is
+            // installed exactly once; ordinary scrubs and edits keep the same world.
+            self.preview = None;
+        }
+        if self.timeline_preview_request.is_none() {
+            self.timeline_preview_status = None;
+        }
+    }
+
+    /// Returns copied state from the production TimelineRuntime in the Scene View.
+    pub(crate) fn timeline_preview_status(&self) -> Option<&TimelinePreviewStatus> {
+        self.timeline_preview_status.as_ref()
+    }

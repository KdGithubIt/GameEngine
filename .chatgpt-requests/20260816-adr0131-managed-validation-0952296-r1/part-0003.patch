+fn push_validation_event(
+    run: &mut AgentRun,
+    message: String,
+    validation: ManagedValidationEvent,
+) {
+    let sequence = run.events.last().map_or(1, |event| event.sequence + 1);
+    run.events.push(AgentEvent {

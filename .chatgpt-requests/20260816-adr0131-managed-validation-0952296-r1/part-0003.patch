+fn managed_validation_plan(
+    proposal: &AgentProposal,
+    code_changes_present: bool,
+) -> (Vec<ManagedValidationGate>, usize) {
+    let mut gates = BTreeSet::new();
+    let mut unmanaged_plan_items = 0;
+    for item in &proposal.validation_plan {
+        let normalized = item.trim().to_ascii_lowercase();
+        if normalized.is_empty() {
+            continue;
+        }
+        let all = normalized == "all"
+            || normalized == "full"
+            || normalized.contains("full validation")
+            || normalized.contains("source validation");
+        if all {
+            gates.extend(STANDARD_VALIDATION_GATES);
+            continue;
+        }
+        let mut matched = false;
+        for (gate, needles) in [
+            (ManagedValidationGate::Formatting, &["format", "fmt"][..]),
+            (ManagedValidationGate::Check, &["cargo check", "check"][..]),
+            (ManagedValidationGate::Clippy, &["clippy"][..]),
+            (ManagedValidationGate::Tests, &["test", "tests"][..]),
+            (
+                ManagedValidationGate::Documentation,
+                &["documentation", "rustdoc", "cargo doc"][..],
+            ),
+        ] {
+            if needles.iter().any(|needle| normalized.contains(needle)) {
+                gates.insert(gate);
+                matched = true;
+            }
+        }
+        if !matched {
+            unmanaged_plan_items += 1;
+        }
+    }
+    if gates.is_empty() && code_changes_present {
+        gates.extend(STANDARD_VALIDATION_GATES);
+    }
+    let ordered = STANDARD_VALIDATION_GATES
+        .into_iter()
+        .filter(|gate| gates.contains(gate))
+        .collect();
+    (ordered, unmanaged_plan_items)
+}

+/// Basing the ID on the Native clip keeps a logical animation's variants grouped by
+/// identity while remaining deterministic for both model-owned and VMD target clips.
+pub fn imported_humanoid_motion_sub_asset_id(native_clip: &AssetId) -> AssetId {
+    AssetId::derive(native_clip, "humanoid")

+                repair_budget: 0,
+                permission_budget: Vec::new(),
+                work_claims: Vec::new(),
+            },
+            completion_criteria: RAW_MODEL_COMPLETION_CRITERIA
+                .iter()
+                .map(|criterion| (*criterion).to_owned())
+                .collect(),
+            execution: None,
+        },
+        metrics,
+    };
+    validate_record(&record)?;
+    Ok(record)
+}

+/// Synchronizes authored and Project Rust spatial voices from propagated transforms.
+pub(crate) fn spatial_audio_system(
+    mut emitters: Query<(&mut AudioEmitter, &GlobalTransform)>,
+    listeners: Query<(&AudioListener, &GlobalTransform)>,
+    transforms: Query<&GlobalTransform>,
+    assets: Res<Assets<AudioAsset>>,
+    mut audio_system: Option<ResMut<AudioSystem>>,
+    mut runtime: ResMut<SpatialAudioRuntime>,
+) {
+    let listener = active_listener_pose(&listeners);
+    let completed: BTreeSet<_> = audio_system
+        .as_deref()
+        .map(AudioSystem::drain_completed_voices)
+        .unwrap_or_default()
+        .into_iter()
+        .collect();
+    runtime.transient.retain(|voice_id, _| !completed.contains(voice_id));
+
+    let mut live_emitters = BTreeSet::new();
+    for (entity, (emitter, transform)) in &mut emitters {
+        live_emitters.insert(entity);
+        if let Some(voice_id) = runtime.authored.get(&entity).copied() {
+            if completed.contains(&voice_id) {
+                runtime.authored.remove(&entity);
+                emitter.set_state(AuthoredAudioState::Completed);
+                continue;
+            }
+            let mix = mix_spatial_audio(listener, emitter_pose(transform), emitter.spatial_params());
+            if let Some(audio) = audio_system.as_deref()
+                && let Err(error) = audio.update_voice(voice_id, mix)
+            {
+                log::error!("failed to update authored spatial voice: {error}");
+            }
+            continue;
+        }
+        if !emitter.autoplay || emitter.state() != &AuthoredAudioState::Pending {
+            continue;
+        }
+        let Some(asset) = assets.get(&emitter.clip) else {
+            emitter.set_state(AuthoredAudioState::Failed(
+                "decoded clip handle is missing".into(),
+            ));
+            continue;
+        };
+        let Some(audio) = audio_system.as_deref_mut() else {
+            emitter.set_state(AuthoredAudioState::Unavailable);
+            continue;
+        };
+        let mix = mix_spatial_audio(listener, emitter_pose(transform), emitter.spatial_params());
+        match audio.start_voice(asset, mix, emitter.looping) {
+            Ok(voice_id) => {
+                runtime.authored.insert(entity, voice_id);
+                emitter.set_state(AuthoredAudioState::Playing);
+            }
+            Err(error) => emitter.set_state(AuthoredAudioState::Failed(error.to_string())),
+        }
+    }
+
+    let stale_authored: Vec<_> = runtime
+        .authored
+        .keys()
+        .copied()
+        .filter(|entity| !live_emitters.contains(entity))
+        .collect();
+    for entity in stale_authored {
+        if let Some(voice_id) = runtime.authored.remove(&entity)
+            && let Some(audio) = audio_system.as_deref()
+        {
+            let _ = audio.stop_voice(voice_id);
+        }
+    }
+
+    let source_poses: BTreeMap<_, _> = transforms
+        .iter()
+        .map(|(entity, transform)| (entity, emitter_pose(transform)))
+        .collect();
+    let mut stale_transient = Vec::new();
+    for (voice_id, voice) in &runtime.transient {
+        let Some(source_pose) = source_poses.get(&voice.source).copied() else {
+            stale_transient.push(*voice_id);
+            continue;
+        };
+        if let Some(audio) = audio_system.as_deref() {
+            let mix = mix_spatial_audio(listener, source_pose, voice.params);
+            if let Err(error) = audio.update_voice(*voice_id, mix) {
+                log::error!("failed to update project Rust spatial voice: {error}");
+            }
+        }
+    }
+    for voice_id in stale_transient {
+        runtime.transient.remove(&voice_id);
+        if let Some(audio) = audio_system.as_deref() {
+            let _ = audio.stop_voice(voice_id);
+        }
+    }
+}
+
+fn active_listener_pose(
+    listeners: &Query<(&AudioListener, &GlobalTransform)>,
+) -> Option<AudioListenerPose> {
+    let mut best: Option<(Entity, i32, AudioListenerPose)> = None;
+    for (entity, (listener, transform)) in listeners {
+        if !listener.enabled {
+            continue;
+        }
+        let replace = best.as_ref().is_none_or(|(best_entity, best_priority, _)| {
+            listener.priority > *best_priority
+                || (listener.priority == *best_priority && entity < *best_entity)
+        });
+        if replace {
+            let matrix = transform.matrix();
+            let position = matrix.w_axis.truncate();
+            let right = matrix.x_axis.truncate();
+            best = Some((
+                entity,
+                listener.priority,
+                AudioListenerPose {
+                    position: position.to_array(),
+                    right: right.to_array(),
+                },
+            ));
+        }
+    }
+    best.map(|(_, _, pose)| pose)
+}
+
+fn emitter_pose(transform: &GlobalTransform) -> AudioEmitterPose {
+    AudioEmitterPose {
+        position: transform.matrix().w_axis.truncate().to_array(),
+    }
+}

+fn play_voice_on_thread(
+    stream_handle: &rodio::OutputStreamHandle,
+    encoded: Arc<[u8]>,
+    mix: AudioSpatialMix,
+    looping: bool,
+    bus_volume: f32,
+) -> Result<ActiveVoice, AudioError> {
+    let sink = rodio::Sink::try_new(stream_handle).map_err(|source| AudioError::Playback {
+        message: source.to_string(),
+    })?;
+    let gains = Arc::new(Mutex::new([mix.left_gain, mix.right_gain]));
+    let source_gains = Arc::clone(&gains);
+    let decoder = decoder_for_encoded(encoded)?;
+    if looping {
+        let source = rodio::source::ChannelVolume::new(
+            decoder.repeat_infinite(),
+            vec![mix.left_gain, mix.right_gain],
+        )
+        .periodic_access(AUDIO_POLL_INTERVAL, move |source| {
+            if let Ok(gains) = source_gains.lock() {
+                source.set_volume(0, gains[0]);
+                source.set_volume(1, gains[1]);
+            }
+        });
+        sink.append(source);
+    } else {
+        let source = rodio::source::ChannelVolume::new(
+            decoder,
+            vec![mix.left_gain, mix.right_gain],
+        )
+        .periodic_access(AUDIO_POLL_INTERVAL, move |source| {
+            if let Ok(gains) = source_gains.lock() {
+                source.set_volume(0, gains[0]);
+                source.set_volume(1, gains[1]);
+            }
+        });
+        sink.append(source);
+    }
+    sink.set_volume(bus_volume);
+    Ok(ActiveVoice { sink, gains })
+}

+        assert!(matches!(
+            &document.tracks[0].clips[0].payload,
+            TimelineClipPayload::Event { name, payload }
+                if name == "new.event" && payload == "payload"
+        ));
+        assert_eq!(document.markers[0].event.as_deref(), Some("marker.event"));
+
+        assert!(service.undo());

+fn resolved_body_poses(
+    rig: &SecondaryMotionRigAsset,
+    joint_indices: &HashMap<BoneId, usize>,
+    procedural_worlds: &[Mat4],
+) -> Vec<Option<Pose>> {
+    rig.bodies
+        .iter()
+        .map(|body| body_pose_from_bone_worlds(body, joint_indices, procedural_worlds))
+        .collect()
+}

-                ("direction_y", -1.0),
-                ("direction_z", -0.5),
-                ("color_r", 1.0),
-                ("color_g", 0.95),
-                ("color_b", 0.85),
-                ("intensity", 1.0),
-            ]),
-        )],
-    );
-
-    let ambient = EntityId::generate();
-    enqueue_starter_entity(
-        &mut transaction,
-        ambient,
-        "ambient_light",
-        "Ambient Light",
-        "Keeps unlit faces visible in the starter Scene.",

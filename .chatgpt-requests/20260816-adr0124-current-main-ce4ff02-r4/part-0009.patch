+
+    #[test]
+    fn one_way_link_connects_stacked_surfaces_only_forward() {
+        let mut build = input(vec![
+            triangle(
+                Vec3::new(0.0, 0.0, 0.0),
+                Vec3::new(2.0, 0.0, 0.0),

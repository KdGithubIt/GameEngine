+    ) {
+        let disposition = match self.benchmark_campaign.as_mut() {
+            Some(campaign) => campaign.record_pre_measurement_failure(request),
+            None => Err("Campaign disappeared.".to_owned()),
+        };
+        let result = disposition.and_then(|disposition| {
+            self.persist_benchmark_campaign()?;
+            Ok(disposition)
+        });
+        self.status = Some(match result {
+            Ok(PreMeasurementFailureDisposition::Retry) => format!(
+                "Campaign preparation failed before measurement and will retry within the bounded infrastructure budget: {message}"
+            ),
+            Ok(PreMeasurementFailureDisposition::Exhausted) => format!(
+                "Campaign preparation exhausted its bounded pre-measurement retry budget: {message}"
+            ),
+            Err(error) => error,
+        });
+    }
+
+    fn finish_benchmark_worker(
+        &mut self,
+        request: &CampaignRunRequest,
+        outcome: BenchmarkWorkerOutcome,
+    ) {
+        let result = match outcome {
+            BenchmarkWorkerOutcome::Pending => return,
+            BenchmarkWorkerOutcome::Succeeded(record) => match self.benchmark_campaign.as_mut() {
+                Some(campaign) => campaign.complete_run(request, record),
+                None => Err("Campaign disappeared.".to_owned()),
+            },
+            BenchmarkWorkerOutcome::Failed { failure, record } => {
+                match self.benchmark_campaign.as_mut() {
+                    Some(campaign) => {
+                        campaign.fail_measured_run_with_record(request, failure, record)
+                    }
+                    None => Err("Campaign disappeared.".to_owned()),
+                }
+            }
+        };
+        if let Err(error) = result {
+            self.status = Some(error);
+            let _ = self.persist_benchmark_campaign();
+            return;
+        }
+
+        let record = self
+            .benchmark_campaign
+            .as_ref()
+            .and_then(|campaign| campaign.runs.get(request.schedule.ordinal as usize))
+            .and_then(|run| run.record.clone());
+        if let Err(error) = self.persist_benchmark_campaign() {
+            self.status = Some(error);
+            return;
+        }
+        if let Some(record) = record {
+            if let Err(error) = self.benchmark_store.record(&record) {
+                self.status = Some(format!(
+                    "Campaign progress was saved, but ADR 0142 evidence storage failed: {error}"
+                ));
+                return;
+            }
+            if let Err(error) = self.refresh_benchmark_catalog() {
+                self.status = Some(format!(
+                    "Campaign evidence was stored, but catalog refresh failed: {error}"
+                ));
+                return;
+            }
+        }
+        self.status = Some(format!(
+            "Finished campaign run {} ({}, repetition {}).",
+            request.schedule.ordinal,
+            request.schedule.task_id,
+            request.schedule.repetition,
+        ));
+    }

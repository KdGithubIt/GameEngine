+fn campaign_agent_proposal(request: &CampaignRunRequest) -> Result<AgentProposal, String> {
+    let task = benchmark_task(&request.schedule.task_id)
+        .ok_or_else(|| "frozen benchmark task descriptor is unavailable".to_owned())?;
+    let mut proposal = AgentProposal {
+        goal: request.candidate_contract.prompt.clone(),
+        requirements: vec![
+            "Use only the candidate-visible fixture project, benchmark-visible-task.json, and normal production tools.".to_owned(),
+            "Do not request broader filesystem, command, network, or external-process authority than the frozen task requires.".to_owned(),
+        ],
+        acceptance_criteria: request.candidate_contract.completion_criteria.clone(),
+        assumptions: vec![
+            "Host-only benchmark evaluation is unavailable to the model and must not be inferred from hidden files.".to_owned(),
+        ],
+        ..AgentProposal::default()
+    };
+
+    const SOURCE: &str = "assets/scripts/rust/shared/benchmark_fixture.rs";
+    const SCENE: &str = "assets/scenes/benchmark.scene.json";
+    match task.kind {
+        BenchmarkTaskKind::ReadQuestion => {
+            return Err("read questions use the native read/provenance harness".to_owned());
+        }
+        BenchmarkTaskKind::ProjectInspection => {}
+        BenchmarkTaskKind::CodeImplementation | BenchmarkTaskKind::ValidationRepair => {
+            proposal.planned_code_changes.push(SOURCE.to_owned());
+            proposal
+                .work_claims
+                .insert(AgentWorkClaim::code_path(SOURCE));
+            proposal.validation_plan.push("cargo check".to_owned());
+            proposal
+                .requested_capabilities
+                .insert(AgentCapability::CodeWorkspaceApply);
+        }
+        BenchmarkTaskKind::TypedAuthoringMutation => {
+            proposal.planned_project_changes.push(SCENE.to_owned());
+            proposal
+                .work_claims
+                .insert(AgentWorkClaim::authoring_document(SCENE));
+        }
+        BenchmarkTaskKind::RuntimeInteraction => {
+            proposal.playtest_plan.push(
+                "Execute the candidate-planned deterministic fixed-tick interaction through managed Play."
+                    .to_owned(),
+            );
+            proposal
+                .requested_capabilities
+                .extend([
+                    AgentCapability::RuntimeLaunch,
+                    AgentCapability::RuntimeInputControl,
+                ]);
+        }
+        BenchmarkTaskKind::VisualEvaluation => {
+            proposal.playtest_plan.push(
+                "Launch managed Play, capture a host-owned Game View frame, and evaluate only that production observation."
+                    .to_owned(),
+            );
+            proposal
+                .requested_capabilities
+                .extend([
+                    AgentCapability::RuntimeLaunch,
+                    AgentCapability::RuntimeInputControl,
+                    AgentCapability::FrameCapture,
+                ]);
+        }
+    }
+    Ok(proposal)
+}
+
+fn classify_campaign_failure(
+    message: &str,
+    fallback: CampaignFailureKind,
+) -> CampaignFailureKind {
+    let normalized = message.to_ascii_lowercase();
+    if normalized.contains("out of memory") || normalized.contains("oom") {
+        CampaignFailureKind::OutOfMemory
+    } else if normalized.contains("backend")
+        && (normalized.contains("crash")
+            || normalized.contains("unavailable")
+            || normalized.contains("connection"))
+    {
+        CampaignFailureKind::BackendCrash
+    } else if normalized.contains("validation") {
+        CampaignFailureKind::ValidationFailure
+    } else {
+        fallback
+    }
+}

+
+struct BenchmarkCampaignWorker {
+    request: CampaignRunRequest,
+    project: ProjectRoot,
+    app: crate::ui::EditorApp,
+    ai_studio: Box<AiStudioPanel>,
+    _mcp_server: EditorMcpServer,
+    mcp_requests: std::sync::mpsc::Receiver<EditorMcpRequest>,
+    preparation: Option<ModelResourceTask>,
+    preparation_done: bool,
+    measured_started: bool,
+    read_session_id: Option<String>,
+    run_id: Option<String>,
+    started_at: Option<std::time::Instant>,
+}
+
+impl BenchmarkCampaignWorker {
+    fn new(
+        context: &egui::Context,
+        fixtures_root: &Path,
+        request: CampaignRunRequest,
+        inventory: InstalledModelInventory,
+        quality: QualityPreference,
+        hardware: BenchmarkHardwareIdentity,
+        profile: CampaignExecutionProfile,
+    ) -> Result<Self, String> {
+        let project = materialize_fixture(fixtures_root, &request)?;
+        let app = crate::ui::EditorApp::from_project(project.clone());
+        let (mcp_server, mcp_requests) =
+            EditorMcpServer::start(context.clone()).map_err(|error| error.to_string())?;
+        let mut ai_studio = AiStudioPanel::new(
+            &project,
+            AiStudioConnection::new(
+                mcp_server.endpoint().to_owned(),
+                mcp_server.authorization_token().to_owned(),
+            ),
+        )?;
+        ai_studio.presentation.close();
+        ai_studio.benchmark_campaign = None;
+        ai_studio.benchmark_campaign_preflight = None;
+        ai_studio.model_backend = ModelBackendPreference::Local;
+        ai_studio.local_model_endpoint = inventory.endpoint.clone();
+        ai_studio.local_model_name = request.model.model_id.clone();
+        ai_studio.installed_model_inventory = Some(inventory);
+        ai_studio.benchmark_task_id = request.schedule.task_id.clone();
+        ai_studio.quality_preference = quality;
+        ai_studio.benchmark_hardware = hardware;
+        ai_studio.benchmark_hardware_probe_attempted = true;
+        ai_studio.status = None;
+
+        let config = LocalModelConfig {
+            endpoint: ai_studio.local_model_endpoint.clone(),
+            model: ai_studio.local_model_name.clone(),
+        };
+        let operation = match profile {
+            CampaignExecutionProfile::Warm => ModelResourceOperation::Reload,
+            CampaignExecutionProfile::Cold => ModelResourceOperation::Release,
+        };
+        let preparation = Some(
+            ModelResourceTask::spawn(config, operation).map_err(|error| error.to_string())?,
+        );
+
+        Ok(Self {
+            request,
+            project,
+            app,
+            ai_studio: Box::new(ai_studio),
+            _mcp_server: mcp_server,
+            mcp_requests,
+            preparation,
+            preparation_done: false,
+            measured_started: false,
+            read_session_id: None,
+            run_id: None,
+            started_at: None,
+        })
+    }
+
+    fn poll_preparation(
+        &mut self,
+        context: &egui::Context,
+    ) -> Result<BenchmarkWorkerPreparation, String> {
+        if self.preparation_done {
+            return Ok(BenchmarkWorkerPreparation::Ready);
+        }
+        let Some(task) = self.preparation.as_ref() else {
+            return Err("benchmark model preparation disappeared before measurement".to_owned());
+        };
+        let Some(result) = task.poll() else {
+            context.request_repaint_after(std::time::Duration::from_millis(100));
+            return Ok(BenchmarkWorkerPreparation::Pending);
+        };
+        self.preparation = None;
+        result.map_err(|error| error.to_string())?;
+        self.preparation_done = true;
+        Ok(BenchmarkWorkerPreparation::Ready)
+    }
+
+    fn start_measured(&mut self) -> Result<(), String> {
+        if self.measured_started {
+            return Ok(());
+        }
+        self.started_at = Some(std::time::Instant::now());
+        match self.request.harness {
+            CampaignTaskHarness::NativeReadQuestion => {
+                let session_id = self
+                    .ai_studio
+                    .host
+                    .create_session("ADR 0156 benchmark read question")
+                    .map_err(|error| error.to_string())?;
+                self.ai_studio.selected_session = session_id.clone();
+                self.ai_studio
+                    .host
+                    .append_message(
+                        &session_id,
+                        ConversationRole::User,
+                        self.request.candidate_contract.prompt.clone(),
+                    )
+                    .map_err(|error| error.to_string())?;
+                let config = NativeModelConfig::Local(LocalModelConfig {
+                    endpoint: self.ai_studio.local_model_endpoint.clone(),
+                    model: self.request.model.model_id.clone(),
+                });
+                self.ai_studio.start_native_question_authorized(
+                    config,
+                    vec![QuestionMessage {
+                        role: QuestionRole::User,
+                        text: self.request.candidate_contract.prompt.clone(),
+                    }],
+                    session_id.clone(),
+                );
+                self.read_session_id = Some(session_id);
+            }
+            CampaignTaskHarness::GovernedAgentHost
+            | CampaignTaskHarness::ProductionRuntimeDebug => {
+                self.run_id = Some(self.ai_studio.start_campaign_agent_run(&self.request)?);
+            }
+        }
+        self.measured_started = true;
+        Ok(())
+    }
+
+    fn handle_mcp_requests(&mut self) {
+        while let Ok(request) = self.mcp_requests.try_recv() {
+            let result = self
+                .app
+                .handle_mcp_tool_call(request.name(), request.arguments().clone());
+            request.respond(match result {
+                Ok(value) => EditorMcpHostResult::Success(value),
+                Err(error) => EditorMcpHostResult::ToolError {
+                    code: error.code().to_owned(),
+                    message: error.message().to_owned(),
+                },
+            });
+        }
+    }
+
+    fn tick(
+        &mut self,
+        context: &egui::Context,
+        frame: &mut eframe::Frame,
+    ) -> Result<BenchmarkWorkerOutcome, String> {
+        if !self.measured_started {
+            return Ok(BenchmarkWorkerOutcome::Pending);
+        }
+
+        self.handle_mcp_requests();
+        self.ai_studio.advance_host_owned_work(context);
+        self.ai_studio.resolve_campaign_pending_permission()?;
+
+        if self.app.take_ai_studio_restore_completed() {
+            self.ai_studio
+                .report_runtime_result(context, AiStudioRuntimeResult::EditorRestored);
+        }
+        if let Some(action) = self.ai_studio.take_runtime_action() {
+            let result = self
+                .app
+                .handle_ai_studio_runtime_action(action, frame.wgpu_render_state());
+            self.ai_studio.report_runtime_result(context, result);
+        }
+        eframe::App::logic(&mut self.app, context, frame);
+        if self.ai_studio.waiting_for_playtest_start() && self.app.ai_studio_playtest_running() {
+            self.ai_studio
+                .report_runtime_result(context, AiStudioRuntimeResult::PlayStarted);
+        }
+
+        self.ai_studio.resolve_campaign_pending_permission()?;
+        self.ai_studio
+            .maybe_apply_campaign_code_changes(&self.request)?;
+        self.finish_if_ready()
+    }
+
+    fn finish_if_ready(&mut self) -> Result<BenchmarkWorkerOutcome, String> {
+        if self
+            .started_at
+            .is_some_and(|started| started.elapsed() >= std::time::Duration::from_secs(300))
+        {
+            if let Some(run_id) = self.run_id.clone() {
+                let _ = self.ai_studio.stop_run_exact(&run_id);
+            }
+            return Ok(BenchmarkWorkerOutcome::Failed {
+                failure: CampaignFailureKind::TaskTimeout,
+                record: None,
+            });
+        }
+
+        match self.request.harness {
+            CampaignTaskHarness::NativeReadQuestion => self.finish_read_question(),
+            CampaignTaskHarness::GovernedAgentHost
+            | CampaignTaskHarness::ProductionRuntimeDebug => self.finish_agent_run(),
+        }
+    }
+
+    fn finish_read_question(&mut self) -> Result<BenchmarkWorkerOutcome, String> {
+        if self.ai_studio.native_question.is_some()
+            || self.ai_studio.pending_native_question_start.is_some()
+            || self.ai_studio.pending_runtime_action.is_some()
+        {
+            return Ok(BenchmarkWorkerOutcome::Pending);
+        }
+        let Some(snapshot) = self.ai_studio.last_native_question_benchmark.clone() else {
+            let message = self
+                .ai_studio
+                .status
+                .clone()
+                .unwrap_or_else(|| "native read-question benchmark ended without metrics".to_owned());
+            return Ok(BenchmarkWorkerOutcome::Failed {
+                failure: classify_campaign_failure(&message, CampaignFailureKind::Other),
+                record: None,
+            });
+        };
+        let session_id = self
+            .read_session_id
+            .as_deref()
+            .ok_or_else(|| "benchmark read session identity is unavailable".to_owned())?;
+        let answer = self
+            .ai_studio
+            .host
+            .session(session_id)
+            .map_err(|error| error.to_string())?
+            .messages
+            .iter()
+            .rev()
+            .find(|message| message.role == ConversationRole::Assistant)
+            .map(|message| message.text.clone())
+            .ok_or_else(|| "benchmark read question produced no assistant answer".to_owned())?;
+        let record = read_question_record(
+            &snapshot.policy.task_id,
+            &snapshot.metrics,
+            snapshot.policy.inventory.as_ref(),
+            snapshot.policy.quality,
+            snapshot.policy.workload,
+            &snapshot.policy.hardware,
+        )?;
+        match evaluate_read_question_answer(&answer, &snapshot.metrics) {
+            Ok(()) => Ok(BenchmarkWorkerOutcome::Succeeded(record)),
+            Err(failure) => Ok(BenchmarkWorkerOutcome::Failed {
+                failure,
+                record: Some(record),
+            }),
+        }
+    }
+
+    fn finish_agent_run(&mut self) -> Result<BenchmarkWorkerOutcome, String> {
+        let run_id = self

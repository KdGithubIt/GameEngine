+    #[tokio::test]
+    async fn mid_turn_compaction_preserves_tool_pairs_and_reduces_provider_context() {
+        let provider = MockProvider::new(Message::assistant().with_text("compact summary"), 100_000);
+        let conversation = conversation_with_tool_pairs(4);
+        let before = count_retained_context_tokens(&conversation)
+            .await
+            .expect("token counter should be available in the regression test");
+
+        let compaction = compact_messages(
+            &provider,
+            &provider.config,
+            "gameengine-mid-turn",
+            &conversation,
+            false,
+        )
+        .await
+        .expect("mid-turn compaction should succeed after completed tool results");
+
+        assert!(compaction.retained_context_tokens < before);
+        let agent_visible = compaction.conversation.agent_visible_messages();
+        Conversation::new(agent_visible.clone())
+            .expect("compaction must leave a provider-valid conversation");
+        assert!(agent_visible
+            .iter()
+            .any(|message| message.as_concat_text().contains("Continue calling tools")));
+
+        for i in 0..4 {
+            let id = format!("tool_{i}");
+            let matching = compaction
+                .conversation
+                .messages()
+                .iter()
+                .filter(|message| {
+                    message.content.iter().any(|content| match content {
+                        MessageContent::ToolRequest(request) => request.id == id,
+                        MessageContent::ToolResponse(response) => response.id == id,
+                        _ => false,
+                    })
+                })
+                .count();
+            assert_eq!(matching, 2, "tool request/result pair {id} must remain paired");
+        }
+    }

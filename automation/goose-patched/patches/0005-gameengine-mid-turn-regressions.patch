+            StatusCode::BAD_REQUEST,
+            Some(json!({
+                "error": {
+                    "message": "request too large",
+                    "code": "context_length_exceeded",
+                    "n_prompt_tokens": 32790,
+                    "n_ctx": 32768
+                }
+            })),
+            "http://localhost",
+        );
+        assert!(matches!(overflow, ProviderError::ContextLengthExceeded(_)));
+
+        let generic = map_http_error_to_provider_error(
+            StatusCode::BAD_REQUEST,
+            Some(json!({
+                "error": {
+                    "message": "max_tokens must be less than or equal to 4096",
+                    "code": "invalid_value"
+                }
+            })),
+            "http://localhost",
+        );
+        assert!(matches!(generic, ProviderError::RequestFailed(_)));
+    }
